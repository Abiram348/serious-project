// Prisma schema for SwarmDev
// 9 models, matching the previous Drizzle schema shape

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  plan      String   @default("FREE")
  credits   Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  projects      Project[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("PENDING")
  techStack   Json?
  sandboxId   String?
  previewUrl   String?
  previewStatus String? @default("STOPPED")
  githubRepo   String?
  deployUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRuns   AgentRun[]
  projectFiles ProjectFile[]
  chatMessages ChatMessage[]
  buildLogs   BuildLog[]
  usageLogs   UsageLog[]
  modelPreference ModelPreference?

  @@map("projects")
}

model AgentRun {
  id          String    @id @default(cuid())
  projectId   String
  agentType   String?
  status      String    @default("IDLE")
  input       Json?
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  errorMsg    String?
  tokenUsed   Int       @default(0)
  createdAt   DateTime  @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    AgentLog[]

  @@map("agent_runs")
}

model AgentLog {
  id         String   @id @default(cuid())
  agentRunId String
  level      String   @default("INFO")
  message    String?
  metadata   Json?
  timestamp  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@map("agent_logs")
}

model ProjectFile {
  id        String    @id @default(cuid())
  projectId String
  path      String
  content   String?
  language  String?
  createdBy String?
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ChatMessage {
  id          String   @id @default(cuid())
  projectId   String
  role        String?
  agentType   String?
  targetAgent String?  // Which agent this message was routed to (@frontend, etc.)
  model       String?  // Which LLM model generated this response
  content     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model BuildLog {
  id        String   @id @default(cuid())
  projectId String
  stream    String?
  exitCode  Int?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("build_logs")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  status           String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  agentType String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  cost      Int      @default(0)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("usage_logs")
}

model ModelPreference {
  id          String   @id @default(cuid())
  projectId   String   @unique
  preferences Json     // { "SUPERVISOR": "llama4", "FRONTEND": "kimi", ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("model_preferences")
}
