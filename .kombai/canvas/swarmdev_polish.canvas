      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --aurora-purple: #8B5CF6;\n    --aurora-indigo: #6366F1;\n    --aurora-pink: #EC4899;\n    --background: #05050A;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: var(--background);\n    color: #F8FAFC;\n    overflow-x: hidden;\n  }\n\n  .glass-aurora {\n    background: rgba(255, 255, 255, 0.02);\n    backdrop-filter: blur(40px);\n    -webkit-backdrop-filter: blur(40px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .text-gradient-aurora {\n    background: linear-gradient(135deg, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-size: 200% 200%;\n    animation: aurora-shift 8s ease infinite;\n  }\n\n  @keyframes aurora-shift {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  .mesh-blob {\n    position: absolute;\n    width: 800px;\n    height: 800px;\n    background: radial-gradient(circle at center, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    filter: blur(120px);\n    opacity: 0.4;\n    border-radius: 50%;\n    animation: rotate-blob 20s linear infinite;\n  }\n\n  @keyframes rotate-blob {\n    from { transform: rotate(0deg) scale(1); }\n    50% { transform: rotate(180deg) scale(1.1); }\n    to { transform: rotate(360deg) scale(1); }\n  }\n\n  .floating-bubble {\n    position: absolute;\n    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.1), transparent);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    border-radius: 50%;\n    backdrop-filter: blur(4px);\n    pointer-events: none;\n  }\n\n  .workflow-river {\n    stroke-dasharray: 10 10;\n    animation: flow 20s linear infinite;\n  }\n\n  @keyframes flow {\n    from { stroke-dashoffset: 200; }\n    to { stroke-dashoffset: 0; }\n  }\n\n  .pricing-pro-glow {\n    position: relative;\n  }\n  .pricing-pro-glow::before {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    background: linear-gradient(45deg, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    border-radius: 26px;\n    z-index: -1;\n    filter: blur(10px);\n    opacity: 0.5;\n    animation: pulse-glow 4s ease-in-out infinite;\n  }\n\n  @keyframes pulse-glow {\n    0%, 100% { opacity: 0.3; filter: blur(8px); }\n    50% { opacity: 0.7; filter: blur(15px); }\n  }\n</style>\n\n<div class=\"relative min-h-screen selection:bg-indigo-500/30\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full glass-aurora border-b border-white/5 h-20\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-8 h-full flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-4 cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl glass-aurora flex items-center justify-center border-white/10\" data-kid=\"5\">\n          <i class=\"ti ti-sparkles text-2xl text-gradient-aurora\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-2xl font-bold tracking-tight\" data-kid=\"7\">Swarm<span class=\"opacity-60\" data-kid=\"8\">Dev</span></span>\n      </div>\n      \n      <div class=\"hidden lg:flex items-center gap-12 text-sm font-medium text-slate-400\" data-kid=\"9\">\n        <a href=\"#features\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Features</a>\n        <a href=\"#workflow\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Workflow</a>\n        <a href=\"#pricing\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Pricing</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Documentation</a>\n      </div>\n\n      <div class=\"flex items-center gap-6\" data-kid=\"14\">\n        <button class=\"text-sm font-semibold text-slate-400 hover:text-white transition-colors\" data-kid=\"15\">Sign in</button>\n        <button class=\"px-8 py-3 rounded-full bg-white text-black text-sm font-bold hover:bg-slate-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.2)]\" data-kid=\"16\">\n          Get Started\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col items-center justify-center pt-20 overflow-hidden\" data-kid=\"17\">\n    \n    <div class=\"mesh-blob top-[-20%] left-[-10%]\" data-kid=\"18\"></div>\n    <div class=\"mesh-blob bottom-[-20%] right-[-10%]\" style=\"animation-delay: -10s; --aurora-purple: #EC4899; --aurora-pink: #8B5CF6;\" data-kid=\"19\"></div>\n    \n    <div class=\"relative z-10 max-w-5xl px-8 text-center\" id=\"hero-content\" data-kid=\"20\">\n      <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-aurora border-white/10 text-xs font-bold tracking-widest text-slate-300 mb-10\" data-kid=\"21\">\n        <span class=\"w-2 h-2 rounded-full bg-pink-500 animate-ping\" data-kid=\"22\"></span>\n        FLUID ORCHESTRATION ACTIVE\n      </div>\n      \n      <h1 class=\"text-7xl md:text-9xl font-bold tracking-tighter mb-10 leading-[0.95]\" data-kid=\"23\">\n        Fluid Full-Stack<br data-kid=\"24\">\n        <span class=\"text-gradient-aurora\" data-kid=\"25\">Orchestration</span>\n      </h1>\n      \n      <p class=\"text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-14 leading-relaxed font-medium\" data-kid=\"26\">\n        Harness a swarm of nine specialized AI agents. Parallel, liquid execution from prompt to production-ready deployment.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"27\">\n        <button class=\"px-10 py-5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold text-lg hover:scale-105 transition-transform shadow-xl shadow-purple-500/20\" data-kid=\"28\">\n          Build Your Swarm\n        </button>\n        <button class=\"px-10 py-5 rounded-2xl glass-aurora border-white/10 font-bold text-lg text-white hover:bg-white/5 transition-all\" data-kid=\"29\">\n          Watch Demo\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-40\" data-kid=\"30\">\n      <i class=\"ti ti-chevron-down text-3xl\" data-kid=\"31\"></i>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-32 relative px-8 overflow-hidden\" data-kid=\"32\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"33\">\n      <div class=\"text-center mb-24\" data-kid=\"34\">\n        <h2 class=\"text-5xl font-bold mb-6 tracking-tight\" data-kid=\"35\">Organic <span class=\"text-gradient-aurora\" data-kid=\"36\">Efficiency</span></h2>\n        <p class=\"text-slate-400 text-lg\" data-kid=\"37\">Parallel processing refined into a fluid developer experience.</p>\n      </div>\n\n      <div class=\"grid grid-cols-12 gap-8 relative\" id=\"features-grid\" data-kid=\"38\">\n        \n        <div class=\"col-span-12 md:col-span-7 h-[500px] glass-aurora rounded-[40px] p-12 relative overflow-hidden group\" data-kid=\"39\">\n          <div class=\"absolute inset-0 z-0 opacity-40 group-hover:opacity-60 transition-opacity\" data-kid=\"40\">\n            <video src=\"https://videos.pexels.com/video-files/6346580/6346580-hd_1920_1080_30fps.mp4\" autoplay muted loop playsinline class=\"w-full h-full object-cover\" data-kid=\"41\"></video>\n          </div>\n          <div class=\"relative z-10 h-full flex flex-col justify-end\" data-kid=\"42\">\n            <div class=\"w-16 h-16 rounded-2xl glass-aurora flex items-center justify-center mb-8 border-white/20\" data-kid=\"43\">\n              <i class=\"ti ti-layers-intersect text-3xl text-gradient-aurora\" data-kid=\"44\"></i>\n            </div>\n            <h3 class=\"text-4xl font-bold mb-6\" data-kid=\"45\">Multi-Agent Swarming</h3>\n            <p class=\"text-slate-300 text-lg leading-relaxed max-w-lg\" data-kid=\"46\">\n              Nine agents collaborate in a liquid mesh. While one models your database, another scaffolds the UI and a third hardening security.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-5 glass-aurora rounded-[40px] p-10 flex flex-col items-center text-center justify-center border-pink-500/10\" data-kid=\"47\">\n          <div class=\"w-20 h-20 rounded-full glass-aurora flex items-center justify-center mb-10 border-pink-500/30 shadow-[0_0_40px_rgba(236,72,153,0.2)]\" data-kid=\"48\">\n            <i class=\"ti ti-activity text-4xl text-pink-400\" data-kid=\"49\"></i>\n          </div>\n          <h3 class=\"text-3xl font-bold mb-6\" data-kid=\"50\">Real-Time Fluidity</h3>\n          <p class=\"text-slate-400 leading-relaxed\" data-kid=\"51\">\n            Watch code flow in real-time. Streaming logs and file updates delivered through a polished websocket architecture.\n          </p>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-4 glass-aurora rounded-[40px] p-10 group hover:border-white/20 transition-all\" data-kid=\"52\">\n          <i class=\"ti ti-sparkles text-3xl text-purple-400 mb-8 block\" data-kid=\"53\"></i>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"54\">AI Security Audit</h3>\n          <p class=\"text-slate-400 text-sm\" data-kid=\"55\">Hardened by default. Every line audited for vulnerabilities before it even reaches your sandbox.</p>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-8 glass-aurora rounded-[40px] p-10 flex items-center gap-12 overflow-hidden border-indigo-500/10\" data-kid=\"56\">\n          <div class=\"flex-1\" data-kid=\"57\">\n             <i class=\"ti ti-cube-spark text-3xl text-indigo-400 mb-8 block\" data-kid=\"58\"></i>\n             <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"59\">Isolated E2B Sandboxes</h3>\n             <p class=\"text-slate-400 text-sm\" data-kid=\"60\">Every swarm instance runs in a secure, ephemeral cloud container with full terminal access.</p>\n          </div>\n          <div class=\"w-1/2 aspect-video glass-aurora rounded-3xl border-white/5 p-6 font-mono text-[11px] text-indigo-300/60 shadow-2xl relative group-hover:scale-105 transition-transform\" data-kid=\"61\">\n             <div class=\"flex gap-1.5 mb-4\" data-kid=\"62\">\n               <div class=\"w-2 h-2 rounded-full bg-red-500/40\" data-kid=\"63\"></div>\n               <div class=\"w-2 h-2 rounded-full bg-yellow-500/40\" data-kid=\"64\"></div>\n               <div class=\"w-2 h-2 rounded-full bg-green-500/40\" data-kid=\"65\"></div>\n             </div>\n             > Initializing Swarm...<br data-kid=\"66\">\n             > Agent supervisor: planning nodes<br data-kid=\"67\">\n             > Agent frontend: scaffolding Next.js<br data-kid=\"68\">\n             > Agent security: hardening routes<br data-kid=\"69\">\n             <span class=\"animate-pulse\" data-kid=\"70\">_</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"workflow\" class=\"py-32 relative overflow-hidden bg-white/[0.01]\" data-kid=\"71\">\n    <div class=\"max-w-4xl mx-auto px-8\" data-kid=\"72\">\n      <div class=\"text-center mb-24\" data-kid=\"73\">\n        <h2 class=\"text-5xl font-bold tracking-tight mb-6\" data-kid=\"74\">The <span class=\"text-gradient-aurora\" data-kid=\"75\">Flow</span></h2>\n        <p class=\"text-slate-400\" data-kid=\"76\">A seamless journey from idea to deployment.</p>\n      </div>\n\n      <div class=\"relative py-20\" id=\"river-container\" data-kid=\"77\">\n        \n        <svg class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[2px] h-full\" viewBox=\"0 0 2 800\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"78\">\n          <path d=\"M1 0V800\" stroke=\"white\" stroke-opacity=\"0.05\" stroke-width=\"2\" class=\"workflow-river\" data-kid=\"79\"></path>\n        </svg>\n\n        \n        <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-6 h-6 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 blur-sm shadow-[0_0_30px_rgba(236,72,153,0.8)] z-20\" id=\"river-orb\" data-kid=\"80\"></div>\n\n        \n        <div class=\"space-y-40 relative z-10\" data-kid=\"81\">\n          <div class=\"flex items-center gap-12 flex-row-reverse text-right workflow-step\" data-kid=\"82\">\n            <div class=\"flex-1\" data-kid=\"83\">\n              <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"84\">01. Define</h4>\n              <p class=\"text-slate-400 leading-relaxed\" data-kid=\"85\">Type your project vision in plain English. Our Supervisor agent translates it into a multi-agent execution plan.</p>\n            </div>\n            <div class=\"w-20 h-20 rounded-full glass-aurora border-white/10 flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(255,255,255,0.05)]\" data-kid=\"86\">\n              <i class=\"ti ti-edit text-2xl text-purple-400\" data-kid=\"87\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"88\"></div>\n          </div>\n\n          <div class=\"flex items-center gap-12 workflow-step\" data-kid=\"89\">\n            <div class=\"flex-1\" data-kid=\"90\">\n              <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"91\">02. Parallelize</h4>\n              <p class=\"text-slate-400 leading-relaxed\" data-kid=\"92\">Nine specialized agents fan out simultaneously. Frontends, backends, and databases emerge in parallel streams.</p>\n            </div>\n            <div class=\"w-20 h-20 rounded-full glass-aurora border-white/10 flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(255,255,255,0.05)]\" data-kid=\"93\">\n              <i class=\"ti ti-binary text-2xl text-indigo-400\" data-kid=\"94\"></i>\n            </div>\n            <div class=\"flex-1 text-right\" data-kid=\"95\"></div>\n          </div>\n\n          <div class=\"flex items-center gap-12 flex-row-reverse text-right workflow-step\" data-kid=\"96\">\n            <div class=\"flex-1\" data-kid=\"97\">\n              <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"98\">03. Instantiate</h4>\n              <p class=\"text-slate-400 leading-relaxed\" data-kid=\"99\">One click to cloud. We handle the containers, the CI/CD, and the staging environments automatically.</p>\n            </div>\n            <div class=\"w-20 h-20 rounded-full glass-aurora border-white/10 flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(255,255,255,0.05)]\" data-kid=\"100\">\n              <i class=\"ti ti-rocket text-2xl text-pink-400\" data-kid=\"101\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"102\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"pricing\" class=\"py-32 px-8\" data-kid=\"103\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"104\">\n      <div class=\"text-center mb-20\" data-kid=\"105\">\n        <h2 class=\"text-5xl font-bold mb-6 tracking-tight\" data-kid=\"106\">Aurora <span class=\"text-gradient-aurora\" data-kid=\"107\">Pricing</span></h2>\n        <p class=\"text-slate-400\" data-kid=\"108\">Transparent tiers for every engineering scale.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"109\">\n        \n        <div class=\"glass-aurora rounded-[40px] p-12 flex flex-col\" data-kid=\"110\">\n          <div class=\"mb-10\" data-kid=\"111\">\n            <h4 class=\"text-lg font-bold text-slate-400 mb-4 tracking-widest uppercase\" data-kid=\"112\">STREAMS</h4>\n            <div class=\"text-6xl font-bold mb-2\" data-kid=\"113\">$0</div>\n            <p class=\"text-slate-500\" data-kid=\"114\">Try the fluid experience.</p>\n          </div>\n          <ul class=\"space-y-6 mb-12 flex-1\" data-kid=\"115\">\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"116\"><i class=\"ti ti-check text-purple-400\" data-kid=\"117\"></i> 3 Active Projects</li>\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"118\"><i class=\"ti ti-check text-purple-400\" data-kid=\"119\"></i> Supervisor + 2 Agents</li>\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"120\"><i class=\"ti ti-check text-purple-400\" data-kid=\"121\"></i> 100K Tokens / mo</li>\n          </ul>\n          <button class=\"w-full py-5 rounded-2xl glass-aurora border-white/10 font-bold hover:bg-white/5 transition-all\" data-kid=\"122\">Start Free</button>\n        </div>\n\n        \n        <div class=\"glass-aurora rounded-[40px] p-12 flex flex-col pricing-pro-glow border-white/20\" data-kid=\"123\">\n          <div class=\"mb-10\" data-kid=\"124\">\n            <div class=\"inline-block px-3 py-1 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 text-[10px] font-black tracking-widest text-white mb-6 uppercase\" data-kid=\"125\">MOST POPULAR</div>\n            <h4 class=\"text-lg font-bold text-white mb-4 tracking-widest uppercase\" data-kid=\"126\">PRO SWARM</h4>\n            <div class=\"text-6xl font-bold mb-2 text-gradient-aurora\" data-kid=\"127\">$29</div>\n            <p class=\"text-slate-400\" data-kid=\"128\">Full agency power.</p>\n          </div>\n          <ul class=\"space-y-6 mb-12 flex-1\" data-kid=\"129\">\n            <li class=\"flex items-center gap-4 text-slate-200\" data-kid=\"130\"><i class=\"ti ti-check text-pink-400\" data-kid=\"131\"></i> Unlimited Projects</li>\n            <li class=\"flex items-center gap-4 text-slate-200\" data-kid=\"132\"><i class=\"ti ti-check text-pink-400\" data-kid=\"133\"></i> All 9 Specialized Agents</li>\n            <li class=\"flex items-center gap-4 text-slate-200\" data-kid=\"134\"><i class=\"ti ti-check text-pink-400\" data-kid=\"135\"></i> 2M Tokens / month</li>\n            <li class=\"flex items-center gap-4 text-slate-200\" data-kid=\"136\"><i class=\"ti ti-check text-pink-400\" data-kid=\"137\"></i> GitHub Auto-Sync</li>\n          </ul>\n          <button class=\"w-full py-5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold shadow-lg shadow-purple-500/20 hover:scale-105 transition-transform\" data-kid=\"138\">Get Pro Swarm</button>\n        </div>\n\n        \n        <div class=\"glass-aurora rounded-[40px] p-12 flex flex-col\" data-kid=\"139\">\n          <div class=\"mb-10\" data-kid=\"140\">\n            <h4 class=\"text-lg font-bold text-slate-400 mb-4 tracking-widest uppercase\" data-kid=\"141\">GALAXY</h4>\n            <div class=\"text-6xl font-bold mb-2\" data-kid=\"142\">$99</div>\n            <p class=\"text-slate-500\" data-kid=\"143\">For high-velocity teams.</p>\n          </div>\n          <ul class=\"space-y-6 mb-12 flex-1\" data-kid=\"144\">\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"145\"><i class=\"ti ti-check text-indigo-400\" data-kid=\"146\"></i> Everything in Pro</li>\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"147\"><i class=\"ti ti-check text-indigo-400\" data-kid=\"148\"></i> 10M Tokens / month</li>\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"149\"><i class=\"ti ti-check text-indigo-400\" data-kid=\"150\"></i> Custom Agent Roles</li>\n            <li class=\"flex items-center gap-4 text-slate-300\" data-kid=\"151\"><i class=\"ti ti-check text-indigo-400\" data-kid=\"152\"></i> Priority GPU Queue</li>\n          </ul>\n          <button class=\"w-full py-5 rounded-2xl glass-aurora border-white/10 font-bold hover:bg-white/5 transition-all\" data-kid=\"153\">Contact Sales</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-24 border-t border-white/5 relative overflow-hidden\" data-kid=\"154\">\n    <div class=\"mesh-blob bottom-[-40%] left-1/2 -translate-x-1/2 opacity-10\" data-kid=\"155\"></div>\n    <div class=\"max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between gap-16 relative z-10\" data-kid=\"156\">\n      <div class=\"max-w-sm\" data-kid=\"157\">\n        <div class=\"flex items-center gap-4 mb-8\" data-kid=\"158\">\n          <div class=\"w-10 h-10 rounded-xl glass-aurora flex items-center justify-center border-white/10\" data-kid=\"159\">\n            <i class=\"ti ti-sparkles text-xl text-gradient-aurora\" data-kid=\"160\"></i>\n          </div>\n          <span class=\"text-2xl font-bold tracking-tight\" data-kid=\"161\">Swarm<span class=\"opacity-60\" data-kid=\"162\">Dev</span></span>\n        </div>\n        <p class=\"text-slate-500 leading-relaxed mb-8\" data-kid=\"163\">\n          A liquid AI software company in your browser. Reimagining full-stack velocity through multi-agent orchestration.\n        </p>\n        <div class=\"flex gap-6\" data-kid=\"164\">\n          <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"165\"><i class=\"ti ti-brand-github text-2xl\" data-kid=\"166\"></i></a>\n          <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"167\"><i class=\"ti ti-brand-x text-2xl\" data-kid=\"168\"></i></a>\n          <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"169\"><i class=\"ti ti-brand-linkedin text-2xl\" data-kid=\"170\"></i></a>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-16\" data-kid=\"171\">\n        <div data-kid=\"172\">\n          <h4 class=\"font-bold mb-8 text-white\" data-kid=\"173\">Product</h4>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"174\">\n            <li data-kid=\"175\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"176\">Features</a></li>\n            <li data-kid=\"177\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"178\">Pricing</a></li>\n            <li data-kid=\"179\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"180\">Showcase</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"181\">\n          <h4 class=\"font-bold mb-8 text-white\" data-kid=\"182\">Company</h4>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"183\">\n            <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors\" data-kid=\"185\">About</a></li>\n            <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors\" data-kid=\"187\">Blog</a></li>\n            <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors\" data-kid=\"189\">Careers</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"190\">\n          <h4 class=\"font-bold mb-8 text-white\" data-kid=\"191\">Legal</h4>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"192\">\n            <li data-kid=\"193\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"194\">Privacy</a></li>\n            <li data-kid=\"195\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"196\">Terms</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto px-8 mt-24 pt-12 border-t border-white/5 text-center text-xs text-slate-600 font-medium\" data-kid=\"197\">\n      &copy; 2026 SwarmDev. Built for high-velocity builders.\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"198\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"199\"></script>\n<script data-kid=\"200\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Parallax\n  gsap.to(\"#hero-content\", {\n    y: 100,\n    opacity: 0,\n    scrollTrigger: {\n      trigger: \"#hero-content\",\n      start: \"center center\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  // Feature Cards Entry\n  gsap.from(\"#features-grid > div\", {\n    scrollTrigger: {\n      trigger: \"#features-grid\",\n      start: \"top 80%\"\n    },\n    y: 80,\n    opacity: 0,\n    stagger: 0.15,\n    duration: 1.2,\n    ease: \"power4.out\"\n  });\n\n  // Workflow River Animation\n  const orb = document.getElementById('river-orb');\n  const riverContainer = document.getElementById('river-container');\n  \n  gsap.to(orb, {\n    scrollTrigger: {\n      trigger: riverContainer,\n      start: \"top 40%\",\n      end: \"bottom 60%\",\n      scrub: 1\n    },\n    top: \"100%\",\n    ease: \"none\"\n  });\n\n  // Step Reveals\n  document.querySelectorAll('.workflow-step').forEach(step => {\n    gsap.from(step, {\n      scrollTrigger: {\n        trigger: step,\n        start: \"top 80%\"\n      },\n      opacity: 0,\n      x: step.classList.contains('flex-row-reverse') ? 50 : -50,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Bubble Generator\n  function createBubbles() {\n    const container = document.querySelector('section');\n    for(let i = 0; i < 15; i++) {\n      const bubble = document.createElement('div');\n      bubble.className = 'floating-bubble';\n      const size = Math.random() * 100 + 50;\n      bubble.style.width = `${size}px`;\n      bubble.style.height = `${size}px`;\n      bubble.style.left = `${Math.random() * 100}%`;\n      bubble.style.top = `${Math.random() * 100}%`;\n      container.appendChild(bubble);\n      \n      gsap.to(bubble, {\n        y: -200 - Math.random() * 300,\n        x: (Math.random() - 0.5) * 200,\n        opacity: 0,\n        duration: 5 + Math.random() * 10,\n        repeat: -1,\n        ease: \"none\",\n        delay: Math.random() * -10\n      });\n    }\n  }\n  createBubbles();\n</script>",
