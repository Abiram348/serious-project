      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Geist+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: 190 100% 50%;\n    --secondary: 260 80% 60%;\n    --accent: 155 100% 45%;\n    --background: 240 10% 3.9%;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: #000;\n    color: #fff;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'Geist Mono', monospace; }\n\n  .bg-dots {\n    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);\n    background-size: 32px 32px;\n  }\n\n  .terminal-window {\n    background: rgba(10, 10, 12, 0.8);\n    backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    box-shadow: 0 0 0 1px hsla(260, 80%, 60%, 0.1), 0 20px 50px rgba(0, 0, 0, 0.5);\n  }\n\n  .neon-edge-cyan {\n    box-shadow: inset 0 0 20px -10px hsla(190, 100%, 50%, 0.3);\n    border-color: hsla(190, 100%, 50%, 0.2);\n  }\n\n  .neon-edge-purple {\n    box-shadow: inset 0 0 20px -10px hsla(260, 80%, 60%, 0.3);\n    border-color: hsla(260, 80%, 60%, 0.2);\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--secondary)));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.02);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .glass-card:hover {\n    background: rgba(255, 255, 255, 0.05);\n    border-color: hsla(190, 100%, 50%, 0.4);\n    transform: translateY(-4px) scale(1.02);\n  }\n\n  .status-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: hsl(var(--accent));\n    box-shadow: 0 0 10px hsl(var(--accent));\n  }\n\n  .iso-layer {\n    transition: transform 0.1s ease-out;\n  }\n\n  .cmd-k-footer {\n    background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);\n  }\n\n  .terminal-cursor::after {\n    content: '_';\n    animation: blink 1s step-end infinite;\n    color: hsl(var(--primary));\n  }\n\n  @keyframes blink {\n    from, to { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .scanline {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%;\n    background: linear-gradient(to bottom, transparent 50%, rgba(0, 242, 255, 0.02) 50%);\n    background-size: 100% 4px;\n    pointer-events: none;\n    z-index: 5;\n  }\n</style>\n\n<div class=\"relative min-h-screen bg-dots\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 w-full z-50 px-8 py-6 flex justify-between items-center\" data-kid=\"2\">\n    <div class=\"flex items-center gap-4\" data-kid=\"3\">\n      <div class=\"w-10 h-10 terminal-window rounded-lg flex items-center justify-center neon-edge-cyan\" data-kid=\"4\">\n        <i class=\"ti ti-sparkles text-xl text-gradient\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-mono text-xl font-bold tracking-tighter uppercase\" data-kid=\"6\">Swarm<span class=\"text-[hsl(var(--primary))]\" data-kid=\"7\">Dev</span></span>\n    </div>\n    <div class=\"flex items-center gap-8 font-mono text-xs text-zinc-500\" data-kid=\"8\">\n      <a href=\"#features\" class=\"hover:text-white transition-colors\" data-kid=\"9\">./capabilities</a>\n      <a href=\"#layers\" class=\"hover:text-white transition-colors\" data-kid=\"10\">./stack</a>\n      <div class=\"h-4 w-px bg-zinc-800\" data-kid=\"11\"></div>\n      <button class=\"px-6 py-2 rounded-lg terminal-window border-white/10 hover:border-white/30 text-white transition-all\" data-kid=\"12\">\n        EXEC_LOGIN\n      </button>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col items-center justify-center pt-32 px-8 overflow-hidden\" data-kid=\"13\">\n    <div class=\"absolute inset-0 z-0 opacity-20 pointer-events-none\" data-kid=\"14\">\n      <video src=\"https://videos.pexels.com/video-files/31699353/13506089_640_360_30fps.mp4\" autoplay muted loop playsinline class=\"w-full h-full object-cover\" data-kid=\"15\"></video>\n    </div>\n\n    <div class=\"relative z-10 w-full max-w-5xl\" data-kid=\"16\">\n      <div class=\"terminal-window rounded-2xl overflow-hidden neon-edge-purple flex flex-col shadow-2xl scale-0\" id=\"hero-terminal\" data-kid=\"17\">\n        <div class=\"bg-white/5 border-b border-white/10 px-4 py-3 flex items-center justify-between\" data-kid=\"18\">\n          <div class=\"flex gap-2\" data-kid=\"19\">\n            <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"20\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\" data-kid=\"21\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-green-500/50\" data-kid=\"22\"></div>\n          </div>\n          <div class=\"font-mono text-[10px] text-zinc-500 uppercase tracking-widest\" data-kid=\"23\">Main Orchestrator — active</div>\n        </div>\n        <div class=\"p-12 min-h-[400px]\" data-kid=\"24\">\n          <h1 class=\"font-mono text-5xl md:text-7xl font-bold mb-12 tracking-tight\" id=\"typing-heading\" data-kid=\"25\"></h1>\n          <div class=\"flex flex-col gap-6 opacity-0\" id=\"terminal-content\" data-kid=\"26\">\n            <p class=\"text-xl text-zinc-400 font-light max-w-2xl leading-relaxed\" data-kid=\"27\">\n              Describe your production environment. Our dev swarm parallelizes your vision across nine specialized agents. \n            </p>\n            <div class=\"flex items-center gap-6 mt-8\" data-kid=\"28\">\n              <button class=\"px-10 py-5 rounded-2xl bg-[hsl(var(--primary))] text-black font-bold text-lg hover:scale-105 transition-all shadow-[0_0_30px_hsla(190,100%,50%,0.3)]\" data-kid=\"29\">\n                DEPLOY_SWARM\n              </button>\n              <button class=\"px-10 py-5 rounded-2xl glass-card font-bold text-lg border-white/10 text-white hover:bg-white/5 transition-all\" data-kid=\"30\">\n                VIEW_BLUEPRINTS\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute -bottom-20 left-1/2 -translate-x-1/2 w-[120%] h-[120%] z-20 pointer-events-none\" id=\"mockup-container\" data-kid=\"31\">\n        <div class=\"absolute bottom-0 left-[10%] w-[45%] aspect-video terminal-window rounded-xl border-white/10 shadow-2xl translate-y-[200px]\" id=\"browser-mockup\" data-kid=\"32\">\n          <div class=\"bg-white/5 px-4 py-2 flex items-center gap-2 border-b border-white/10\" data-kid=\"33\">\n            <div class=\"w-2 h-2 rounded-full bg-zinc-600\" data-kid=\"34\"></div>\n            <div class=\"flex-1 h-3 rounded-full bg-zinc-800\" data-kid=\"35\"></div>\n          </div>\n          <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-50\" decoding=\"async\" loading=\"lazy\" data-kid=\"36\">\n        </div>\n        <div class=\"absolute bottom-[-10%] right-[10%] w-[35%] aspect-square terminal-window rounded-xl border-white/10 shadow-2xl translate-y-[200px]\" id=\"terminal-mockup\" data-kid=\"37\">\n          <div class=\"p-6 font-mono text-[10px] text-zinc-500 space-y-2\" data-kid=\"38\">\n            <div class=\"text-[hsl(var(--primary))]\" data-kid=\"39\">> INIT_PLAN_V2</div>\n            <div data-kid=\"40\">> AGENT_01: ONLINE</div>\n            <div data-kid=\"41\">> AGENT_02: ONLINE</div>\n            <div data-kid=\"42\">> AGENT_03: BUSY</div>\n            <div class=\"animate-pulse\" data-kid=\"43\">> _</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-32 px-8 max-w-7xl mx-auto\" data-kid=\"44\">\n    <div class=\"mb-24 flex flex-col md:flex-row md:items-end justify-between gap-12\" data-kid=\"45\">\n      <div class=\"max-w-2xl\" data-kid=\"46\">\n        <h2 class=\"font-mono text-4xl md:text-6xl font-bold uppercase mb-6\" data-kid=\"47\">./SWARM_NODE_MATRIX</h2>\n        <p class=\"text-zinc-400 text-lg font-light leading-relaxed\" data-kid=\"48\">\n          The SwarmDev engine decomposes your vision into independent executable task streams, synchronized in real-time.\n        </p>\n      </div>\n      <div class=\"flex gap-4 font-mono text-xs\" data-kid=\"49\">\n        <div class=\"px-4 py-2 terminal-window rounded border-white/10 flex items-center gap-2\" data-kid=\"50\">\n          <div class=\"status-dot\" data-kid=\"51\"></div> ACTIVE_NODES: 09\n        </div>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\" id=\"bento-grid\" data-kid=\"52\">\n      \n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group overflow-hidden relative\" data-kid=\"53\">\n        <div class=\"absolute inset-0 bg-[hsl(var(--secondary))]/5 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"54\"></div>\n        <div class=\"relative z-10\" data-kid=\"55\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-purple\" data-kid=\"56\">\n            <i class=\"ti ti-cpu text-2xl text-[hsl(var(--secondary))]\" data-kid=\"57\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"58\">SUPERVISOR_CORE</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"59\">High-frequency orchestration engine that dispatches work across the swarm.</p>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] uppercase tracking-widest text-zinc-600\" data-kid=\"60\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-emerald-500 shadow-emerald-500/50\" data-kid=\"61\"></span> LATENCY: 0.12ms\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group\" data-kid=\"62\">\n        <div class=\"relative z-10\" data-kid=\"63\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-cyan\" data-kid=\"64\">\n            <i class=\"ti ti-layout-2 text-2xl text-[hsl(var(--primary))]\" data-kid=\"65\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"66\">UI_SYNTHESIS</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"67\">Automated Next.js generation with production-ready design tokens.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"68\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-sky-500\" data-kid=\"69\"></span> READY_TO_DEPLOY\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group\" data-kid=\"70\">\n        <div class=\"relative z-10\" data-kid=\"71\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-purple\" data-kid=\"72\">\n            <i class=\"ti ti-shield-lock text-2xl text-[hsl(var(--secondary))]\" data-kid=\"73\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"74\">SEC_PROTOCOL</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"75\">Continuous audit of every code block for SQLi, XSS, and credential leaks.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"76\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-purple-500\" data-kid=\"77\"></span> AUDIT_STRICT\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group overflow-hidden\" data-kid=\"78\">\n        <div class=\"absolute right-[-20%] bottom-[-20%] opacity-20 group-hover:scale-110 transition-transform\" data-kid=\"79\">\n          <i class=\"ti ti-database text-[120px] text-zinc-500\" data-kid=\"80\"></i>\n        </div>\n        <div class=\"relative z-10\" data-kid=\"81\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-cyan\" data-kid=\"82\">\n            <i class=\"ti ti-database text-2xl text-[hsl(var(--primary))]\" data-kid=\"83\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"84\">DB_ARCHITECT</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"85\">Automatic Prisma modeling and migrations for complex relations.</p>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"86\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-emerald-500\" data-kid=\"87\"></span> SYNC_ACTIVE\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group\" data-kid=\"88\">\n        <div class=\"relative z-10\" data-kid=\"89\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 border-white/10\" data-kid=\"90\">\n            <i class=\"ti ti-terminal text-2xl text-zinc-400\" data-kid=\"91\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"92\">API_ORCH</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"93\">Express.js backend synthesis with robust typing and validation.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"94\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-zinc-600\" data-kid=\"95\"></span> IDLE\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group\" data-kid=\"96\">\n        <div class=\"relative z-10\" data-kid=\"97\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-purple\" data-kid=\"98\">\n            <i class=\"ti ti-test-pipe text-2xl text-[hsl(var(--secondary))]\" data-kid=\"99\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"100\">QA_AUTO_AUDIT</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"101\">Automated test generation and execution for every API endpoint.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"102\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-emerald-500\" data-kid=\"103\"></span> 100%_PASS\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group\" data-kid=\"104\">\n        <div class=\"relative z-10\" data-kid=\"105\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 neon-edge-cyan\" data-kid=\"106\">\n            <i class=\"ti ti-box text-2xl text-[hsl(var(--primary))]\" data-kid=\"107\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"108\">DEVOPS_SYNC</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"109\">Dockerization and Kubernetes manifests generated on-the-fly.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"110\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-sky-500\" data-kid=\"111\"></span> REPS: 03\n        </div>\n      </div>\n\n      <div class=\"glass-card rounded-[24px] p-8 min-h-[280px] flex flex-col justify-between group bg-zinc-900/50\" data-kid=\"112\">\n        <div class=\"relative z-10\" data-kid=\"113\">\n          <div class=\"w-12 h-12 terminal-window rounded-xl flex items-center justify-center mb-8 border-white/10\" data-kid=\"114\">\n            <i class=\"ti ti-book text-2xl text-zinc-500\" data-kid=\"115\"></i>\n          </div>\n          <h3 class=\"font-mono font-bold text-xl uppercase mb-3\" data-kid=\"116\">DOC_AGENT</h3>\n          <p class=\"text-xs text-zinc-500 leading-relaxed\" data-kid=\"117\">Comprehensive API documentation and README synthesis.</p>\n        </div>\n        <div class=\"flex items-center gap-2 pt-6 border-t border-white/5 font-mono text-[9px] text-zinc-600 uppercase\" data-kid=\"118\">\n           <span class=\"status-dot w-1.5 h-1.5 bg-zinc-700\" data-kid=\"119\"></span> QUEUED\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"layers\" class=\"py-48 px-8 flex flex-col items-center\" data-kid=\"120\">\n    <div class=\"max-w-4xl text-center mb-32\" data-kid=\"121\">\n      <h2 class=\"font-mono text-5xl md:text-7xl font-bold uppercase mb-12 tracking-tighter\" data-kid=\"122\">PLATFORM_LAYERS</h2>\n      <p class=\"text-xl text-zinc-500 font-light leading-relaxed max-w-2xl mx-auto\" data-kid=\"123\">\n        A vertical 3D integration of the most powerful modern technologies, coordinated by Swarm AI.\n      </p>\n    </div>\n\n    <div class=\"relative w-full max-w-4xl h-[800px] flex items-center justify-center\" id=\"isometric-stack\" data-kid=\"124\">\n      \n      <div class=\"absolute iso-layer z-30 w-full max-w-2xl aspect-[2/1] terminal-window rounded-3xl p-12 border-cyan-500/30 flex flex-col justify-between\" id=\"layer-ui\" data-kid=\"125\">\n        <div class=\"flex justify-between items-start\" data-kid=\"126\">\n          <h4 class=\"font-mono text-4xl font-bold text-white uppercase\" data-kid=\"127\">NEXT.JS_LAYER</h4>\n          <i class=\"ti ti-brand-nextjs text-5xl text-white/20\" data-kid=\"128\"></i>\n        </div>\n        <p class=\"text-zinc-400 max-w-md\" data-kid=\"129\">The presentation layer. High-fidelity React synthesis with App Router support and Tailwind CSS.</p>\n      </div>\n\n      <div class=\"absolute iso-layer z-20 w-full max-w-2xl aspect-[2/1] terminal-window rounded-3xl p-12 border-purple-500/30 flex flex-col justify-between translate-y-[80px]\" id=\"layer-api\" data-kid=\"130\">\n        <div class=\"flex justify-between items-start\" data-kid=\"131\">\n          <h4 class=\"font-mono text-4xl font-bold text-white uppercase\" data-kid=\"132\">EXPRESS_API</h4>\n          <i class=\"ti ti-api text-5xl text-white/20\" data-kid=\"133\"></i>\n        </div>\n        <p class=\"text-zinc-400 max-w-md\" data-kid=\"134\">The logic layer. Typed API routes, service architectures, and middleware orchestration.</p>\n      </div>\n\n      <div class=\"absolute iso-layer z-10 w-full max-w-2xl aspect-[2/1] terminal-window rounded-3xl p-12 border-emerald-500/30 flex flex-col justify-between translate-y-[160px]\" id=\"layer-db\" data-kid=\"135\">\n        <div class=\"flex justify-between items-start\" data-kid=\"136\">\n          <h4 class=\"font-mono text-4xl font-bold text-white uppercase\" data-kid=\"137\">PRISMA_DATABASE</h4>\n          <i class=\"ti ti-database text-5xl text-white/20\" data-kid=\"138\"></i>\n        </div>\n        <p class=\"text-zinc-400 max-w-md\" data-kid=\"139\">The persistence layer. Relational mapping, migration management, and vector data indexing.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-48 px-8 flex flex-col items-center text-center\" data-kid=\"140\">\n    <div class=\"absolute w-[600px] h-[300px] bg-[hsl(var(--primary))]/10 rounded-full blur-[150px] opacity-30\" data-kid=\"141\"></div>\n    <h2 class=\"font-mono text-6xl md:text-8xl font-bold uppercase mb-16 tracking-tighter\" id=\"cta-heading\" data-kid=\"142\">READY_TO_<span class=\"text-gradient\" data-kid=\"143\">BUILD?</span></h2>\n    <button class=\"px-16 py-6 rounded-2xl bg-white text-black font-bold text-2xl hover:bg-[hsl(var(--primary))] transition-all shadow-[0_0_50px_rgba(255,255,255,0.2)]\" data-kid=\"144\">\n      START_SWARM_FREE\n    </button>\n  </section>\n\n  \n  <footer class=\"relative px-8 pt-32 pb-12 cmd-k-footer border-t border-white/5\" data-kid=\"145\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12 mb-20\" data-kid=\"146\">\n      <div class=\"flex items-center gap-4\" data-kid=\"147\">\n        <div class=\"w-8 h-8 terminal-window rounded-lg flex items-center justify-center\" data-kid=\"148\">\n          <i class=\"ti ti-sparkles text-sm text-gradient\" data-kid=\"149\"></i>\n        </div>\n        <span class=\"font-mono text-lg font-bold tracking-tighter uppercase text-zinc-400\" data-kid=\"150\">SwarmDev</span>\n      </div>\n      <div class=\"w-full max-w-md terminal-window rounded-xl px-6 py-3 border-white/10 flex items-center gap-4 group hover:border-white/30 transition-all cursor-text\" data-kid=\"151\">\n        <i class=\"ti ti-search text-zinc-500 group-hover:text-white transition-colors\" data-kid=\"152\"></i>\n        <span class=\"text-zinc-600 font-mono text-xs flex-1\" data-kid=\"153\">Search or press <span class=\"px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-400\" data-kid=\"154\">cmd+k</span></span>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto flex flex-wrap justify-between gap-8 text-[10px] font-mono text-zinc-700 uppercase tracking-widest pt-12 border-t border-white/5\" data-kid=\"155\">\n      <div class=\"flex gap-12\" data-kid=\"156\">\n        <span data-kid=\"157\">&copy; 2026 SWARMDEV_SYS</span>\n        <a href=\"#\" class=\"hover:text-zinc-400\" data-kid=\"158\">MANIFESTO</a>\n        <a href=\"#\" class=\"hover:text-zinc-400\" data-kid=\"159\">ARCHITECTURE</a>\n      </div>\n      <div class=\"flex gap-12\" data-kid=\"160\">\n        <a href=\"#\" class=\"hover:text-zinc-400\" data-kid=\"161\">GITHUB</a>\n        <a href=\"#\" class=\"hover:text-zinc-400\" data-kid=\"162\">DISCORD</a>\n        <a href=\"#\" class=\"hover:text-zinc-400\" data-kid=\"163\">STATUS: STABLE</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"164\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"165\"></script>\n<script data-kid=\"166\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Sequence\n  const introTl = gsap.timeline();\n  introTl.to(\"#hero-terminal\", { scale: 1, duration: 1.2, ease: \"expo.out\" });\n  \n  // Typing Effect\n  const heading = \"What will you build?\";\n  const headingEl = document.getElementById('typing-heading');\n  let i = 0;\n  function typeHeading() {\n    if (i < heading.length) {\n      headingEl.innerHTML += heading.charAt(i);\n      i++;\n      setTimeout(typeHeading, 50);\n    } else {\n      headingEl.classList.add('terminal-cursor');\n      gsap.to(\"#terminal-content\", { opacity: 1, y: -20, duration: 1, ease: \"power3.out\" });\n      \n      // Slide up mockups\n      gsap.to(\"#browser-mockup\", { y: -100, rotate: -5, duration: 1.5, ease: \"power4.out\", delay: 0.2 });\n      gsap.to(\"#terminal-mockup\", { y: -50, rotate: 3, duration: 1.5, ease: \"power4.out\", delay: 0.4 });\n    }\n  }\n  setTimeout(typeHeading, 1500);\n\n  // Bento Grid Entry\n  gsap.from(\"#bento-grid > div\", {\n    scrollTrigger: {\n      trigger: \"#bento-grid\",\n      start: \"top 80%\"\n    },\n    y: 50,\n    opacity: 0,\n    stagger: 0.1,\n    duration: 0.8,\n    ease: \"power2.out\"\n  });\n\n  // Isometric Stack Separation\n  gsap.set(\"#layer-ui\", { rotateX: 45, rotateZ: -45, x: 0, y: 0 });\n  gsap.set(\"#layer-api\", { rotateX: 45, rotateZ: -45, x: 0, y: 80 });\n  gsap.set(\"#layer-db\", { rotateX: 45, rotateZ: -45, x: 0, y: 160 });\n\n  gsap.to(\"#layer-ui\", {\n    scrollTrigger: {\n      trigger: \"#isometric-stack\",\n      start: \"top center\",\n      end: \"bottom center\",\n      scrub: 1\n    },\n    y: -200,\n    opacity: 1\n  });\n\n  gsap.to(\"#layer-api\", {\n    scrollTrigger: {\n      trigger: \"#isometric-stack\",\n      start: \"top center\",\n      end: \"bottom center\",\n      scrub: 1\n    },\n    y: 0,\n    opacity: 1\n  });\n\n  gsap.to(\"#layer-db\", {\n    scrollTrigger: {\n      trigger: \"#isometric-stack\",\n      start: \"top center\",\n      end: \"bottom center\",\n      scrub: 1\n    },\n    y: 200,\n    opacity: 1\n  });\n\n  // CTA Heading Reveal\n  gsap.from(\"#cta-heading\", {\n    scrollTrigger: {\n      trigger: \"#cta-heading\",\n      start: \"top 90%\"\n    },\n    y: 50,\n    opacity: 0,\n    duration: 1,\n    ease: \"power4.out\"\n  });\n</script>",
