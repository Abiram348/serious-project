      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --aurora-purple: #8B5CF6;\n    --aurora-indigo: #6366F1;\n    --aurora-pink: #EC4899;\n    --background: #030308;\n    --glass-fill: rgba(255, 255, 255, 0.015);\n    --glass-border: rgba(255, 255, 255, 0.06);\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: var(--background);\n    color: #F8FAFC;\n    overflow-x: hidden;\n  }\n\n  .glass-aurora {\n    background: var(--glass-fill);\n    backdrop-filter: blur(40px);\n    -webkit-backdrop-filter: blur(40px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .text-gradient-aurora {\n    background: linear-gradient(135deg, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-size: 200% 200%;\n    animation: aurora-shift 12s ease infinite;\n  }\n\n  @keyframes aurora-shift {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  .mesh-blob {\n    position: absolute;\n    width: 1000px;\n    height: 1000px;\n    background: radial-gradient(circle at center, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    filter: blur(150px);\n    opacity: 0.35;\n    border-radius: 50%;\n    animation: rotate-blob 25s linear infinite;\n    pointer-events: none;\n  }\n\n  @keyframes rotate-blob {\n    from { transform: rotate(0deg) scale(1) translate(0, 0); }\n    50% { transform: rotate(180deg) scale(1.2) translate(50px, 50px); }\n    to { transform: rotate(360deg) scale(1) translate(0, 0); }\n  }\n\n  .floating-bubble {\n    position: absolute;\n    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.15), transparent);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 50%;\n    backdrop-filter: blur(8px);\n    pointer-events: none;\n    z-index: 5;\n  }\n\n  .engine-node {\n    position: relative;\n    z-index: 10;\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .engine-node:hover {\n    transform: scale(1.05);\n    border-color: rgba(255, 255, 255, 0.2);\n    box-shadow: 0 0 50px rgba(99, 102, 241, 0.2);\n  }\n\n  .neural-path {\n    filter: drop-shadow(0 0 8px var(--aurora-indigo));\n    stroke-dasharray: 10 10;\n    animation: dash-flow 20s linear infinite;\n  }\n\n  @keyframes dash-flow {\n    from { stroke-dashoffset: 200; }\n    to { stroke-dashoffset: 0; }\n  }\n\n  .terminal-snippet {\n    font-family: 'JetBrains Mono', monospace;\n    background: rgba(0, 0, 0, 0.3);\n    border-left: 2px solid var(--aurora-pink);\n  }\n\n  .glow-pulse {\n    animation: pulse 4s ease-in-out infinite;\n  }\n\n  @keyframes pulse {\n    0%, 100% { opacity: 0.4; filter: blur(120px); }\n    50% { opacity: 0.6; filter: blur(140px); }\n  }\n\n  .pricing-ultimate-glow {\n    position: relative;\n  }\n  .pricing-ultimate-glow::before {\n    content: '';\n    position: absolute;\n    inset: -1px;\n    background: linear-gradient(45deg, var(--aurora-purple), var(--aurora-indigo), var(--aurora-pink));\n    border-radius: 32px;\n    z-index: -1;\n    filter: blur(20px);\n    opacity: 0.4;\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n\n<div class=\"relative min-h-screen selection:bg-pink-500/30 overflow-x-hidden\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full glass-aurora border-b border-white/5 h-20\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-10 h-full flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-4 cursor-pointer group\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl glass-aurora flex items-center justify-center border-white/10 group-hover:border-white/30 transition-all duration-500\" data-kid=\"5\">\n          <i class=\"ti ti-sparkles text-2xl text-gradient-aurora\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-2xl font-bold tracking-tighter\" data-kid=\"7\">Swarm<span class=\"text-gradient-aurora\" data-kid=\"8\">Dev</span></span>\n      </div>\n      \n      <div class=\"hidden lg:flex items-center gap-14 text-sm font-semibold text-slate-400 uppercase tracking-widest\" data-kid=\"9\">\n        <a href=\"#engine\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Architecture</a>\n        <a href=\"#features\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Efficiency</a>\n        <a href=\"#workflow\" class=\"hover:text-white transition-colors\" data-kid=\"12\">The Flow</a>\n        <a href=\"#pricing\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Provision</a>\n      </div>\n\n      <div class=\"flex items-center gap-6\" data-kid=\"14\">\n        <button class=\"text-xs font-black tracking-widest text-slate-400 hover:text-white transition-colors uppercase\" data-kid=\"15\">LOG_IN</button>\n        <button class=\"px-8 py-3 rounded-full bg-white text-black text-xs font-black tracking-widest hover:bg-slate-200 transition-all shadow-[0_0_40px_rgba(255,255,255,0.1)] uppercase\" data-kid=\"16\">\n          Instantiate\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col items-center justify-center pt-20\" data-kid=\"17\">\n    <div class=\"mesh-blob top-[-30%] left-[-15%] glow-pulse\" data-kid=\"18\"></div>\n    <div class=\"mesh-blob bottom-[-30%] right-[-15%]\" style=\"animation-delay: -12s; --aurora-purple: #EC4899; --aurora-pink: #6366F1;\" data-kid=\"19\"></div>\n    \n    <div class=\"relative z-10 max-w-6xl px-10 text-center\" id=\"hero-main\" data-kid=\"20\">\n      <div class=\"inline-flex items-center gap-3 px-5 py-2 rounded-full glass-aurora border-white/10 text-[10px] font-black tracking-[0.3em] text-slate-200 mb-12 uppercase animate-pulse\" data-kid=\"21\">\n        <span class=\"w-2 h-2 rounded-full bg-indigo-500\" data-kid=\"22\"></span>\n        Neural Orchestration Engine Active\n      </div>\n      \n      <h1 class=\"text-8xl md:text-[10rem] font-bold tracking-tighter mb-12 leading-[0.85] text-white\" data-kid=\"23\">\n        Crystallizing<br data-kid=\"24\">\n        <span class=\"text-gradient-aurora\" data-kid=\"25\">Vision</span>\n      </h1>\n      \n      <p class=\"text-2xl md:text-3xl text-slate-400 max-w-4xl mx-auto mb-16 leading-relaxed font-light\" data-kid=\"26\">\n        A multi-agent swarm designed for <span class=\"text-white font-medium\" data-kid=\"27\">Organic Efficiency</span>. \n        Fluid task decomposition that mirrors the architecture of your thought.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-8\" data-kid=\"28\">\n        <button class=\"px-12 py-6 rounded-3xl bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-600 text-white font-black tracking-widest text-sm uppercase hover:scale-105 transition-transform shadow-2xl shadow-indigo-500/30\" data-kid=\"29\">\n          Deploy Your Swarm\n        </button>\n        <button class=\"px-12 py-6 rounded-3xl glass-aurora border-white/10 font-black tracking-widest text-sm uppercase text-white hover:bg-white/5 transition-all flex items-center gap-3\" data-kid=\"30\">\n          <i class=\"ti ti-player-play-filled\" data-kid=\"31\"></i> View Process\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"engine\" class=\"py-40 relative px-10 overflow-hidden\" data-kid=\"32\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"33\">\n      <div class=\"flex flex-col md:flex-row items-end justify-between mb-32 gap-12\" data-kid=\"34\">\n        <div class=\"max-w-2xl\" data-kid=\"35\">\n          <div class=\"font-mono text-indigo-400 text-xs tracking-[0.4em] mb-6 uppercase\" data-kid=\"36\">[[ ARCHITECTURE_SPEC_V2 ]]</div>\n          <h2 class=\"text-6xl font-bold tracking-tighter text-white\" data-kid=\"37\">THE LIQUID ENGINE</h2>\n          <p class=\"mt-8 text-slate-400 text-xl font-light leading-relaxed\" data-kid=\"38\">\n            Beyond rigid pipelines. Our agents exist in a fluid mesh, communicating through high-frequency neural pathways to ensure zero-bottleneck synthesis.\n          </p>\n        </div>\n        <div class=\"flex gap-6 font-mono text-[10px] tracking-widest uppercase\" data-kid=\"39\">\n          <div class=\"px-6 py-3 glass-aurora rounded-xl border-purple-500/20 text-purple-400\" data-kid=\"40\">Mesh_Active</div>\n          <div class=\"px-6 py-3 glass-aurora rounded-xl border-indigo-500/20 text-indigo-400\" data-kid=\"41\">Orch_Synced</div>\n        </div>\n      </div>\n\n      <div class=\"relative glass-aurora rounded-[60px] p-24 border-white/5 min-h-[600px] flex items-center justify-center overflow-hidden\" id=\"engine-visualizer\" data-kid=\"42\">\n        <div class=\"absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:40px_40px]\" data-kid=\"43\"></div>\n        \n        <svg class=\"absolute inset-0 w-full h-full pointer-events-none opacity-40\" id=\"neural-svg\" data-kid=\"44\">\n          <defs data-kid=\"45\">\n            <linearGradient id=\"path-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"46\">\n              <stop offset=\"0%\" stop-color=\"var(--aurora-purple)\" data-kid=\"47\"></stop>\n              <stop offset=\"50%\" stop-color=\"var(--aurora-indigo)\" data-kid=\"48\"></stop>\n              <stop offset=\"100%\" stop-color=\"var(--aurora-pink)\" data-kid=\"49\"></stop>\n            </linearGradient>\n          </defs>\n        </svg>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-32 relative z-10 w-full\" data-kid=\"50\">\n          \n          <div class=\"flex flex-col items-center gap-8 engine-node\" id=\"node-orchestrator\" data-kid=\"51\">\n            <div class=\"w-56 h-56 rounded-full glass-aurora border-purple-500/30 flex items-center justify-center shadow-[0_0_60px_rgba(139,92,246,0.15)] relative\" data-kid=\"52\">\n               <div class=\"absolute inset-4 rounded-full border border-dashed border-purple-500/20 animate-[spin_30s_linear_infinite]\" data-kid=\"53\"></div>\n               <i class=\"ti ti-cpu text-6xl text-purple-400\" data-kid=\"54\"></i>\n            </div>\n            <div class=\"text-center\" data-kid=\"55\">\n              <h4 class=\"font-bold text-2xl mb-2\" data-kid=\"56\">Orchestrator</h4>\n              <p class=\"font-mono text-[10px] tracking-[0.3em] text-slate-500 uppercase\" data-kid=\"57\">Core Synthesis</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex flex-col items-center gap-8 engine-node\" id=\"node-bus\" data-kid=\"58\">\n            <div class=\"w-56 h-56 rounded-full glass-aurora border-indigo-500/30 flex items-center justify-center shadow-[0_0_60px_rgba(99,102,241,0.15)] relative\" data-kid=\"59\">\n               <div class=\"absolute inset-0 rounded-full bg-indigo-500/5 animate-pulse\" data-kid=\"60\"></div>\n               <i class=\"ti ti-activity-heartbeat text-6xl text-indigo-400\" data-kid=\"61\"></i>\n            </div>\n            <div class=\"text-center\" data-kid=\"62\">\n              <h4 class=\"font-bold text-2xl mb-2\" data-kid=\"63\">Neural Bus</h4>\n              <p class=\"font-mono text-[10px] tracking-[0.3em] text-slate-500 uppercase\" data-kid=\"64\">Real-time Pulse</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex flex-col items-center gap-8 engine-node\" id=\"node-knowledge\" data-kid=\"65\">\n            <div class=\"w-56 h-56 rounded-full glass-aurora border-pink-500/30 flex items-center justify-center shadow-[0_0_60px_rgba(236,72,153,0.15)] relative\" data-kid=\"66\">\n               <div class=\"absolute inset-6 grid grid-cols-2 gap-3 opacity-40\" data-kid=\"67\">\n                  <div class=\"border border-white/20 rounded-lg\" data-kid=\"68\"></div>\n                  <div class=\"border border-white/20 rounded-lg\" data-kid=\"69\"></div>\n                  <div class=\"border border-white/20 rounded-lg\" data-kid=\"70\"></div>\n                  <div class=\"border border-white/20 rounded-lg\" data-kid=\"71\"></div>\n               </div>\n               <i class=\"ti ti-database text-5xl text-pink-400 relative z-10\" data-kid=\"72\"></i>\n            </div>\n            <div class=\"text-center\" data-kid=\"73\">\n              <h4 class=\"font-bold text-2xl mb-2\" data-kid=\"74\">Knowledge Layer</h4>\n              <p class=\"font-mono text-[10px] tracking-[0.3em] text-slate-500 uppercase\" data-kid=\"75\">Crystalline Data</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-40 relative px-10\" data-kid=\"76\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"77\">\n      <div class=\"text-center mb-32\" data-kid=\"78\">\n        <h2 class=\"text-7xl font-bold tracking-tighter mb-8 text-white\" data-kid=\"79\">ORGANIC EFFICIENCY</h2>\n        <p class=\"text-slate-400 text-2xl font-light max-w-3xl mx-auto leading-relaxed\" data-kid=\"80\">\n          Parallelization refined into a fluid developer experience. Nine agents. One goal. Infinite velocity.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-12 gap-10\" data-kid=\"81\">\n        \n        <div class=\"col-span-12 md:col-span-8 h-[600px] glass-aurora rounded-[50px] p-16 relative overflow-hidden group\" data-kid=\"82\">\n          <div class=\"absolute inset-0 z-0 opacity-30 group-hover:opacity-50 transition-opacity duration-1000\" data-kid=\"83\">\n            <video src=\"https://videos.pexels.com/video-files/6346580/6346580-hd_1920_1080_30fps.mp4\" autoplay muted loop playsinline class=\"w-full h-full object-cover\" data-kid=\"84\"></video>\n          </div>\n          <div class=\"relative z-10 h-full flex flex-col justify-between\" data-kid=\"85\">\n            <div data-kid=\"86\">\n              <div class=\"w-20 h-20 rounded-3xl glass-aurora flex items-center justify-center mb-10 border-white/10 group-hover:border-purple-500/40 transition-colors\" data-kid=\"87\">\n                <i class=\"ti ti-layers-linked text-4xl text-gradient-aurora\" data-kid=\"88\"></i>\n              </div>\n              <h3 class=\"text-5xl font-bold mb-8 text-white\" data-kid=\"89\">Fluid Task Decomposition</h3>\n              <p class=\"text-slate-300 text-xl leading-relaxed max-w-xl font-light\" data-kid=\"90\">\n                Our Supervisor agent instantly shatters your prompt into high-fidelity sub-tasks, dispatching them to specialized workers in a single neural breath.\n              </p>\n            </div>\n            <div class=\"flex gap-4 font-mono text-[10px] tracking-widest text-purple-400/60 uppercase\" data-kid=\"91\">\n              <span data-kid=\"92\">Parallel_Nodes: 09</span>\n              <span class=\"text-white/20\" data-kid=\"93\">|</span>\n              <span data-kid=\"94\">Sync_State: Optimal</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-4 glass-aurora rounded-[50px] p-12 flex flex-col justify-center border-indigo-500/10 hover:border-indigo-500/30 transition-all\" data-kid=\"95\">\n          <i class=\"ti ti-activity-heartbeat text-5xl text-indigo-400 mb-10 block\" data-kid=\"96\"></i>\n          <h3 class=\"text-3xl font-bold mb-6 text-white tracking-tight\" data-kid=\"97\">Real-Time Fluidity</h3>\n          <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"98\">\n            Streaming logs delivered with zero-latency websockets. Experience the heartbeat of your application as it's born.\n          </p>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-5 glass-aurora rounded-[50px] p-12 flex flex-col justify-center border-pink-500/10 hover:border-pink-500/30 transition-all\" data-kid=\"99\">\n          <i class=\"ti ti-shield-search text-5xl text-pink-400 mb-10 block\" data-kid=\"100\"></i>\n          <h3 class=\"text-3xl font-bold mb-6 text-white tracking-tight\" data-kid=\"101\">Hardened by Design</h3>\n          <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"102\">\n            Not just code—secure code. Every output is audited for OWASP Top 10 vulnerabilities before it ever touches your cloud.\n          </p>\n        </div>\n\n        \n        <div class=\"col-span-12 md:col-span-7 glass-aurora rounded-[50px] p-12 flex items-center gap-14 overflow-hidden border-white/5 group\" data-kid=\"103\">\n          <div class=\"flex-1\" data-kid=\"104\">\n             <i class=\"ti ti-cube-unfolded text-5xl text-slate-200 mb-10 block\" data-kid=\"105\"></i>\n             <h3 class=\"text-3xl font-bold mb-6 text-white tracking-tight\" data-kid=\"106\">Cloud Realization</h3>\n             <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"107\">\n               Secure E2B sandboxes provide the soil for your application to grow. Zero local setup. Infinite scalability.\n             </p>\n          </div>\n          <div class=\"w-1/2 aspect-video glass-aurora rounded-3xl border-white/5 p-8 terminal-snippet shadow-2xl transform group-hover:scale-105 transition-transform duration-700\" data-kid=\"108\">\n             <div class=\"flex gap-2 mb-6\" data-kid=\"109\">\n               <div class=\"w-3 h-3 rounded-full bg-red-500/40\" data-kid=\"110\"></div>\n               <div class=\"w-3 h-3 rounded-full bg-yellow-500/40\" data-kid=\"111\"></div>\n               <div class=\"w-3 h-3 rounded-full bg-green-500/40\" data-kid=\"112\"></div>\n             </div>\n             <div class=\"space-y-3 font-mono text-xs\" data-kid=\"113\">\n               <div class=\"text-indigo-400\" data-kid=\"114\">$ swarm provision --region=void-1</div>\n               <div class=\"text-slate-500\" data-kid=\"115\">> Instantiating cloud sandbox...</div>\n               <div class=\"text-slate-500\" data-kid=\"116\">> Container initialized: 250ms</div>\n               <div class=\"text-pink-400\" data-kid=\"117\">> Port 3000 listening...</div>\n               <div class=\"text-white animate-pulse\" data-kid=\"118\">_</div>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"workflow\" class=\"py-40 relative px-10 bg-white/[0.01]\" data-kid=\"119\">\n    <div class=\"max-w-5xl mx-auto\" data-kid=\"120\">\n      <div class=\"text-center mb-32\" data-kid=\"121\">\n        <h2 class=\"text-6xl font-bold tracking-tighter mb-8 text-white uppercase\" data-kid=\"122\">The Flow</h2>\n        <p class=\"text-slate-400 text-xl font-light\" data-kid=\"123\">Five steps from raw thought to resilient cloud reality.</p>\n      </div>\n\n      <div class=\"relative py-24\" id=\"workflow-container\" data-kid=\"124\">\n        \n        <div class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[1px] bg-gradient-to-b from-purple-500 via-indigo-500 to-pink-500 opacity-20\" data-kid=\"125\"></div>\n        \n        <div class=\"absolute left-1/2 -translate-x-1/2 top-0 w-8 h-8 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 blur-sm shadow-[0_0_40px_rgba(236,72,153,1)] z-30\" id=\"flow-orb\" data-kid=\"126\"></div>\n\n        <div class=\"space-y-64 relative z-20\" data-kid=\"127\">\n          \n          <div class=\"flex items-center gap-20 flex-row-reverse text-right flow-item\" data-kid=\"128\">\n            <div class=\"flex-1\" data-kid=\"129\">\n              <span class=\"font-mono text-xs tracking-[0.4em] text-purple-400 mb-6 block uppercase\" data-kid=\"130\">Stage_01</span>\n              <h4 class=\"text-4xl font-bold mb-6 text-white uppercase\" data-kid=\"131\">Ingestion</h4>\n              <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"132\">Crystallizing your requirements through advanced natural language synthesis via Ollama Cloud.</p>\n            </div>\n            <div class=\"w-24 h-24 rounded-full glass-aurora border-purple-500/20 flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(139,92,246,0.1)]\" data-kid=\"133\">\n              <i class=\"ti ti-writing-sign text-3xl text-purple-400\" data-kid=\"134\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"135\"></div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-20 flow-item\" data-kid=\"136\">\n            <div class=\"flex-1\" data-kid=\"137\">\n              <span class=\"font-mono text-xs tracking-[0.4em] text-indigo-400 mb-6 block uppercase\" data-kid=\"138\">Stage_02</span>\n              <h4 class=\"text-4xl font-bold mb-6 text-white uppercase\" data-kid=\"139\">Orchestration</h4>\n              <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"140\">Supervisor decomposes the vision into a parallel execution graph, identifying every relational dependency.</p>\n            </div>\n            <div class=\"w-24 h-24 rounded-full glass-aurora border-indigo-500/20 flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(99,102,241,0.1)]\" data-kid=\"141\">\n              <i class=\"ti ti-git-branch text-3xl text-indigo-400\" data-kid=\"142\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"143\"></div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-20 flex-row-reverse text-right flow-item\" data-kid=\"144\">\n            <div class=\"flex-1\" data-kid=\"145\">\n              <span class=\"font-mono text-xs tracking-[0.4em] text-pink-400 mb-6 block uppercase\" data-kid=\"146\">Stage_03</span>\n              <h4 class=\"text-4xl font-bold mb-6 text-white uppercase\" data-kid=\"147\">Synthesis</h4>\n              <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"148\">The parallel swarm emerges. Nine agents fanning out to generate frontend, backend, and relational schemas simultaneously.</p>\n            </div>\n            <div class=\"w-24 h-24 rounded-full glass-aurora border-pink-500/20 flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(236,72,153,0.1)]\" data-kid=\"149\">\n              <i class=\"ti ti-binary text-3xl text-pink-400\" data-kid=\"150\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"151\"></div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-20 flow-item\" data-kid=\"152\">\n            <div class=\"flex-1\" data-kid=\"153\">\n              <span class=\"font-mono text-xs tracking-[0.4em] text-purple-400 mb-6 block uppercase\" data-kid=\"154\">Stage_04</span>\n              <h4 class=\"text-4xl font-bold mb-6 text-white uppercase\" data-kid=\"155\">Hardening</h4>\n              <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"156\">Continuous audit protocol triggers. Validating every endpoint and schema against security best practices.</p>\n            </div>\n            <div class=\"w-24 h-24 rounded-full glass-aurora border-purple-500/20 flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(139,92,246,0.1)]\" data-kid=\"157\">\n              <i class=\"ti ti-shield-check text-3xl text-purple-400\" data-kid=\"158\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"159\"></div>\n          </div>\n\n          \n          <div class=\"flex items-center gap-20 flex-row-reverse text-right flow-item\" data-kid=\"160\">\n            <div class=\"flex-1\" data-kid=\"161\">\n              <span class=\"font-mono text-xs tracking-[0.4em] text-pink-400 mb-6 block uppercase\" data-kid=\"162\">Stage_05</span>\n              <h4 class=\"text-4xl font-bold mb-6 text-white uppercase\" data-kid=\"163\">Realization</h4>\n              <p class=\"text-slate-400 text-lg leading-relaxed font-light\" data-kid=\"164\">Instantiating your production swarm in the cloud. Zero local environment. One click to reality.</p>\n            </div>\n            <div class=\"w-24 h-24 rounded-full glass-aurora border-pink-500/20 flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(236,72,153,0.1)]\" data-kid=\"165\">\n              <i class=\"ti ti-rocket text-3xl text-pink-400\" data-kid=\"166\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"167\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"pricing\" class=\"py-40 px-10 relative\" data-kid=\"168\">\n    <div class=\"absolute inset-0 bg-indigo-500/5 blur-[150px] rounded-full scale-50 opacity-30\" data-kid=\"169\"></div>\n    <div class=\"max-w-7xl mx-auto relative z-10\" data-kid=\"170\">\n      <div class=\"text-center mb-32\" data-kid=\"171\">\n        <h2 class=\"text-7xl font-bold tracking-tighter mb-8 text-white uppercase\" data-kid=\"172\">Provisioning</h2>\n        <p class=\"text-slate-400 text-xl font-light\" data-kid=\"173\">Select your compute allocation tier.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\" data-kid=\"174\">\n        \n        <div class=\"glass-aurora rounded-[60px] p-14 flex flex-col border-white/5 hover:border-white/10 transition-colors\" data-kid=\"175\">\n          <div class=\"mb-14\" data-kid=\"176\">\n            <h4 class=\"text-sm font-black tracking-[0.4em] text-slate-500 mb-6 uppercase\" data-kid=\"177\">Node_Starter</h4>\n            <div class=\"text-7xl font-bold mb-4 text-white\" data-kid=\"178\">$0</div>\n            <p class=\"text-slate-500 font-medium\" data-kid=\"179\">Try the swarm experience.</p>\n          </div>\n          <ul class=\"space-y-8 mb-16 flex-1 text-slate-300 font-light\" data-kid=\"180\">\n            <li class=\"flex items-center gap-5\" data-kid=\"181\"><i class=\"ti ti-circle-check text-purple-400 text-xl\" data-kid=\"182\"></i> 3 Swarm Instances</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"183\"><i class=\"ti ti-circle-check text-purple-400 text-xl\" data-kid=\"184\"></i> Supervisor + 2 Agents</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"185\"><i class=\"ti ti-circle-check text-purple-400 text-xl\" data-kid=\"186\"></i> 100K Tokens / mo</li>\n          </ul>\n          <button class=\"w-full py-6 rounded-[30px] glass-aurora border-white/10 font-black tracking-widest text-xs uppercase hover:bg-white/5 transition-all text-white\" data-kid=\"187\">Select_Node</button>\n        </div>\n\n        \n        <div class=\"glass-aurora rounded-[60px] p-14 flex flex-col pricing-ultimate-glow border-white/20 scale-105 shadow-2xl\" data-kid=\"188\">\n          <div class=\"mb-14\" data-kid=\"189\">\n            <div class=\"inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 text-[10px] font-black tracking-[0.3em] text-white mb-8 uppercase\" data-kid=\"190\">Neural_Preferred</div>\n            <h4 class=\"text-sm font-black tracking-[0.4em] text-white mb-6 uppercase\" data-kid=\"191\">Pro_Swarm</h4>\n            <div class=\"text-7xl font-bold mb-4 text-gradient-aurora\" data-kid=\"192\">$29</div>\n            <p class=\"text-slate-400 font-medium\" data-kid=\"193\">Full specialized power.</p>\n          </div>\n          <ul class=\"space-y-8 mb-16 flex-1 text-slate-200 font-light\" data-kid=\"194\">\n            <li class=\"flex items-center gap-5\" data-kid=\"195\"><i class=\"ti ti-circle-check text-pink-400 text-xl\" data-kid=\"196\"></i> Unlimited Swarms</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"197\"><i class=\"ti ti-circle-check text-pink-400 text-xl\" data-kid=\"198\"></i> All 9 Specialized Agents</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"199\"><i class=\"ti ti-circle-check text-pink-400 text-xl\" data-kid=\"200\"></i> 2M Tokens / month</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"201\"><i class=\"ti ti-circle-check text-pink-400 text-xl\" data-kid=\"202\"></i> GitHub Live Sync</li>\n          </ul>\n          <button class=\"w-full py-6 rounded-[30px] bg-white text-black font-black tracking-widest text-xs uppercase hover:bg-slate-200 transition-all shadow-xl\" data-kid=\"203\">Allocate_Power</button>\n        </div>\n\n        \n        <div class=\"glass-aurora rounded-[60px] p-14 flex flex-col border-white/5 hover:border-white/10 transition-colors\" data-kid=\"204\">\n          <div class=\"mb-14\" data-kid=\"205\">\n            <h4 class=\"text-sm font-black tracking-[0.4em] text-slate-500 mb-6 uppercase\" data-kid=\"206\">Fleet_Enterprise</h4>\n            <div class=\"text-7xl font-bold mb-4 text-white\" data-kid=\"207\">$99</div>\n            <p class=\"text-slate-500 font-medium\" data-kid=\"208\">High-velocity team grid.</p>\n          </div>\n          <ul class=\"space-y-8 mb-16 flex-1 text-slate-300 font-light\" data-kid=\"209\">\n            <li class=\"flex items-center gap-5\" data-kid=\"210\"><i class=\"ti ti-circle-check text-indigo-400 text-xl\" data-kid=\"211\"></i> Everything in Pro</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"212\"><i class=\"ti ti-circle-check text-indigo-400 text-xl\" data-kid=\"213\"></i> 10M Tokens / month</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"214\"><i class=\"ti ti-circle-check text-indigo-400 text-xl\" data-kid=\"215\"></i> Custom Agent Roles</li>\n            <li class=\"flex items-center gap-5\" data-kid=\"216\"><i class=\"ti ti-circle-check text-indigo-400 text-xl\" data-kid=\"217\"></i> Priority GPU Queue</li>\n          </ul>\n          <button class=\"w-full py-6 rounded-[30px] glass-aurora border-white/10 font-black tracking-widest text-xs uppercase hover:bg-white/5 transition-all text-white\" data-kid=\"218\">Contact_Sales</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-32 border-t border-white/5 relative overflow-hidden bg-black\" data-kid=\"219\">\n    <div class=\"mesh-blob bottom-[-50%] left-1/2 -translate-x-1/2 opacity-10 scale-150\" data-kid=\"220\"></div>\n    <div class=\"max-w-7xl mx-auto px-10 flex flex-col md:flex-row justify-between gap-24 relative z-10\" data-kid=\"221\">\n      <div class=\"max-w-md\" data-kid=\"222\">\n        <div class=\"flex items-center gap-4 mb-10\" data-kid=\"223\">\n          <div class=\"w-12 h-12 rounded-2xl glass-aurora flex items-center justify-center border-white/10\" data-kid=\"224\">\n            <i class=\"ti ti-sparkles text-2xl text-gradient-aurora\" data-kid=\"225\"></i>\n          </div>\n          <span class=\"text-3xl font-bold tracking-tighter uppercase text-white\" data-kid=\"226\">SwarmDev</span>\n        </div>\n        <p class=\"text-slate-500 text-lg leading-relaxed mb-12 font-light\" data-kid=\"227\">\n          A liquid AI software company. Reimagining full-stack velocity through neural orchestration.\n        </p>\n        <div class=\"flex gap-8\" data-kid=\"228\">\n          <a href=\"#\" class=\"text-slate-500 hover:text-white transition-colors\" data-kid=\"229\"><i class=\"ti ti-brand-github text-3xl\" data-kid=\"230\"></i></a>\n          <a href=\"#\" class=\"text-slate-500 hover:text-white transition-colors\" data-kid=\"231\"><i class=\"ti ti-brand-x text-3xl\" data-kid=\"232\"></i></a>\n          <a href=\"#\" class=\"text-slate-500 hover:text-white transition-colors\" data-kid=\"233\"><i class=\"ti ti-brand-linkedin text-3xl\" data-kid=\"234\"></i></a>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-24\" data-kid=\"235\">\n        <div class=\"space-y-8\" data-kid=\"236\">\n          <h4 class=\"font-black tracking-widest text-xs text-white uppercase\" data-kid=\"237\">System</h4>\n          <ul class=\"space-y-6 text-sm text-slate-500 font-medium\" data-kid=\"238\">\n            <li data-kid=\"239\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors uppercase\" data-kid=\"240\">Features</a></li>\n            <li data-kid=\"241\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors uppercase\" data-kid=\"242\">Architecture</a></li>\n            <li data-kid=\"243\"><a href=\"#\" class=\"hover:text-pink-400 transition-colors uppercase\" data-kid=\"244\">Enterprise</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-8\" data-kid=\"245\">\n          <h4 class=\"font-black tracking-widest text-xs text-white uppercase\" data-kid=\"246\">Knowledge</h4>\n          <ul class=\"space-y-6 text-sm text-slate-500 font-medium\" data-kid=\"247\">\n            <li data-kid=\"248\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors uppercase\" data-kid=\"249\">Docs</a></li>\n            <li data-kid=\"250\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors uppercase\" data-kid=\"251\">Status</a></li>\n            <li data-kid=\"252\"><a href=\"#\" class=\"hover:text-indigo-400 transition-colors uppercase\" data-kid=\"253\">Prompts</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-8\" data-kid=\"254\">\n          <h4 class=\"font-black tracking-widest text-xs text-white uppercase\" data-kid=\"255\">Legal</h4>\n          <ul class=\"space-y-6 text-sm text-slate-500 font-medium\" data-kid=\"256\">\n            <li data-kid=\"257\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors uppercase\" data-kid=\"258\">Privacy</a></li>\n            <li data-kid=\"259\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors uppercase\" data-kid=\"260\">Terms</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto px-10 mt-32 pt-12 border-t border-white/5 text-center text-[10px] font-black tracking-[0.5em] text-slate-700 uppercase\" data-kid=\"261\">\n      &copy; 2026 SWARMDEV_INC // ALL_NODES_OPERATIONAL\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"262\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"263\"></script>\n<script data-kid=\"264\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Sequence\n  const introTl = gsap.timeline();\n  introTl.from(\"nav\", { y: -100, opacity: 0, duration: 1.2, ease: \"power4.out\" })\n         .from(\"#hero-main h1\", { scale: 0.9, opacity: 0, y: 100, duration: 1.5, ease: \"power4.out\" }, \"-=0.8\")\n         .from(\"#hero-main p\", { opacity: 0, y: 50, duration: 1.2, ease: \"power4.out\" }, \"-=1\")\n         .from(\"#hero-main .flex\", { opacity: 0, scale: 0.9, duration: 1, ease: \"back.out(1.7)\" }, \"-=0.8\");\n\n  // Engine Connection Lines\n  function drawNeuralPaths() {\n    const svg = document.getElementById('neural-svg');\n    const nodes = [\n      document.getElementById('node-orchestrator'),\n      document.getElementById('node-bus'),\n      document.getElementById('node-knowledge')\n    ];\n    \n    if (!svg || !nodes[0]) return;\n    const svgRect = svg.getBoundingClientRect();\n    \n    svg.innerHTML = `\n      <defs>\n        <linearGradient id=\"neural-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"var(--aurora-purple)\" stop-opacity=\"0\" />\n          <stop offset=\"50%\" stop-color=\"var(--aurora-indigo)\" stop-opacity=\"0.4\" />\n          <stop offset=\"100%\" stop-color=\"var(--aurora-pink)\" stop-opacity=\"0\" />\n        </linearGradient>\n      </defs>\n    `;\n\n    for (let i = 0; i < nodes.length - 1; i++) {\n      const n1 = nodes[i].getBoundingClientRect();\n      const n2 = nodes[i+1].getBoundingClientRect();\n      \n      const x1 = n1.left + n1.width / 2 - svgRect.left;\n      const y1 = n1.top + n1.height / 2 - svgRect.top;\n      const x2 = n2.left + n2.width / 2 - svgRect.left;\n      const y2 = n2.top + n2.height / 2 - svgRect.top;\n\n      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n      const cp1x = x1 + (x2 - x1) / 2;\n      const cp1y = y1 - 100;\n      const cp2x = x1 + (x2 - x1) / 2;\n      const cp2y = y2 + 100;\n      \n      path.setAttribute('d', `M ${x1} ${y1} C ${cp1x} ${cp1y} ${cp2x} ${cp2y} ${x2} ${y2}`);\n      path.setAttribute('stroke', 'url(#neural-gradient)');\n      path.setAttribute('stroke-width', '3');\n      path.setAttribute('fill', 'none');\n      path.setAttribute('class', 'neural-path');\n      svg.appendChild(path);\n    }\n  }\n\n  window.addEventListener('load', drawNeuralPaths);\n  window.addEventListener('resize', drawNeuralPaths);\n\n  // Workflow Orb Scroll\n  gsap.to(\"#flow-orb\", {\n    scrollTrigger: {\n      trigger: \"#workflow-container\",\n      start: \"top 40%\",\n      end: \"bottom 60%\",\n      scrub: 1.5\n    },\n    top: \"100%\",\n    ease: \"none\"\n  });\n\n  // Fade in flow items\n  document.querySelectorAll('.flow-item').forEach(item => {\n    gsap.from(item, {\n      scrollTrigger: {\n        trigger: item,\n        start: \"top 80%\"\n      },\n      opacity: 0,\n      y: 50,\n      duration: 1.2,\n      ease: \"power4.out\"\n    });\n  });\n\n  // Feature Reveal\n  gsap.from(\"#features .col-span-12\", {\n    scrollTrigger: {\n      trigger: \"#features\",\n      start: \"top 70%\"\n    },\n    y: 100,\n    opacity: 0,\n    stagger: 0.15,\n    duration: 1.5,\n    ease: \"power4.out\"\n  });\n\n  // Bubble Generator\n  function createBubbles() {\n    const container = document.body;\n    for(let i = 0; i < 20; i++) {\n      const bubble = document.createElement('div');\n      bubble.className = 'floating-bubble';\n      const size = Math.random() * 150 + 50;\n      bubble.style.width = `${size}px`;\n      bubble.style.height = `${size}px`;\n      bubble.style.left = `${Math.random() * 100}%`;\n      bubble.style.top = `${Math.random() * 500}%`;\n      container.appendChild(bubble);\n      \n      gsap.to(bubble, {\n        y: -1000 - Math.random() * 2000,\n        x: (Math.random() - 0.5) * 400,\n        opacity: 0,\n        duration: 10 + Math.random() * 20,\n        repeat: -1,\n        ease: \"none\",\n        delay: Math.random() * -20\n      });\n    }\n  }\n  createBubbles();\n</script>",
