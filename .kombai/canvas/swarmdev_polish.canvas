      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100;400;700&family=Geist+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --void-bg: #0a0a0c;\n    --primary: #00f2ff;\n    --secondary: #9d4eff;\n    --accent: #00ff9d;\n    --text-muted: rgba(255, 255, 255, 0.5);\n    --glass: rgba(255, 255, 255, 0.03);\n    --glass-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    background-color: var(--void-bg);\n    color: white;\n    font-family: 'Geist', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'Geist Mono', monospace; }\n\n  .text-gradient {\n    background: linear-gradient(135deg, var(--primary), var(--secondary));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .glow-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: 0;\n    pointer-events: none;\n    opacity: 0.4;\n  }\n\n  .bg-dots {\n    background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px);\n    background-size: 24px 24px;\n  }\n\n  .skew-mockup {\n    transform: perspective(1000px) rotateY(-15deg) rotateX(5deg) scale(1.1);\n    box-shadow: -20px 20px 50px rgba(0,0,0,0.5);\n  }\n\n  /* Custom Scrollbar for Carousel */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Scanline effect */\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 10;\n    background: linear-gradient(0deg, rgba(0,242,255,0) 0%, rgba(0,242,255,0.05) 50%, rgba(0,242,255,0) 100%);\n    opacity: 0.1;\n    position: absolute;\n    pointer-events: none;\n    animation: scan 8s linear infinite;\n  }\n\n  @keyframes scan {\n    from { transform: translateY(-100%); }\n    to { transform: translateY(100vh); }\n  }\n\n  .terminal-cursor::after {\n    content: '_';\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    from, to { opacity: 1; }\n    50% { opacity: 0; }\n  }\n</style>\n\n<div class=\"relative min-h-screen bg-dots overflow-hidden\" data-kid=\"1\">\n  <div class=\"scanline\" data-kid=\"2\"></div>\n  \n  \n  <div class=\"glow-orb w-[600px] h-[600px] bg-primary top-[-300px] left-[-100px]\" data-kid=\"3\"></div>\n  <div class=\"glow-orb w-[500px] h-[500px] bg-secondary bottom-[-200px] right-[-100px]\" data-kid=\"4\"></div>\n\n  \n  <video class=\"fixed inset-0 w-full h-full object-cover opacity-30 mix-blend-screen pointer-events-none\" src=\"https://videos.pexels.com/video-files/30922259/13222700_640_360_50fps.mp4\" poster=\"https://images.pexels.com/videos/30922259/pexels-photo-30922259.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" data-kid=\"5\">\n  </video>\n\n  \n  <nav class=\"fixed top-0 w-full z-50 px-12 py-8 flex justify-between items-center\" data-kid=\"6\">\n    <div class=\"flex items-center gap-3\" data-kid=\"7\">\n      <div class=\"w-10 h-10 glass rounded-xl flex items-center justify-center border-primary/20\" data-kid=\"8\">\n        <i class=\"ti ti-sparkles text-primary text-xl\" data-kid=\"9\"></i>\n      </div>\n      <span class=\"text-xl font-bold tracking-tighter uppercase\" data-kid=\"10\">Swarm<span class=\"text-primary\" data-kid=\"11\">Dev</span></span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-12 text-sm font-medium text-text-muted\" data-kid=\"12\">\n      <a href=\"#\" class=\"hover:text-primary transition-colors\" data-kid=\"13\">Manifesto</a>\n      <a href=\"#\" class=\"hover:text-primary transition-colors\" data-kid=\"14\">Architecture</a>\n      <a href=\"#\" class=\"hover:text-primary transition-colors\" data-kid=\"15\">Enterprise</a>\n      <a href=\"#\" class=\"text-white glass px-6 py-2.5 rounded-full border-white/10 hover:bg-white/5 transition-all\" data-kid=\"16\">Sign In</a>\n    </div>\n  </nav>\n\n  \n  <section id=\"hero\" class=\"relative pt-48 pb-32 px-12 lg:px-24 flex flex-col lg:flex-row items-center justify-between\" data-kid=\"17\">\n    <div class=\"max-w-3xl z-10\" data-kid=\"18\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1 glass rounded-full text-[10px] font-mono tracking-widest uppercase text-primary border-primary/20 mb-8\" data-kid=\"19\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse\" data-kid=\"20\"></span>\n        Deep Void Engine v4.0 Active\n      </div>\n      <h1 class=\"text-7xl lg:text-9xl font-bold tracking-tight leading-[0.9] mb-12\" data-kid=\"21\">\n        A VOID FOR <br data-kid=\"22\">\n        <span class=\"text-gradient\" data-kid=\"23\">CREATION.</span>\n      </h1>\n      <p class=\"text-xl text-text-muted max-w-xl mb-12 font-light leading-relaxed\" data-kid=\"24\">\n        Nine autonomous agents swarming in parallel within an isolated cloud sandbox. Describe your vision, watch the void crystallize into production code.\n      </p>\n      \n      \n      <div class=\"w-full max-w-2xl glass rounded-2xl p-6 border-white/5 relative group overflow-hidden\" data-kid=\"25\">\n        <div class=\"absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"26\"></div>\n        <div class=\"flex items-center gap-4 text-sm font-mono mb-4 text-text-muted\" data-kid=\"27\">\n          <span class=\"flex gap-1.5\" data-kid=\"28\">\n            <span class=\"w-2.5 h-2.5 rounded-full bg-red-500/50\" data-kid=\"29\"></span>\n            <span class=\"w-2.5 h-2.5 rounded-full bg-yellow-500/50\" data-kid=\"30\"></span>\n            <span class=\"w-2.5 h-2.5 rounded-full bg-green-500/50\" data-kid=\"31\"></span>\n          </span>\n          <span data-kid=\"32\">root@swarmdev:~</span>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"33\">\n          <span class=\"text-primary\" data-kid=\"34\">$</span>\n          <input type=\"text\" placeholder=\"I want to build a real-time trading dashboard...\" class=\"bg-transparent border-none outline-none w-full text-white placeholder:text-white/20 font-mono text-lg\" data-kid=\"35\">\n          <button class=\"w-10 h-10 rounded-lg bg-primary text-black flex items-center justify-center hover:scale-105 active:scale-95 transition-all\" data-kid=\"36\">\n            <i class=\"ti ti-arrow-right\" data-kid=\"37\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative mt-24 lg:mt-0 flex justify-center items-center\" data-kid=\"38\">\n      <div class=\"absolute w-[500px] h-[500px] bg-primary/10 rounded-full blur-[100px]\" data-kid=\"39\"></div>\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lord-berandas/holosphere.svg\" style=\"color: var(--primary); width: 600px; height: 600px;\" class=\"animate-pulse opacity-40 mix-blend-screen\" data-kid=\"40\">\n      <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"41\">\n        <div class=\"w-[300px] h-[300px] border border-white/5 rounded-full animate-[spin_20s_linear_infinite]\" data-kid=\"42\"></div>\n        <div class=\"absolute w-[400px] h-[400px] border border-primary/10 rounded-full animate-[spin_30s_linear_infinite_reverse]\" data-kid=\"43\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-32 px-12 lg:px-24 overflow-hidden\" data-kid=\"44\">\n    <div class=\"flex flex-col lg:flex-row items-center gap-24\" data-kid=\"45\">\n      <div class=\"lg:w-1/2 relative\" data-kid=\"46\">\n        <div class=\"absolute -inset-10 bg-primary/10 blur-[120px] rounded-full\" data-kid=\"47\"></div>\n        <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=1200&q=80&fit=crop\" alt=\"SwarmDev Dashboard\" class=\"w-full rounded-2xl skew-mockup border border-white/10 grayscale hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"48\">\n      </div>\n      <div class=\"lg:w-1/2\" data-kid=\"49\">\n        <h2 class=\"text-5xl font-bold mb-8 leading-tight\" data-kid=\"50\">LIVE <br data-kid=\"51\"><span class=\"text-primary\" data-kid=\"52\">OBSERVABILITY.</span></h2>\n        <p class=\"text-lg text-text-muted mb-12 font-light\" data-kid=\"53\">\n          Watch your application take shape in real-time. Every agent decision, every line of code, and every infrastructure provision is streamed directly to your console.\n        </p>\n        <div class=\"space-y-6\" data-kid=\"54\">\n          <div class=\"flex items-start gap-4 p-4 glass rounded-xl border-white/5\" data-kid=\"55\">\n            <div class=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\" data-kid=\"56\">\n              <i class=\"ti ti-terminal text-primary\" data-kid=\"57\"></i>\n            </div>\n            <div data-kid=\"58\">\n              <h4 class=\"font-bold text-sm mb-1\" data-kid=\"59\">Streaming Agent Logs</h4>\n              <p class=\"text-xs text-text-muted\" data-kid=\"60\">Real-time terminal outputs from 9 specialized agents working in parallel.</p>\n            </div>\n          </div>\n          <div class=\"flex items-start gap-4 p-4 glass rounded-xl border-white/5\" data-kid=\"61\">\n            <div class=\"w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0\" data-kid=\"62\">\n              <i class=\"ti ti-database text-secondary\" data-kid=\"63\"></i>\n            </div>\n            <div data-kid=\"64\">\n              <h4 class=\"font-bold text-sm mb-1\" data-kid=\"65\">Infrastructure Provisioning</h4>\n              <p class=\"text-xs text-text-muted\" data-kid=\"66\">Automated database schemas, Docker configs, and Kubernetes manifests.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-32\" data-kid=\"67\">\n    <div class=\"px-12 lg:px-24 mb-16\" data-kid=\"68\">\n      <h2 class=\"text-4xl font-bold tracking-tight\" data-kid=\"69\">THE <span class=\"text-primary\" data-kid=\"70\">SWARM</span> MATRIX</h2>\n      <p class=\"text-text-muted font-light mt-4\" data-kid=\"71\">A coordinated network of specialized artificial intelligence.</p>\n    </div>\n    \n    <div class=\"flex gap-8 overflow-x-auto px-12 lg:px-24 py-8 no-scrollbar scroll-smooth\" id=\"agent-carousel\" data-kid=\"72\">\n      \n      <div class=\"min-w-[400px] h-[500px] glass rounded-3xl p-10 flex flex-col justify-between border-white/5 hover:border-primary/30 transition-all group\" data-kid=\"73\">\n        <div data-kid=\"74\">\n          <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/mono/robot.svg\" style=\"color: var(--primary); width: 48px; height: 48px;\" class=\"mb-8 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"75\">\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"76\">SUPERVISOR</h3>\n          <p class=\"text-text-muted font-light leading-relaxed\" data-kid=\"77\">\n            The neural core. Orchestrates the graph, sequences tasks, and manages agent handoffs with sub-millisecond latency.\n          </p>\n        </div>\n        <div class=\"font-mono text-[10px] tracking-widest text-primary uppercase pt-8 border-t border-white/5\" data-kid=\"78\">\n          Orchestration Layer\n        </div>\n      </div>\n      \n      \n      <div class=\"min-w-[400px] h-[500px] glass rounded-3xl p-10 flex flex-col justify-between border-white/5 hover:border-secondary/30 transition-all group\" data-kid=\"79\">\n        <div data-kid=\"80\">\n          <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/mono/comment.svg\" style=\"color: var(--secondary); width: 48px; height: 48px;\" class=\"mb-8 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"81\">\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"82\">FRONTEND</h3>\n          <p class=\"text-text-muted font-light leading-relaxed\" data-kid=\"83\">\n            Next.js 14 specialist. Generates accessible, responsive UIs using Tailwind CSS and Radix primitives.\n          </p>\n        </div>\n        <div class=\"font-mono text-[10px] tracking-widest text-secondary uppercase pt-8 border-t border-white/5\" data-kid=\"84\">\n          UI / UX Synthesis\n        </div>\n      </div>\n\n      \n      <div class=\"min-w-[400px] h-[500px] glass rounded-3xl p-10 flex flex-col justify-between border-white/5 hover:border-accent/30 transition-all group\" data-kid=\"85\">\n        <div data-kid=\"86\">\n          <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/mono/shield.svg\" style=\"color: var(--accent); width: 48px; height: 48px;\" class=\"mb-8 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"87\">\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"88\">SECURITY</h3>\n          <p class=\"text-text-muted font-light leading-relaxed\" data-kid=\"89\">\n            Continuous auditing. OWASP Top 10 scanning, secret detection, and automated dependency hardening.\n          </p>\n        </div>\n        <div class=\"font-mono text-[10px] tracking-widest text-accent uppercase pt-8 border-t border-white/5\" data-kid=\"90\">\n          Hardening & Audit\n        </div>\n      </div>\n\n      \n      <div class=\"min-w-[400px] h-[500px] glass rounded-3xl p-10 flex flex-col justify-between border-white/5 hover:border-white/20 transition-all group\" data-kid=\"91\">\n        <div data-kid=\"92\">\n          <i class=\"ti ti-database text-4xl mb-8 text-white/50 group-hover:text-white transition-colors\" data-kid=\"93\"></i>\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"94\">DATABASE</h3>\n          <p class=\"text-text-muted font-light leading-relaxed\" data-kid=\"95\">\n            Prisma ORM and Postgres architect. Models complex relationships, writes migrations, and seeds test data.\n          </p>\n        </div>\n        <div class=\"font-mono text-[10px] tracking-widest text-white/30 uppercase pt-8 border-t border-white/5\" data-kid=\"96\">\n          Relational Architecture\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-32 px-12 lg:px-24\" data-kid=\"97\">\n    <div class=\"max-w-4xl\" data-kid=\"98\">\n      <h2 class=\"text-5xl font-bold mb-16\" data-kid=\"99\">THE <span class=\"text-primary\" data-kid=\"100\">PIPELINE.</span></h2>\n      <div class=\"relative space-y-24\" data-kid=\"101\">\n        \n        <div class=\"absolute left-6 top-8 bottom-8 w-[1px] bg-gradient-to-b from-primary via-secondary to-transparent\" data-kid=\"102\"></div>\n        \n        <div class=\"relative pl-16 flex flex-col md:flex-row gap-8 items-start\" data-kid=\"103\">\n          <div class=\"absolute left-[21px] w-1.5 h-1.5 rounded-full bg-primary shadow-[0_0_10px_#00f2ff]\" data-kid=\"104\"></div>\n          <div class=\"flex-1\" data-kid=\"105\">\n            <span class=\"font-mono text-[10px] text-primary mb-2 block uppercase\" data-kid=\"106\">Step 01</span>\n            <h4 class=\"text-2xl font-bold mb-4\" data-kid=\"107\">Ingestion & Planning</h4>\n            <p class=\"text-text-muted font-light\" data-kid=\"108\">Natural language parsing via Ollama Cloud. Supervisor decomposes requirements into a parallelized execution graph.</p>\n          </div>\n          <div class=\"flex-1 glass p-4 rounded-xl border-white/5 font-mono text-[10px] text-text-muted\" data-kid=\"109\">\n            <div class=\"flex justify-between mb-2\" data-kid=\"110\"><span data-kid=\"111\">$ swarm init</span><span class=\"text-primary\" data-kid=\"112\">DONE</span></div>\n            <div class=\"text-primary/50\" data-kid=\"113\">> Breaking down task: dashboard_v1</div>\n            <div class=\"text-primary/50\" data-kid=\"114\">> Identified 4 parallel dependencies...</div>\n          </div>\n        </div>\n\n        <div class=\"relative pl-16 flex flex-col md:flex-row gap-8 items-start\" data-kid=\"115\">\n          <div class=\"absolute left-[21px] w-1.5 h-1.5 rounded-full bg-secondary shadow-[0_0_10px_#9d4eff]\" data-kid=\"116\"></div>\n          <div class=\"flex-1\" data-kid=\"117\">\n            <span class=\"font-mono text-[10px] text-secondary mb-2 block uppercase\" data-kid=\"118\">Step 02</span>\n            <h4 class=\"text-2xl font-bold mb-4\" data-kid=\"119\">Parallel Synthesis</h4>\n            <p class=\"text-text-muted font-light\" data-kid=\"120\">Concurrent code generation across frontend, backend, and infrastructure layers. Zero bottleneck orchestration.</p>\n          </div>\n          <div class=\"flex-1 glass p-4 rounded-xl border-white/5 font-mono text-[10px] text-text-muted\" data-kid=\"121\">\n            <div class=\"flex justify-between mb-2\" data-kid=\"122\"><span data-kid=\"123\">$ swarm gen --parallel</span><span class=\"text-secondary animate-pulse\" data-kid=\"124\">RUNNING</span></div>\n            <div class=\"text-white/40\" data-kid=\"125\">Frontend: 84% complete</div>\n            <div class=\"text-white/40\" data-kid=\"126\">Backend: 91% complete</div>\n            <div class=\"text-white/40\" data-kid=\"127\">Database: Migrations applied</div>\n          </div>\n        </div>\n\n        <div class=\"relative pl-16 flex flex-col md:flex-row gap-8 items-start\" data-kid=\"128\">\n          <div class=\"absolute left-[21px] w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_10px_#00ff9d]\" data-kid=\"129\"></div>\n          <div class=\"flex-1\" data-kid=\"130\">\n            <span class=\"font-mono text-[10px] text-accent mb-2 block uppercase\" data-kid=\"131\">Step 03</span>\n            <h4 class=\"text-2xl font-bold mb-4\" data-kid=\"132\">Sandbox Validation</h4>\n            <p class=\"text-text-muted font-light\" data-kid=\"133\">Execution in isolated E2B containers. Automated QA testing and security audits before the first preview.</p>\n          </div>\n          <div class=\"flex-1 glass p-4 rounded-xl border-white/5 font-mono text-[10px] text-text-muted\" data-kid=\"134\">\n            <div class=\"flex justify-between mb-2\" data-kid=\"135\"><span data-kid=\"136\">$ swarm audit</span><span class=\"text-accent\" data-kid=\"137\">PENDING</span></div>\n            <div class=\"text-white/20\" data-kid=\"138\">Running OWASP Top 10...</div>\n            <div class=\"text-white/20\" data-kid=\"139\">Testing API endpoints...</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-48 px-12 lg:px-24 flex flex-col items-center text-center\" data-kid=\"140\">\n    <div class=\"absolute w-[800px] h-[400px] bg-primary/10 blur-[150px] rounded-full top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2\" data-kid=\"141\"></div>\n    <h2 class=\"text-6xl lg:text-8xl font-bold mb-12 tracking-tight\" data-kid=\"142\">READY TO <br data-kid=\"143\"><span class=\"text-gradient\" data-kid=\"144\">INSTANTIATE?</span></h2>\n    <div class=\"flex flex-col sm:flex-row gap-6\" data-kid=\"145\">\n      <a href=\"#\" class=\"px-12 py-5 bg-primary text-black font-bold rounded-2xl hover:scale-105 transition-all shadow-[0_0_30px_rgba(0,242,255,0.3)]\" data-kid=\"146\">Get Started Free</a>\n      <a href=\"#\" class=\"px-12 py-5 glass border-white/10 font-bold rounded-2xl hover:bg-white/5 transition-all\" data-kid=\"147\">View Documentation</a>\n    </div>\n  </section>\n\n  \n  <footer class=\"relative py-24 px-12 lg:px-24 border-t border-white/5 bg-black/50 backdrop-blur-xl\" data-kid=\"148\">\n    <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-12 mb-24\" data-kid=\"149\">\n      <div data-kid=\"150\">\n        <div class=\"flex items-center gap-3 mb-8\" data-kid=\"151\">\n          <i class=\"ti ti-sparkles text-primary text-xl\" data-kid=\"152\"></i>\n          <span class=\"text-lg font-bold tracking-tighter uppercase\" data-kid=\"153\">SwarmDev</span>\n        </div>\n        <p class=\"text-xs text-text-muted font-mono leading-relaxed\" data-kid=\"154\">\n          Deep Void Engine. <br data-kid=\"155\">\n          Cloud-native multi-agent <br data-kid=\"156\">\n          development platform.\n        </p>\n      </div>\n      <div data-kid=\"157\">\n        <h5 class=\"font-bold text-xs uppercase tracking-widest mb-8 text-white/30\" data-kid=\"158\">System</h5>\n        <ul class=\"text-sm space-y-4 text-text-muted\" data-kid=\"159\">\n          <li data-kid=\"160\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"161\">Manifesto</a></li>\n          <li data-kid=\"162\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"163\">Architecture</a></li>\n          <li data-kid=\"164\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"165\">Cloud Sandbox</a></li>\n          <li data-kid=\"166\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"167\">E2B Integration</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"168\">\n        <h5 class=\"font-bold text-xs uppercase tracking-widest mb-8 text-white/30\" data-kid=\"169\">Developer</h5>\n        <ul class=\"text-sm space-y-4 text-text-muted\" data-kid=\"170\">\n          <li data-kid=\"171\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"172\">Documentation</a></li>\n          <li data-kid=\"173\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"174\">API Reference</a></li>\n          <li data-kid=\"175\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"176\">Agent Prompts</a></li>\n          <li data-kid=\"177\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"178\">Status</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"179\">\n        <h5 class=\"font-bold text-xs uppercase tracking-widest mb-8 text-white/30\" data-kid=\"180\">Enterprise</h5>\n        <ul class=\"text-sm space-y-4 text-text-muted\" data-kid=\"181\">\n          <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"183\">Pricing</a></li>\n          <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"185\">Security</a></li>\n          <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"187\">Team Access</a></li>\n          <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-primary\" data-kid=\"189\">Contact</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"flex flex-col md:flex-row justify-between items-center gap-8 pt-12 border-t border-white/5 text-[10px] font-mono text-text-muted uppercase tracking-widest\" data-kid=\"190\">\n      <div data-kid=\"191\">&copy; 2026 SwarmDev Inc. All rights reserved.</div>\n      <div class=\"flex gap-8\" data-kid=\"192\">\n        <a href=\"#\" data-kid=\"193\">Privacy</a>\n        <a href=\"#\" data-kid=\"194\">Terms</a>\n        <a href=\"#\" data-kid=\"195\">Security</a>\n      </div>\n      <div class=\"flex items-center gap-2\" data-kid=\"196\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-accent\" data-kid=\"197\"></span>\n        All Agents Online\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"198\">\n  import { animate, scroll, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Entrance Animations\n  animate(\"nav\", { y: [-20, 0], opacity: [0, 1] }, { duration: 0.8, ease: \"easeOut\" });\n  animate(\"h1\", { y: [40, 0], opacity: [0, 1] }, { duration: 1, ease: \"easeOut\", delay: 0.2 });\n  animate(\"p\", { y: [20, 0], opacity: [0, 1] }, { duration: 1, ease: \"easeOut\", delay: 0.4 });\n  animate(\".glass\", { scale: [0.95, 1], opacity: [0, 1] }, { duration: 0.8, delay: stagger(0.1, { startDelay: 0.6 }) });\n\n  // Scroll Animations\n  inView(\"h2\", (info) => {\n    animate(info.target, { y: [40, 0], opacity: [0, 1] }, { duration: 0.8 });\n  });\n\n  scroll(animate(\".skew-mockup\", { \n    y: [-50, 50],\n    rotateX: [5, -5],\n    rotateY: [-15, -5]\n  }), {\n    target: document.querySelector(\".skew-mockup\"),\n    offset: [\"start end\", \"end start\"]\n  });\n\n  // Smooth appearance for agents\n  inView(\"#agent-carousel > div\", (info) => {\n    animate(info.target, { y: [40, 0], opacity: [0, 1] }, { \n      duration: 0.8,\n      delay: stagger(0.1)\n    });\n  });\n\n  // Parallax for orbs\n  scroll((progress) => {\n    const orbs = document.querySelectorAll(\".glow-orb\");\n    orbs[0].style.transform = `translateY(${progress * 200}px)`;\n    orbs[1].style.transform = `translateY(${progress * -200}px)`;\n  });\n\n  // Horizontal Scroll behavior for Agent Carousel\n  const carousel = document.querySelector(\"#agent-carousel\");\n  carousel.addEventListener(\"wheel\", (e) => {\n    if (e.deltaY !== 0) {\n      e.preventDefault();\n      carousel.scrollLeft += e.deltaY;\n    }\n  });\n\n</script>",
