>\n              <span class=\"text-[10px] opacity-0 group-hover:opacity-100\" data-kid=\"51\">READY</span>\n            </div>\n            <div class=\"flex items-center justify-between p-2 rounded hover:bg-zinc-800/50 text-xs text-zinc-400 group cursor-default\" data-kid=\"52\">\n              <div class=\"flex items-center gap-2\" data-kid=\"53\">\n                <div class=\"w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-amber-500\" data-kid=\"54\"></div>\n                <span data-kid=\"55\">Backend</span>\n              </div>\n            </div>\n            <div class=\"flex items-center justify-between p-2 rounded hover:bg-zinc-800/50 text-xs text-zinc-400 group cursor-default\" data-kid=\"56\">\n              <div class=\"flex items-center gap-2\" data-kid=\"57\">\n                <div class=\"w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-amber-500\" data-kid=\"58\"></div>\n                <span data-kid=\"59\">Database</span>\n              </div>\n            </div>\n            <div class=\"flex items-center justify-between p-2 rounded hover:bg-zinc-800/50 text-xs text-zinc-400 group cursor-default\" data-kid=\"60\">\n              <div class=\"flex items-center gap-2\" data-kid=\"61\">\n                <div class=\"w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-amber-500\" data-kid=\"62\"></div>\n                <span data-kid=\"63\">DevOps</span>\n              </div>\n            </div>\n            <div class=\"flex items-center justify-between p-2 rounded hover:bg-zinc-800/50 text-xs text-zinc-400 group cursor-default\" data-kid=\"64\">\n              <div class=\"flex items-center gap-2\" data-kid=\"65\">\n                <div class=\"w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-amber-500\" data-kid=\"66\"></div>\n                <span data-kid=\"67\">Security</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"p-4 border-t border-zinc-800\" data-kid=\"68\">\n            <div class=\"p-3 rounded border border-zinc-800 bg-zinc-950 text-[10px] font-mono leading-tight\" data-kid=\"69\">\n              <div class=\"text-zinc-500 mb-1\" data-kid=\"70\">// System Health</div>\n              <div class=\"flex justify-between text-zinc-400\" data-kid=\"71\">\n                <span data-kid=\"72\">CPU:</span>\n                <span class=\"text-cyan-500\" data-kid=\"73\">12.4%</span>\n              </div>\n              <div class=\"flex justify-between text-zinc-400\" data-kid=\"74\">\n                <span data-kid=\"75\">MEM:</span>\n                <span class=\"text-cyan-500\" data-kid=\"76\">2.1GB</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex-1 flex flex-col bg-zinc-950 p-12 relative overflow-hidden\" data-kid=\"77\">\n          <div class=\"absolute top-0 right-0 p-8 opacity-10\" data-kid=\"78\">\n             <i class=\"ti ti-layout-panel-left text-[240px]\" data-kid=\"79\"></i>\n          </div>\n\n          <div class=\"relative z-10 max-w-2xl\" data-kid=\"80\">\n            <div class=\"mb-6 inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/20 bg-cyan-500/5 text-cyan-500 font-mono text-[10px] uppercase tracking-wider\" data-kid=\"81\">\n              <span class=\"animate-pulse\" data-kid=\"82\">●</span> Active Cluster: ollama-v1-cloud\n            </div>\n\n            <div class=\"font-mono space-y-4\" data-kid=\"83\">\n              <div class=\"text-zinc-600 text-sm\" data-kid=\"84\">1 <span class=\"text-purple-400\" data-kid=\"85\">import</span> { <span class=\"text-cyan-400\" data-kid=\"86\">Swarm</span> } <span class=\"text-purple-400\" data-kid=\"87\">from</span> <span class=\"text-amber-200\" data-kid=\"88\">\"@swarmdev/engine\"</span>;</div>\n              <div class=\"text-zinc-600 text-sm\" data-kid=\"89\">2</div>\n              <div class=\"flex gap-4\" data-kid=\"90\">\n                <span class=\"text-zinc-600 text-sm\" data-kid=\"91\">3</span>\n                <h1 class=\"text-5xl md:text-6xl font-bold tracking-tighter leading-[1.1]\" data-kid=\"92\">\n                  A full <span class=\"text-gradient\" data-kid=\"93\">dev team</span><br data-kid=\"94\">\n                  in your <span class=\"underline decoration-cyan-500 underline-offset-8\" data-kid=\"95\">browser</span>.\n                </h1>\n              </div>\n              <div class=\"text-zinc-600 text-sm\" data-kid=\"96\">4</div>\n              <div class=\"flex gap-4\" data-kid=\"97\">\n                <span class=\"text-zinc-600 text-sm\" data-kid=\"98\">5</span>\n                <p class=\"text-lg text-zinc-400 font-sans\" data-kid=\"99\">\n                  Describe your idea in plain English. Nine specialized AI agents collaborate in parallel to generate a complete production-ready full-stack application.\n                </p>\n              </div>\n              <div class=\"text-zinc-600 text-sm\" data-kid=\"100\">6</div>\n              <div class=\"flex gap-4\" data-kid=\"101\">\n                <span class=\"text-zinc-600 text-sm\" data-kid=\"102\">7</span>\n                <div class=\"flex flex-wrap gap-4 mt-4\" data-kid=\"103\">\n                  <a href=\"/dashboard/new\" class=\"bg-white text-black px-8 py-3 rounded-sm font-bold flex items-center gap-2 hover:bg-cyan-500 hover:text-white transition-all\" data-kid=\"104\">\n                    ./start_free\n                    <i class=\"ti ti-arrow-right\" data-kid=\"105\"></i>\n                  </a>\n                  <a href=\"#engine\" class=\"border border-zinc-800 bg-zinc-900/50 text-white px-8 py-3 rounded-sm font-bold flex items-center gap-2 hover:border-zinc-600 transition-all\" data-kid=\"106\">\n                    <i class=\"ti ti-play\" data-kid=\"107\"></i>\n                    VIEW_ARCHITECTURE\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div cl