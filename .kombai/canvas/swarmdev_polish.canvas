         <span class=\"text-zinc-600\" data-kid=\"263\">NODES:</span>\n              <span class=\"text-cyan-400\" data-kid=\"264\">9 AGENTS (ALL)</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"265\">\n              <span class=\"text-zinc-600\" data-kid=\"266\">SLOTS:</span>\n              <span class=\"text-cyan-400\" data-kid=\"267\">UNLIMITED</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"268\">\n              <span class=\"text-zinc-600\" data-kid=\"269\">COST:</span>\n              <span class=\"text-white font-bold\" data-kid=\"270\">$29.00 / MO</span>\n            </div>\n          </div>\n          <a href=\"/auth/signup\" class=\"bg-cyan-600 text-white px-6 py-2 text-xs font-mono btn-precision hover:bg-cyan-500 transition-all\" data-kid=\"271\">ALLOCATE_POWER</a>\n        </div>\n\n        \n        <div class=\"rack-card glass-panel p-6 flex flex-col md:flex-row items-center gap-8 group\" data-kid=\"272\">\n          <div class=\"flex items-center gap-4 min-w-[200px]\" data-kid=\"273\">\n            <div class=\"flex flex-col gap-1\" data-kid=\"274\">\n               <div class=\"w-1 h-1 rounded-full bg-purple-500\" data-kid=\"275\"></div>\n               <div class=\"w-1 h-1 rounded-full bg-purple-500\" data-kid=\"276\"></div>\n               <div class=\"w-1 h-1 rounded-full bg-purple-500\" data-kid=\"277\"></div>\n            </div>\n            <div data-kid=\"278\">\n              <div class=\"font-mono text-[10px] text-purple-500\" data-kid=\"279\">UNIT_03 (DISTRIBUTED)</div>\n              <div class=\"text-xl font-bold\" data-kid=\"280\">TEAM_FLEET</div>\n            </div>\n          </div>\n          <div class=\"flex-1 grid grid-cols-2 md:grid-cols-4 gap-4 font-mono text-[11px] text-zinc-400\" data-kid=\"281\">\n            <div class=\"flex flex-col\" data-kid=\"282\">\n              <span class=\"text-zinc-600\" data-kid=\"283\">COMPUTE:</span>\n              <span data-kid=\"284\">10M TOKENS / MO</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"285\">\n              <span class=\"text-zinc-600\" data-kid=\"286\">NODES:</span>\n              <span data-kid=\"287\">MULTI-USER SWARM</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"288\">\n              <span class=\"text-zinc-600\" data-kid=\"289\">SLOTS:</span>\n              <span data-kid=\"290\">UNLIMITED</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"291\">\n              <span class=\"text-zinc-600\" data-kid=\"292\">COST:</span>\n              <span class=\"text-white font-bold\" data-kid=\"293\">$99.00 / MO</span>\n            </div>\n          </div>\n          <a href=\"/auth/signup\" class=\"border border-zinc-800 px-6 py-2 text-xs font-mono hover:bg-white hover:text-black transition-all\" data-kid=\"294\">SELECT_FLEET</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 border-t border-zinc-800\" data-kid=\"295\">\n    <div class=\"max-w-4xl mx-auto px-6 text-center\" data-kid=\"296\">\n      <div class=\"font-mono text-xs text-zinc-600 mb-8 tracking-[0.4em] uppercase\" data-kid=\"297\">Ready to instantiate your swarm?</div>\n      <button class=\"relative group w-full py-20 glass-panel rounded-lg border-2 border-dashed border-zinc-800 hover:border-cyan-500/50 transition-all\" data-kid=\"298\">\n        <div class=\"absolute inset-0 bg-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"299\"></div>\n        <div class=\"relative z-10 flex flex-col items-center gap-6\" data-kid=\"300\">\n          <div class=\"w-16 h-16 rounded-full border border-cyan-500 flex items-center justify-center group-hover:glow-cyan transition-all\" data-kid=\"301\">\n             <i class=\"ti ti-rocket text-3xl text-cyan-500\" data-kid=\"302\"></i>\n          </div>\n          <div class=\"text-4xl md:text-5xl font-bold tracking-tighter uppercase font-mono\" data-kid=\"303\">./deploy_system</div>\n        </div>\n        <div class=\"absolute bottom-4 right-4 font-mono text-[10px] text-zinc-600\" data-kid=\"304\">CMD + ENTER</div>\n      </button>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 border-t border-zinc-900 bg-zinc-950 font-mono text-[10px] text-zinc-600 uppercase tracking-widest\" data-kid=\"305\">\n    <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"306\">\n      <div class=\"flex items-center gap-6\" data-kid=\"307\">\n        <span data-kid=\"308\">&copy; 2026 SWARMDEV_CORP</span>\n        <span class=\"text-zinc-800\" data-kid=\"309\">|</span>\n        <div class=\"flex items-center gap-2\" data-kid=\"310\">\n          <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" data-kid=\"311\"></div>\n          <span data-kid=\"312\">ALL_SYSTEMS_OPERATIONAL</span>\n        </div>\n      </div>\n      <div class=\"flex gap-8\" data-kid=\"313\">\n        <a href=\"#\" class=\"hover:text-cyan-500 transition-colors\" data-kid=\"314\">GITHUB</a>\n        <a href=\"#\" class=\"hover:text-cyan-500 transition-colors\" data-kid=\"315\">DOCUMENTATION</a>\n        <a href=\"#\" class=\"hover:text-cyan-500 transition-colors\" data-kid=\"316\">SECURITY_MANIFESTO</a>\n        <a href=\"#\" class=\"hover:text-cyan-500 transition-colors\" data-kid=\"317\">LEGAL_SPEC</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"318\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"319\"></script>\n<script data-kid=\"320\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Intro\n  gsap.from(\".glass-panel\", {\n    y: 40,\n    opacity: 0,\n    duration: 1,\n    ease: \"power3.out\",\n    delay: 0.2\n  });\n\n  // Blueprint diagram elements entrance\n  gsap.from(\"#engine .flex-col\", {\n    scrollTrigger: {\n      trigger: \"#engine\",\n      start: \"top 80%\"\n    },\n    y: 30,\n    opacity: 0,\n    stagger: 0.2,\n    duration: 0.8,\n    ease: \"power2.out\"\n  });\n\n  // Feature Spec reveal\n  gsap.from(\"#features .group\", {\n    scrollTrigger: {\n      trigger: \"#features\",\n      start: \"top 70%\"\n    },\n    x: -20,\n    opacity: 0,\n    stagger: 0.1,\n    duration: 0.6,\n    ease: \"power2.out\"\n  });\n\n  // Rack card stagger\n  gsap.from(\".rack-card\", {\n    scrollTrigger: {\n      trigger: \"#pricing\",\n      start: \"top 80%\"\n    },\n    x: -50,\n    opacity: 0,\n    stagger: 0.15,\n    duration: 0.7,\n    ease: \"back.out(1.2)\"\n  });\n</script>",
