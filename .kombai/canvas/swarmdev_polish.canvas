      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100;300;400;500;600;700;800;900&family=Geist+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #050505;\n    --primary: #00f2ff;\n    --secondary: #9d4eff;\n    --glass: rgba(255, 255, 255, 0.03);\n    --glass-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    background-color: var(--bg);\n    color: white;\n    font-family: 'Geist', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, white 50%, rgba(255,255,255,0.4));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(16px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .glass-card {\n    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);\n    border: 1px solid rgba(255,255,255,0.1);\n    backdrop-filter: blur(8px);\n  }\n\n  .bg-dots {\n    background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px);\n    background-size: 32px 32px;\n  }\n\n  .skew-hero {\n    transform: perspective(1500px) rotateY(-20deg) rotateX(8deg) rotateZ(2deg) scale(1.1);\n    box-shadow: -40px 40px 80px rgba(0,0,0,0.8);\n  }\n\n  .btn-auth {\n    @apply flex items-center justify-center gap-3 w-full py-3 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 transition-all text-sm font-medium;\n  }\n\n  .glow-orb {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0, 242, 255, 0.1) 0%, transparent 70%);\n    filter: blur(80px);\n    pointer-events: none;\n    z-index: -1;\n  }\n\n  /* Custom pulse for active status */\n  .status-pulse {\n    @apply relative flex h-2 w-2;\n  }\n  .status-pulse span:first-child {\n    @apply animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75;\n  }\n  .status-pulse span:last-child {\n    @apply relative inline-flex rounded-full h-2 w-2 bg-cyan-500;\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n\n<div class=\"relative min-h-screen bg-dots\" data-kid=\"1\">\n  \n  <div class=\"glow-orb top-[-200px] left-[-100px]\" data-kid=\"2\"></div>\n  <div class=\"glow-orb bottom-[-200px] right-[-100px]\" style=\"background: radial-gradient(circle, rgba(157, 78, 255, 0.08) 0%, transparent 70%);\" data-kid=\"3\"></div>\n\n  \n  <nav class=\"fixed top-0 w-full z-50 px-8 py-6 flex justify-between items-center border-b border-white/5 bg-black/20 backdrop-blur-md\" data-kid=\"4\">\n    <div class=\"flex items-center gap-2\" data-kid=\"5\">\n      <div class=\"w-8 h-8 glass rounded-lg flex items-center justify-center border-white/10\" data-kid=\"6\">\n        <i class=\"ti ti-sparkles text-cyan-400 text-lg\" data-kid=\"7\"></i>\n      </div>\n      <span class=\"text-lg font-bold tracking-tighter uppercase\" data-kid=\"8\">Swarm<span class=\"text-cyan-400\" data-kid=\"9\">Dev</span></span>\n    </div>\n    <div class=\"flex items-center gap-8\" data-kid=\"10\">\n      <div class=\"hidden md:flex items-center gap-8 text-xs font-medium uppercase tracking-widest text-white/40\" data-kid=\"11\">\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Platform</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Pricing</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"14\">Docs</a>\n      </div>\n      <div class=\"w-px h-4 bg-white/10 hidden md:block\" data-kid=\"15\"></div>\n      <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-cyan-400 transition-colors\" data-kid=\"16\">Log In</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-40 pb-20 px-8 lg:px-20 max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-20\" data-kid=\"17\">\n    \n    <div class=\"w-full lg:w-1/2 flex flex-col items-center lg:items-start text-center lg:text-left\" data-kid=\"18\">\n      <div class=\"inline-flex items-center gap-3 px-4 py-1.5 glass rounded-full text-[10px] font-bold tracking-[0.2em] uppercase text-white/60 border-white/10 mb-8\" data-kid=\"19\">\n        <div class=\"status-pulse\" data-kid=\"20\"><span data-kid=\"21\"></span><span data-kid=\"22\"></span></div>\n        3M+ Swarm Operations Launched\n      </div>\n      \n      <h1 class=\"text-5xl lg:text-7xl font-extrabold tracking-tight leading-[1] mb-8 text-gradient\" data-kid=\"23\">\n        Build Full-Stack<br data-kid=\"24\">\n        <span class=\"text-white\" data-kid=\"25\">In Minutes.</span>\n      </h1>\n      \n      <p class=\"text-lg text-white/50 max-w-lg mb-12 font-light leading-relaxed\" data-kid=\"26\">\n        Describe your application in plain English. Our specialized AI swarm designs, codes, and deploys your entire stack instantly.\n      </p>\n\n      \n      <div class=\"w-full max-w-md glass rounded-3xl p-8 border-white/5 shadow-2xl relative overflow-hidden\" data-kid=\"27\">\n        <div class=\"absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-purple-500/5 opacity-50\" data-kid=\"28\"></div>\n        <div class=\"relative z-10\" data-kid=\"29\">\n          <h3 class=\"text-xl font-bold mb-8 text-center\" data-kid=\"30\">What will you build?</h3>\n          \n          <div class=\"space-y-3\" data-kid=\"31\">\n            <button class=\"btn-auth bg-white !text-black border-none font-bold\" data-kid=\"32\">\n              <i class=\"ti ti-brand-google text-lg\" data-kid=\"33\"></i> Continue with Google\n            </button>\n            <div class=\"grid grid-cols-3 gap-3\" data-kid=\"34\">\n              <button class=\"btn-auth py-2.5 px-0\" data-kid=\"35\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"36\"></i></button>\n              <button class=\"btn-auth py-2.5 px-0\" data-kid=\"37\"><i class=\"ti ti-brand-apple text-xl\" data-kid=\"38\"></i></button>\n              <button class=\"btn-auth py-2.5 px-0\" data-kid=\"39\"><i class=\"ti ti-brand-discord text-xl\" data-kid=\"40\"></i></button>\n            </div>\n          </div>\n\n          <div class=\"relative my-8 flex items-center\" data-kid=\"41\">\n            <div class=\"flex-grow border-t border-white/5\" data-kid=\"42\"></div>\n            <span class=\"flex-shrink mx-4 text-[10px] font-bold uppercase tracking-widest text-white/20\" data-kid=\"43\">OR</span>\n            <div class=\"flex-grow border-t border-white/5\" data-kid=\"44\"></div>\n          </div>\n\n          <div class=\"space-y-3\" data-kid=\"45\">\n             <button class=\"btn-auth text-white/60\" data-kid=\"46\"><i class=\"ti ti-mail text-lg\" data-kid=\"47\"></i> Continue with Email</button>\n             <button class=\"btn-auth text-white/60\" data-kid=\"48\"><i class=\"ti ti-device-mobile text-lg\" data-kid=\"49\"></i> Continue with Phone</button>\n          </div>\n\n          <p class=\"mt-6 text-[10px] text-center text-white/20 leading-relaxed uppercase tracking-tighter\" data-kid=\"50\">\n            By continuing, you agree to our <a href=\"#\" class=\"underline\" data-kid=\"51\">Terms</a> and <a href=\"#\" class=\"underline\" data-kid=\"52\">Privacy Policy</a>\n          </p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full lg:w-1/2 relative\" data-kid=\"53\">\n      <div class=\"absolute -inset-20 bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none\" data-kid=\"54\"></div>\n      \n      <div class=\"relative skew-hero\" data-kid=\"55\">\n        \n        <div class=\"absolute -top-10 -right-10 w-64 h-[400px] glass rounded-2xl border-white/10 shadow-2xl z-20 overflow-hidden hidden xl:block\" data-kid=\"56\">\n           <div class=\"p-4 border-b border-white/5 bg-white/5 flex items-center justify-between\" data-kid=\"57\">\n              <div class=\"flex gap-1\" data-kid=\"58\">\n                <div class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"59\"></div>\n                <div class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"60\"></div>\n                <div class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"61\"></div>\n              </div>\n              <span class=\"text-[9px] font-mono text-white/40 uppercase\" data-kid=\"62\">Mobile Preview</span>\n           </div>\n           <div class=\"p-4 space-y-4\" data-kid=\"63\">\n              <div class=\"w-full h-8 glass rounded-lg\" data-kid=\"64\"></div>\n              <div class=\"grid grid-cols-2 gap-2\" data-kid=\"65\">\n                <div class=\"h-16 glass rounded-lg\" data-kid=\"66\"></div>\n                <div class=\"h-16 glass rounded-lg\" data-kid=\"67\"></div>\n              </div>\n              <div class=\"w-full h-32 glass rounded-lg bg-gradient-to-br from-cyan-500/20 to-transparent\" data-kid=\"68\"></div>\n              <div class=\"w-full h-2 bg-white/5 rounded-full\" data-kid=\"69\"></div>\n              <div class=\"w-2/3 h-2 bg-white/5 rounded-full\" data-kid=\"70\"></div>\n           </div>\n        </div>\n\n        \n        <div class=\"w-full aspect-[4/3] glass rounded-3xl border-white/10 shadow-inner overflow-hidden relative group\" data-kid=\"71\">\n          <div class=\"absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"72\"></div>\n          \n          <div class=\"h-10 bg-black/40 border-b border-white/5 flex items-center px-4 justify-between\" data-kid=\"73\">\n            <div class=\"flex gap-1.5\" data-kid=\"74\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#ff5f56]\" data-kid=\"75\"></div>\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#ffbd2e]\" data-kid=\"76\"></div>\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#27c93f]\" data-kid=\"77\"></div>\n            </div>\n            <div class=\"px-3 py-1 glass rounded-md text-[9px] font-mono text-white/40 flex items-center gap-2\" data-kid=\"78\">\n               <i class=\"ti ti-lock text-[10px] text-cyan-400\" data-kid=\"79\"></i> app.swarmdev.cloud/dashboard\n            </div>\n            <div class=\"w-10\" data-kid=\"80\"></div>\n          </div>\n\n          <div class=\"relative h-full\" data-kid=\"81\">\n            <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"82\">\n            \n            <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent\" data-kid=\"83\"></div>\n            \n            \n            <div class=\"absolute bottom-8 left-8 right-8 h-40 glass rounded-2xl border-white/10 flex flex-col\" data-kid=\"84\">\n              <div class=\"p-3 border-b border-white/5 bg-white/5 flex items-center gap-3\" data-kid=\"85\">\n                <i class=\"ti ti-terminal text-cyan-400\" data-kid=\"86\"></i>\n                <span class=\"text-[10px] font-mono text-white/60 tracking-wider\" data-kid=\"87\">SWARM_EXECUTOR_V4.LOG</span>\n              </div>\n              <div class=\"p-4 font-mono text-[9px] text-cyan-500/80 space-y-1\" data-kid=\"88\">\n                <div data-kid=\"89\">[04:48:43] <span class=\"text-white/40\" data-kid=\"90\">INITIALIZING ORCHESTRATOR...</span></div>\n                <div data-kid=\"91\">[04:48:44] <span class=\"text-white/40\" data-kid=\"92\">SPAWNING 9 AGENT NODES...</span></div>\n                <div data-kid=\"93\">[04:48:45] <span class=\"text-purple-400\" data-kid=\"94\">FRONTEND_AGENT:</span> SCAFFOLDING NEXT.JS 14 CORE...</div>\n                <div data-kid=\"95\">[04:48:46] <span class=\"text-cyan-400\" data-kid=\"96\">BACKEND_AGENT:</span> GENERATING PRISMA SCHEMAS...</div>\n                <div class=\"flex gap-1\" data-kid=\"97\"><span data-kid=\"98\">[04:48:47]</span> <span class=\"text-white animate-pulse\" data-kid=\"99\">_</span></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 border-t border-white/5 bg-black/40\" data-kid=\"100\">\n    <div class=\"max-w-7xl mx-auto px-8 lg:px-20\" data-kid=\"101\">\n      <div class=\"flex flex-col md:flex-row justify-between items-end gap-8 mb-16\" data-kid=\"102\">\n        <div class=\"max-w-xl\" data-kid=\"103\">\n          <h2 class=\"text-3xl font-bold mb-4 uppercase tracking-tighter\" data-kid=\"104\">The Capability Matrix</h2>\n          <p class=\"text-white/40 font-light\" data-kid=\"105\">A coordinated network of specialized artificial intelligence modules.</p>\n        </div>\n        <div class=\"flex gap-2\" data-kid=\"106\">\n           <button class=\"w-10 h-10 glass rounded-full flex items-center justify-center border-white/10 hover:border-cyan-500/40 transition-colors\" data-kid=\"107\"><i class=\"ti ti-arrow-left\" data-kid=\"108\"></i></button>\n           <button class=\"w-10 h-10 glass rounded-full flex items-center justify-center border-white/10 hover:border-cyan-500/40 transition-colors\" data-kid=\"109\"><i class=\"ti ti-arrow-right text-cyan-400\" data-kid=\"110\"></i></button>\n        </div>\n      </div>\n\n      <div class=\"flex gap-6 overflow-x-auto no-scrollbar pb-8\" id=\"capability-matrix\" data-kid=\"111\">\n        \n        <div class=\"min-w-[400px] aspect-[1.1] glass-card rounded-[32px] p-10 flex flex-col justify-between group hover:border-orange-500/30 transition-all duration-500\" data-kid=\"112\">\n           <div class=\"w-16 h-16 rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-500\" data-kid=\"113\">\n              <i class=\"ti ti-cpu text-3xl text-orange-400\" data-kid=\"114\"></i>\n           </div>\n           <div data-kid=\"115\">\n              <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"116\">Neural Orchestration</h3>\n              <p class=\"text-sm text-white/40 leading-relaxed\" data-kid=\"117\">The Supervisor agent decomposes complex requirements into an optimized execution graph with sub-millisecond planning latency.</p>\n           </div>\n           <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-orange-400/60\" data-kid=\"118\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse\" data-kid=\"119\"></span> SYSTEM_CORE_V1\n           </div>\n        </div>\n\n        \n        <div class=\"min-w-[400px] aspect-[1.1] glass-card rounded-[32px] p-10 flex flex-col justify-between group hover:border-cyan-500/30 transition-all duration-500\" data-kid=\"120\">\n           <div class=\"w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-500\" data-kid=\"121\">\n              <i class=\"ti ti-layers-intersect text-3xl text-cyan-400\" data-kid=\"122\"></i>\n           </div>\n           <div data-kid=\"123\">\n              <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"124\">Parallel Synthesis</h3>\n              <p class=\"text-sm text-white/40 leading-relaxed\" data-kid=\"125\">Nine agents working concurrently. While one models the DB, another scaffolds the UI and a third hardened security protocols.</p>\n           </div>\n           <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-cyan-400/60\" data-kid=\"126\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse\" data-kid=\"127\"></span> RUNTIME_ENV_V4\n           </div>\n        </div>\n\n        \n        <div class=\"min-w-[400px] aspect-[1.1] glass-card rounded-[32px] p-10 flex flex-col justify-between group hover:border-purple-500/30 transition-all duration-500\" data-kid=\"128\">\n           <div class=\"w-16 h-16 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-500\" data-kid=\"129\">\n              <i class=\"ti ti-shield-check text-3xl text-purple-400\" data-kid=\"130\"></i>\n           </div>\n           <div data-kid=\"131\">\n              <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"132\">Atomic Hardening</h3>\n              <p class=\"text-sm text-white/40 leading-relaxed\" data-kid=\"133\">Every line of generated code is audited for OWASP Top 10 vulnerabilities and secret leaks before reaching the sandbox.</p>\n           </div>\n           <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-purple-400/60\" data-kid=\"134\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse\" data-kid=\"135\"></span> SEC_PROTOCOL_X\n           </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 lg:px-20 max-w-7xl mx-auto\" data-kid=\"136\">\n    <div class=\"flex flex-col lg:flex-row items-start gap-20\" data-kid=\"137\">\n      <div class=\"lg:w-1/3 lg:sticky lg:top-40\" data-kid=\"138\">\n        <h2 class=\"text-4xl font-bold mb-6 tracking-tight uppercase leading-[0.9]\" data-kid=\"139\">Platform<br data-kid=\"140\"><span class=\"text-cyan-400\" data-kid=\"141\">Power.</span></h2>\n        <p class=\"text-white/40 font-light leading-relaxed mb-8\" data-kid=\"142\">A vertically integrated stack designed for massive engineering velocity.</p>\n        <div class=\"flex flex-col gap-4\" data-kid=\"143\">\n           <div class=\"p-4 glass rounded-2xl border-white/5 flex items-center gap-4\" data-kid=\"144\">\n              <div class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center\" data-kid=\"145\"><i class=\"ti ti-database text-white/40\" data-kid=\"146\"></i></div>\n              <span class=\"text-xs font-bold uppercase tracking-widest text-white/60\" data-kid=\"147\">Cloud Database Layer</span>\n           </div>\n           <div class=\"p-4 glass rounded-2xl border-white/5 flex items-center gap-4\" data-kid=\"148\">\n              <div class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center\" data-kid=\"149\"><i class=\"ti ti-box text-white/40\" data-kid=\"150\"></i></div>\n              <span class=\"text-xs font-bold uppercase tracking-widest text-white/60\" data-kid=\"151\">E2B Isolated Sandbox</span>\n           </div>\n        </div>\n      </div>\n\n      <div class=\"lg:w-2/3 space-y-1\" data-kid=\"152\">\n        \n        <div class=\"glass rounded-[40px] p-12 border-white/5 relative overflow-hidden group\" data-kid=\"153\">\n          <div class=\"absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"154\">\n            <i class=\"ti ti-layout-2 text-[200px]\" data-kid=\"155\"></i>\n          </div>\n          <div class=\"relative z-10 max-w-lg\" data-kid=\"156\">\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-cyan-400 mb-6 block\" data-kid=\"157\">Module 01</span>\n            <h3 class=\"text-4xl font-bold mb-6\" data-kid=\"158\">Autonomous Frontend</h3>\n            <p class=\"text-white/40 font-light leading-relaxed mb-8\" data-kid=\"159\">A specialized agent that masters Next.js 14, Tailwind CSS, and Framer Motion. It doesn't just write code; it designs accessible, responsive user experiences.</p>\n            <div class=\"flex flex-wrap gap-3\" data-kid=\"160\">\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"161\">Next.js 14</span>\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"162\">App Router</span>\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"163\">Tailwind v4</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"glass rounded-[40px] p-12 border-white/5 relative overflow-hidden group\" data-kid=\"164\">\n          <div class=\"absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"165\">\n            <i class=\"ti ti-server text-[200px]\" data-kid=\"166\"></i>\n          </div>\n          <div class=\"relative z-10 max-w-lg\" data-kid=\"167\">\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-purple-400 mb-6 block\" data-kid=\"168\">Module 02</span>\n            <h3 class=\"text-4xl font-bold mb-6\" data-kid=\"169\">Relational API Engine</h3>\n            <p class=\"text-white/40 font-light leading-relaxed mb-8\" data-kid=\"170\">Express.js specialists that architecture complex Prisma schemas, implement multi-tenant auth flows, and integrate Stripe webhooks seamlessly.</p>\n            <div class=\"flex flex-wrap gap-3\" data-kid=\"171\">\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"172\">Node.js</span>\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"173\">Prisma ORM</span>\n               <span class=\"px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60\" data-kid=\"174\">PostgreSQL</span>\n            </div>\n          </div>\n        </div>\n        \n        \n        <div class=\"glass rounded-[40px] p-12 border-white/5 relative overflow-hidden group\" data-kid=\"175\">\n          <div class=\"absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"176\">\n            <i class=\"ti ti-git-branch text-[200px]\" data-kid=\"177\"></i>\n          </div>\n          <div class=\"relative z-10 max-w-lg\" data-kid=\"178\">\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-emerald-400 mb-6 block\" data-kid=\"179\">Module 03</span>\n            <h3 class=\"text-4xl font-bold mb-6\" data-kid=\"180\">Continuous DevOps</h3>\n            <div class=\"flex items-center gap-2 mb-8\" data-kid=\"181\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" data-kid=\"182\"></span>\n              <span class=\"text-xs font-mono text-emerald-500 uppercase tracking-tighter\" data-kid=\"183\">Auto-deployment cluster active</span>\n            </div>\n            <p class=\"text-white/40 font-light leading-relaxed mb-8\" data-kid=\"184\">Zero-touch infrastructure. Automated Docker multi-stage builds, Kubernetes manifest generation, and GitHub Action workflows for every project.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-8 relative overflow-hidden\" data-kid=\"185\">\n    <div class=\"absolute inset-0 bg-gradient-to-t from-cyan-500/10 to-transparent\" data-kid=\"186\"></div>\n    <div class=\"max-w-4xl mx-auto text-center relative z-10\" data-kid=\"187\">\n      <h2 class=\"text-6xl lg:text-8xl font-black tracking-tighter mb-12 uppercase leading-[0.8]\" data-kid=\"188\">The Future is<br data-kid=\"189\"><span class=\"text-gradient\" data-kid=\"190\">Agentic.</span></h2>\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"191\">\n         <button class=\"px-12 py-5 rounded-full bg-white text-black font-black uppercase tracking-widest text-sm hover:scale-105 active:scale-95 transition-all shadow-[0_0_50px_rgba(255,255,255,0.3)]\" data-kid=\"192\">Get Started Now</button>\n         <button class=\"px-12 py-5 rounded-full glass border-white/10 font-bold uppercase tracking-widest text-sm hover:bg-white/5 transition-all\" data-kid=\"193\">View Showcase</button>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-8 border-t border-white/5 bg-black/60 relative\" data-kid=\"194\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-20\" data-kid=\"195\">\n      <div class=\"max-w-xs\" data-kid=\"196\">\n        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"197\">\n          <div class=\"w-6 h-6 glass rounded-md flex items-center justify-center border-white/10\" data-kid=\"198\">\n            <i class=\"ti ti-sparkles text-cyan-400 text-sm\" data-kid=\"199\"></i>\n          </div>\n          <span class=\"text-sm font-bold tracking-tighter uppercase\" data-kid=\"200\">SwarmDev</span>\n        </div>\n        <p class=\"text-xs text-white/30 font-medium leading-relaxed uppercase tracking-widest\" data-kid=\"201\">A production-level multi-agent cloud development platform. Built for the era of agentic software.</p>\n      </div>\n\n      <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-16\" data-kid=\"202\">\n        <div class=\"space-y-6\" data-kid=\"203\">\n          <h4 class=\"text-[10px] font-black uppercase tracking-[0.3em] text-white/20\" data-kid=\"204\">System</h4>\n          <ul class=\"text-xs font-bold space-y-4 uppercase tracking-wider text-white/60\" data-kid=\"205\">\n            <li data-kid=\"206\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"207\">Architecture</a></li>\n            <li data-kid=\"208\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"209\">Agents</a></li>\n            <li data-kid=\"210\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"211\">Sandbox</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"212\">\n          <h4 class=\"text-[10px] font-black uppercase tracking-[0.3em] text-white/20\" data-kid=\"213\">Product</h4>\n          <ul class=\"text-xs font-bold space-y-4 uppercase tracking-wider text-white/60\" data-kid=\"214\">\n            <li data-kid=\"215\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"216\">Pricing</a></li>\n            <li data-kid=\"217\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"218\">Showcase</a></li>\n            <li data-kid=\"219\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"220\">Enterprise</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"221\">\n          <h4 class=\"text-[10px] font-black uppercase tracking-[0.3em] text-white/20\" data-kid=\"222\">Resources</h4>\n          <ul class=\"text-xs font-bold space-y-4 uppercase tracking-wider text-white/60\" data-kid=\"223\">\n            <li data-kid=\"224\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"225\">Docs</a></li>\n            <li data-kid=\"226\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"227\">API</a></li>\n            <li data-kid=\"228\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"229\">Prompts</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"230\">\n          <h4 class=\"text-[10px] font-black uppercase tracking-[0.3em] text-white/20\" data-kid=\"231\">Company</h4>\n          <ul class=\"text-xs font-bold space-y-4 uppercase tracking-wider text-white/60\" data-kid=\"232\">\n            <li data-kid=\"233\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"234\">Manifesto</a></li>\n            <li data-kid=\"235\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"236\">Privacy</a></li>\n            <li data-kid=\"237\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"238\">Contact</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto mt-20 pt-12 border-t border-white/5 flex justify-between items-center text-[10px] font-bold text-white/10 uppercase tracking-widest\" data-kid=\"239\">\n      <div data-kid=\"240\">&copy; 2026 SwarmDev Inc.</div>\n      <div class=\"flex gap-8\" data-kid=\"241\">\n        <a href=\"#\" data-kid=\"242\">Github</a>\n        <a href=\"#\" data-kid=\"243\">X / Twitter</a>\n        <a href=\"#\" data-kid=\"244\">Discord</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"245\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"246\"></script>\n<script data-kid=\"247\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Animations\n  const tl = gsap.timeline();\n  tl.from(\"h1\", { y: 40, opacity: 0, duration: 1, ease: \"power4.out\" })\n    .from(\"p\", { y: 20, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=0.7\")\n    .from(\".skew-hero\", { x: 100, opacity: 0, duration: 1.5, ease: \"power4.out\" }, \"-=1\")\n    .from(\".glass\", { scale: 0.95, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=1\");\n\n  // Scroll Animations for Capability Matrix\n  gsap.from(\"#capability-matrix > div\", {\n    scrollTrigger: {\n      trigger: \"#capability-matrix\",\n      start: \"top 80%\",\n    },\n    y: 60,\n    opacity: 0,\n    stagger: 0.15,\n    duration: 1,\n    ease: \"power4.out\"\n  });\n\n  // Parallax for orbs\n  gsap.to(\".glow-orb\", {\n    y: (i, target) => i === 0 ? 200 : -200,\n    scrollTrigger: {\n      trigger: \"body\",\n      start: \"top top\",\n      end: \"bottom bottom\",\n      scrub: 1\n    }\n  });\n\n</script>",
