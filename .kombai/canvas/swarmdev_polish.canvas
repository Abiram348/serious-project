      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');\n\n  :root {\n    --terminal-green: #00FF41;\n    --glitch-red: #FF003C;\n    --hacker-cyan: #00E5FF;\n    --bg-black: #000000;\n  }\n\n  body {\n    background-color: var(--bg-black);\n    color: #e0e0e0;\n    font-family: 'JetBrains Mono', monospace;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  /* Glitch Text Effect */\n  .glitch {\n    position: relative;\n    display: inline-block;\n  }\n\n  .glitch::before, .glitch::after {\n    content: attr(data-text);\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: var(--bg-black);\n  }\n\n  .glitch::before {\n    left: 2px;\n    text-shadow: -2px 0 var(--glitch-red);\n    clip: rect(44px, 450px, 56px, 0);\n    animation: glitch-anim 5s infinite linear alternate-reverse;\n  }\n\n  .glitch::after {\n    left: -2px;\n    text-shadow: -2px 0 var(--hacker-cyan);\n    clip: rect(44px, 450px, 56px, 0);\n    animation: glitch-anim2 5s infinite linear alternate-reverse;\n  }\n\n  @keyframes glitch-anim {\n    0% { clip: rect(31px, 9999px, 94px, 0); }\n    20% { clip: rect(62px, 9999px, 42px, 0); }\n    40% { clip: rect(16px, 9999px, 78px, 0); }\n    60% { clip: rect(84px, 9999px, 8px, 0); }\n    80% { clip: rect(53px, 9999px, 63px, 0); }\n    100% { clip: rect(91px, 9999px, 20px, 0); }\n  }\n\n  @keyframes glitch-anim2 {\n    0% { clip: rect(65px, 9999px, 100px, 0); }\n    20% { clip: rect(43px, 9999px, 13px, 0); }\n    40% { clip: rect(9px, 9999px, 87px, 0); }\n    60% { clip: rect(58px, 9999px, 35px, 0); }\n    80% { clip: rect(74px, 9999px, 55px, 0); }\n    100% { clip: rect(22px, 9999px, 84px, 0); }\n  }\n\n  /* CRT Scanline Effect */\n  .crt-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));\n    background-size: 100% 3px, 3px 100%;\n    z-index: 999;\n    pointer-events: none;\n    opacity: 0.3;\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 998;\n    background: linear-gradient(0deg, rgba(0, 0, 0, 0) 0%, rgba(0, 255, 65, 0.05) 50%, rgba(0, 0, 0, 0) 100%);\n    opacity: 0.1;\n    position: fixed;\n    pointer-events: none;\n    animation: scanline 10s linear infinite;\n  }\n\n  @keyframes scanline {\n    0% { top: -100px; }\n    100% { top: 100%; }\n  }\n\n  /* Rugged Panel Layouts */\n  .rugged-panel {\n    background: #0a0a0a;\n    border: 1px dashed var(--hacker-cyan);\n    clip-path: polygon(0 0, 95% 0, 100% 15%, 100% 100%, 5% 100%, 0 85%);\n    transition: all 0.3s ease;\n  }\n\n  .rugged-panel:hover {\n    border-style: solid;\n    box-shadow: 0 0 15px rgba(0, 229, 255, 0.2);\n    transform: scale(1.02);\n  }\n\n  /* Matrix Rain Background */\n  .matrix-video {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.15;\n    mix-blend-mode: screen;\n  }\n\n  .cursor {\n    display: inline-block;\n    width: 10px;\n    height: 1.2em;\n    background: var(--terminal-green);\n    margin-left: 5px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    from, to { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .text-terminal { color: var(--terminal-green); }\n  .text-glitch { color: var(--glitch-red); }\n  .text-hacker { color: var(--hacker-cyan); }\n\n  .btn-hacker {\n    background: transparent;\n    border: 1px solid var(--terminal-green);\n    color: var(--terminal-green);\n    padding: 10px 20px;\n    text-transform: uppercase;\n    font-weight: 800;\n    position: relative;\n    overflow: hidden;\n    transition: all 0.2s;\n  }\n\n  .btn-hacker:hover {\n    background: var(--terminal-green);\n    color: black;\n    box-shadow: 0 0 20px var(--terminal-green);\n  }\n\n  .btn-hacker::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 100%;\n    height: 100%;\n    background: rgba(255, 255, 255, 0.2);\n    transform: skewX(-25deg);\n    transition: 0.5s;\n  }\n\n  .btn-hacker:hover::before {\n    left: 150%;\n  }\n\n  .server-rack {\n    background: #080808;\n    border-left: 4px solid #1a1a1a;\n    border-right: 4px solid #1a1a1a;\n    position: relative;\n  }\n\n  .rack-handle {\n    height: 10px;\n    background: #1a1a1a;\n    margin: 10px 0;\n    border-radius: 5px;\n  }\n\n  .status-light {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    display: inline-block;\n    margin-right: 10px;\n  }\n\n  .light-online { background: var(--terminal-green); box-shadow: 0 0 5px var(--terminal-green); }\n  .light-idle { background: #333; }\n\n</style>\n\n<div class=\"crt-overlay\" data-kid=\"1\"></div>\n<div class=\"scanline\" data-kid=\"2\"></div>\n\n<div class=\"relative min-h-screen bg-black\" data-kid=\"3\">\n  \n  \n  <nav class=\"fixed top-0 w-full z-[100] border-b border-terminal-green/20 bg-black/80 backdrop-blur-md\" data-kid=\"4\">\n    <div class=\"max-w-7xl mx-auto px-6 py-4 flex justify-between items-center\" data-kid=\"5\">\n      <div class=\"flex items-center gap-2\" data-kid=\"6\">\n        <span class=\"text-terminal text-xl font-bold\" data-kid=\"7\">[SWARM_DEV]</span>\n      </div>\n      <div class=\"hidden md:flex gap-8 text-xs font-bold tracking-widest uppercase\" data-kid=\"8\">\n        <a href=\"#sys_modules\" class=\"hover:text-terminal transition-colors cursor-pointer\" data-kid=\"9\">SYS_MODULES</a>\n        <a href=\"#exec_trace\" class=\"hover:text-terminal transition-colors cursor-pointer\" data-kid=\"10\">EXEC_TRACE</a>\n        <a href=\"#resource_alloc\" class=\"hover:text-terminal transition-colors cursor-pointer\" data-kid=\"11\">RESOURCE_ALLOC</a>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"12\">\n        <button class=\"text-xs font-bold hover:text-terminal transition-colors underline decoration-terminal-green/30 uppercase cursor-pointer\" data-kid=\"13\">LOGIN</button>\n        <button class=\"btn-hacker text-xs cursor-pointer\" data-kid=\"14\">INITIALIZE</button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col items-center justify-center pt-20 overflow-hidden\" data-kid=\"15\">\n    <video class=\"matrix-video\" autoplay muted loop playsinline poster=\"https://images.pexels.com/videos/33503700/pexels-photo-33503700.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" data-kid=\"16\">\n      <source src=\"https://videos.pexels.com/video-files/33503700/14250432_640_360_30fps.mp4\" type=\"video/mp4\" data-kid=\"17\">\n    </video>\n    \n    <div class=\"relative z-10 text-center px-6\" data-kid=\"18\">\n      <div class=\"mb-4 text-terminal font-mono text-sm opacity-60\" data-kid=\"19\">\n        > system.boot_sequence(alpha_swarm)\n      </div>\n      <h1 class=\"text-4xl md:text-7xl font-extrabold uppercase tracking-tighter mb-6 glitch\" id=\"typed-headline\" data-text=\"INITIALIZING_SWARM_DEV...\" data-kid=\"20\"></h1>\n      <p class=\"text-lg md:text-xl text-zinc-500 max-w-2xl mx-auto mb-10 leading-relaxed uppercase\" data-kid=\"21\">\n        Multi-agent autonomous development protocols active. <br data-kid=\"22\">\n        Parallelizing production deployment cycles.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row gap-4 justify-center\" data-kid=\"23\">\n        <button class=\"btn-hacker text-lg px-12 py-4 cursor-pointer\" data-kid=\"24\">RUN_SWARM_INSTANTIATION</button>\n        <button class=\"px-10 py-4 border border-zinc-800 text-zinc-400 font-bold hover:border-terminal-green transition-all uppercase text-sm cursor-pointer\" data-kid=\"25\">\n          VIEW_KERNEL_LOGS\n        </button>\n      </div>\n    </div>\n    \n    <div class=\"absolute bottom-10 left-1/2 -translate-x-1/2 text-terminal/30 text-[10px] animate-pulse\" data-kid=\"26\">\n      [ SCROLL_TO_DESCEND ]\n    </div>\n  </section>\n\n  \n  <section id=\"sys_modules\" class=\"py-32 px-6 max-w-7xl mx-auto\" data-kid=\"27\">\n    <div class=\"mb-20\" data-kid=\"28\">\n      <div class=\"text-xs text-terminal mb-2\" data-kid=\"29\">/ROOT/SYS_MODULES</div>\n      <h2 class=\"text-4xl font-bold uppercase glitch\" data-text=\"CORE_CAPABILITIES\" data-kid=\"30\">CORE_CAPABILITIES</h2>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"31\">\n      \n      <div class=\"rugged-panel p-8 group\" data-kid=\"32\">\n        <div class=\"text-terminal text-2xl font-bold mb-4\" data-kid=\"33\">[///]</div>\n        <h3 class=\"text-xl font-bold uppercase mb-4 text-terminal\" data-kid=\"34\">PARALLEL_SWARMING</h3>\n        <p class=\"text-zinc-500 text-sm leading-relaxed mb-6 uppercase\" data-kid=\"35\">\n          Orchestrate 9 concurrent AI agents to bypass linear bottleneck logic. Frontend, Backend, and DB scale simultaneously.\n        </p>\n        <div class=\"text-[10px] text-zinc-700 font-mono\" data-kid=\"36\">\n          STATUS: OPTIMIZED<br data-kid=\"37\">\n          ALLOC: 256GB_VRAM\n        </div>\n      </div>\n\n      \n      <div class=\"rugged-panel p-8 group border-glitch-red/50\" data-kid=\"38\">\n        <div class=\"text-glitch text-2xl font-bold mb-4\" data-kid=\"39\">[**]</div>\n        <h3 class=\"text-xl font-bold uppercase mb-4 text-glitch\" data-kid=\"40\">SEC_AUDIT_PROTOCOL</h3>\n        <p class=\"text-zinc-500 text-sm leading-relaxed mb-6 uppercase\" data-kid=\"41\">\n          Autonomous security layer scanning for XSS, SQLi, and secret leak patterns before build injection.\n        </p>\n        <div class=\"text-[10px] text-zinc-700 font-mono\" data-kid=\"42\">\n          SCAN_DEPTH: DEPTH_7<br data-kid=\"43\">\n          VULNERABILITY_THRESHOLD: 0\n        </div>\n      </div>\n\n      \n      <div class=\"rugged-panel p-8 group border-hacker-cyan/50\" data-kid=\"44\">\n        <div class=\"text-hacker text-2xl font-bold mb-4\" data-kid=\"45\">[###]</div>\n        <h3 class=\"text-xl font-bold uppercase mb-4 text-hacker\" data-kid=\"46\">SANDBOX_RUNTIME</h3>\n        <p class=\"text-zinc-500 text-sm leading-relaxed mb-6 uppercase\" data-kid=\"47\">\n          E2B isolated cloud compute containers. Full shell access. 0 local config requirements.\n        </p>\n        <div class=\"text-[10px] text-zinc-700 font-mono\" data-kid=\"48\">\n          NODE: V20.12.2<br data-kid=\"49\">\n          PORT: LISTENING_3000\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"exec_trace\" class=\"py-32 bg-zinc-950/50\" data-kid=\"50\">\n    <div class=\"max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start\" data-kid=\"51\">\n      <div data-kid=\"52\">\n        <div class=\"text-xs text-terminal mb-2\" data-kid=\"53\">/ROOT/EXEC_TRACE</div>\n        <h2 class=\"text-4xl font-bold uppercase mb-8\" data-kid=\"54\">WORKFLOW_SEQUENCE</h2>\n        <p class=\"text-zinc-500 uppercase text-sm leading-relaxed max-w-md\" data-kid=\"55\">\n          Watch the swarm evolve in real-time. Our agents communicate over a secure Redis pub/sub layer, delivering high-fidelity logs to your terminal.\n        </p>\n      </div>\n\n      <div class=\"bg-black border border-zinc-800 p-6 rounded-lg font-mono text-[11px] h-[400px] overflow-hidden relative shadow-2xl shadow-terminal-green/5\" id=\"log-container\" data-kid=\"56\">\n        <div id=\"log-entries\" class=\"space-y-2\" data-kid=\"57\">\n          \n        </div>\n        <div class=\"absolute bottom-6 left-6 text-terminal flex items-center\" data-kid=\"58\">\n          > SYSTEM_IDLE <span class=\"cursor\" data-kid=\"59\"></span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"resource_alloc\" class=\"py-32 px-6 max-w-7xl mx-auto\" data-kid=\"60\">\n    <div class=\"text-center mb-24\" data-kid=\"61\">\n       <h2 class=\"text-5xl font-bold uppercase glitch\" data-text=\"RESOURCE_ALLOCATION\" data-kid=\"62\">RESOURCE_ALLOCATION</h2>\n       <div class=\"w-24 h-1 bg-terminal-green mx-auto mt-4\" data-kid=\"63\"></div>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\" data-kid=\"64\">\n      \n      <div class=\"server-rack p-8 transition-colors hover:border-terminal-green/30 group\" data-kid=\"65\">\n        <div class=\"rack-handle\" data-kid=\"66\"></div>\n        <div class=\"flex justify-between items-start mb-10 uppercase\" data-kid=\"67\">\n          <div data-kid=\"68\">\n            <div class=\"text-[10px] text-zinc-600 font-bold mb-1\" data-kid=\"69\">UNIT_01</div>\n            <div class=\"text-2xl font-black text-terminal\" data-kid=\"70\">STARTER</div>\n          </div>\n          <div class=\"text-right\" data-kid=\"71\">\n            <div class=\"text-3xl font-bold price-value\" data-price=\"0\" data-kid=\"72\">$0</div>\n            <div class=\"text-[10px] text-zinc-600\" data-kid=\"73\">/CYCLE</div>\n          </div>\n        </div>\n        <ul class=\"space-y-4 text-xs text-zinc-500 uppercase font-bold mb-12\" data-kid=\"74\">\n          <li data-kid=\"75\"><span class=\"status-light light-online\" data-kid=\"76\"></span>3_ACTIVE_NODES</li>\n          <li data-kid=\"77\"><span class=\"status-light light-online\" data-kid=\"78\"></span>SUP_MOD_ACTIVE</li>\n          <li data-kid=\"79\"><span class=\"status-light light-idle\" data-kid=\"80\"></span>100K_TOKENS</li>\n          <li class=\"opacity-30\" data-kid=\"81\"><span class=\"status-light light-idle\" data-kid=\"82\"></span>G_SYNC_DISABLED</li>\n        </ul>\n        <button class=\"w-full py-4 border border-zinc-800 hover:border-terminal-green transition-all text-xs font-bold tracking-widest cursor-pointer\" data-kid=\"83\">CONNECT_FREE</button>\n        <div class=\"rack-handle mt-10\" data-kid=\"84\"></div>\n      </div>\n\n      \n      <div class=\"server-rack p-8 border-terminal-green/50 bg-terminal-green/5 group relative overflow-hidden\" data-kid=\"85\">\n        <div class=\"absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_center,rgba(0,255,65,0.05),transparent)] pointer-events-none\" data-kid=\"86\"></div>\n        <div class=\"rack-handle bg-terminal-green/30\" data-kid=\"87\"></div>\n        <div class=\"flex justify-between items-start mb-10 uppercase\" data-kid=\"88\">\n          <div data-kid=\"89\">\n            <div class=\"text-[10px] text-terminal font-bold mb-1\" data-kid=\"90\">UNIT_02_RECOMMENDED</div>\n            <div class=\"text-2xl font-black text-terminal\" data-kid=\"91\">PRO_SWARM</div>\n          </div>\n          <div class=\"text-right\" data-kid=\"92\">\n            <div class=\"text-3xl font-bold price-value\" data-price=\"29\" data-kid=\"93\">$29</div>\n            <div class=\"text-[10px] text-terminal/60\" data-kid=\"94\">/CYCLE</div>\n          </div>\n        </div>\n        <ul class=\"space-y-4 text-xs text-terminal/80 uppercase font-bold mb-12\" data-kid=\"95\">\n          <li data-kid=\"96\"><span class=\"status-light light-online\" data-kid=\"97\"></span>UNLTD_ACTIVE_NODES</li>\n          <li data-kid=\"98\"><span class=\"status-light light-online\" data-kid=\"99\"></span>FULL_SWARM_MODULES</li>\n          <li data-kid=\"100\"><span class=\"status-light light-online\" data-kid=\"101\"></span>2M_TOKENS</li>\n          <li data-kid=\"102\"><span class=\"status-light light-online\" data-kid=\"103\"></span>G_SYNC_ENABLED</li>\n        </ul>\n        <button class=\"w-full py-4 bg-terminal-green text-black font-black text-xs tracking-widest hover:brightness-110 cursor-pointer\" data-kid=\"104\">UPGRADE_PROTOCOL</button>\n        <div class=\"rack-handle bg-terminal-green/30 mt-10\" data-kid=\"105\"></div>\n      </div>\n\n      \n      <div class=\"server-rack p-8 transition-colors hover:border-terminal-green/30 group\" data-kid=\"106\">\n        <div class=\"rack-handle\" data-kid=\"107\"></div>\n        <div class=\"flex justify-between items-start mb-10 uppercase\" data-kid=\"108\">\n          <div data-kid=\"109\">\n            <div class=\"text-[10px] text-zinc-600 font-bold mb-1\" data-kid=\"110\">UNIT_03</div>\n            <div class=\"text-2xl font-black text-zinc-300\" data-kid=\"111\">ENTERPRISE</div>\n          </div>\n          <div class=\"text-right\" data-kid=\"112\">\n            <div class=\"text-3xl font-bold price-value\" data-price=\"99\" data-kid=\"113\">$99</div>\n            <div class=\"text-[10px] text-zinc-600\" data-kid=\"114\">/CYCLE</div>\n          </div>\n        </div>\n        <ul class=\"space-y-4 text-xs text-zinc-500 uppercase font-bold mb-12\" data-kid=\"115\">\n          <li data-kid=\"116\"><span class=\"status-light light-online\" data-kid=\"117\"></span>TEAM_COLLAB_NODES</li>\n          <li data-kid=\"118\"><span class=\"status-light light-online\" data-kid=\"119\"></span>BYOK_INTEGRATION</li>\n          <li data-kid=\"120\"><span class=\"status-light light-online\" data-kid=\"121\"></span>10M_TOKENS</li>\n          <li data-kid=\"122\"><span class=\"status-light light-online\" data-kid=\"123\"></span>24/7_KERN_SUPPORT</li>\n        </ul>\n        <button class=\"w-full py-4 border border-zinc-800 hover:border-terminal-green transition-all text-xs font-bold tracking-widest cursor-pointer\" data-kid=\"124\">REQUEST_SPEC</button>\n        <div class=\"rack-handle mt-10\" data-kid=\"125\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 border-t border-zinc-900 px-6\" data-kid=\"126\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-10\" data-kid=\"127\">\n      <div class=\"text-terminal font-bold text-2xl uppercase tracking-tighter\" data-kid=\"128\">\n        [SWARM_DEV]\n      </div>\n      <div class=\"flex gap-12 text-[10px] font-bold text-zinc-600 uppercase tracking-widest\" data-kid=\"129\">\n        <a href=\"#\" class=\"hover:text-terminal transition-colors\" data-kid=\"130\">GITHUB</a>\n        <a href=\"#\" class=\"hover:text-terminal transition-colors\" data-kid=\"131\">DOCS</a>\n        <a href=\"#\" class=\"hover:text-terminal transition-colors\" data-kid=\"132\">PRIVACY</a>\n        <a href=\"#\" class=\"hover:text-terminal transition-colors\" data-kid=\"133\">TERMS</a>\n      </div>\n      <div class=\"text-[10px] text-zinc-800 font-mono\" data-kid=\"134\">\n        © 2026 SWARM_DEV_INTERNAL_SYS. ALL_RIGHTS_RESERVED.\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"135\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"136\"></script>\n\n<script data-kid=\"137\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Typewriter Hero Effect\n  const headline = document.getElementById('typed-headline');\n  const text = \"INITIALIZING_SWARM_DEV...\";\n  let i = 0;\n\n  function typeWriter() {\n    if (i < text.length) {\n      headline.innerHTML += text.charAt(i);\n      i++;\n      setTimeout(typeWriter, 100);\n    }\n  }\n  \n  window.addEventListener('load', () => {\n    headline.innerHTML = \"\";\n    typeWriter();\n  });\n\n  // Log Trace Execution\n  const logs = [\n    \"[14:02:01.442] BOOT: SYSCALL_READY\",\n    \"[14:02:01.558] KERN: AGENT_01_CONNECTED(SUPERVISOR)\",\n    \"[14:02:02.110] TASK: PARSING_USER_PROMPT...\",\n    \"[14:02:02.890] SWARM: FAN_OUT_NODES(DB, BACK, DEV)\",\n    \"[14:02:03.401] PRISMA: GENERATING_SCHEMA_V1\",\n    \"[14:02:03.922] EXPRESS: BUILDING_AUTH_MIDDLEWARE\",\n    \"[14:02:04.103] CLERK: JWT_VALIDATION_ACTIVE\",\n    \"[14:02:05.556] SECURITY: AUDIT_STARTING...\",\n    \"[14:02:06.112] SECURITY: 0_VULNERABILITIES_FOUND\",\n    \"[14:02:07.889] DEPLOY: SYNCING_TO_R2\",\n    \"[14:02:08.221] SYSTEM: SUCCESS_FULL_STACK_ACTIVE\"\n  ];\n\n  const logContainer = document.getElementById('log-entries');\n  \n  ScrollTrigger.create({\n    trigger: \"#exec_trace\",\n    start: \"top 60%\",\n    onEnter: () => {\n      logContainer.innerHTML = \"\";\n      logs.forEach((log, index) => {\n        setTimeout(() => {\n          const div = document.createElement('div');\n          div.className = \"flex gap-4 animate-pulse\";\n          div.innerHTML = `<span class=\"text-zinc-700\">${log.split(' ')[0]}</span> <span class=\"text-terminal\">${log.split(' ')[1]}</span>`;\n          logContainer.appendChild(div);\n          logContainer.scrollTop = logContainer.scrollHeight;\n        }, index * 200);\n      });\n    }\n  });\n\n  // Price Glitch Hover\n  document.querySelectorAll('.price-value').forEach(el => {\n    const originalPrice = el.innerHTML;\n    const target = el.getAttribute('data-price');\n    \n    el.parentElement.parentElement.addEventListener('mouseenter', () => {\n      let count = 0;\n      const interval = setInterval(() => {\n        el.innerHTML = \"$\" + Math.floor(Math.random() * 99);\n        count++;\n        if (count > 10) {\n          clearInterval(interval);\n          el.innerHTML = \"$\" + target;\n        }\n      }, 50);\n    });\n\n    el.parentElement.parentElement.addEventListener('mouseleave', () => {\n      el.innerHTML = \"$\" + target;\n    });\n  });\n\n</script>",
