      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary-cyan: hsl(190, 100%, 50%);\n    --primary-purple: hsl(260, 80%, 60%);\n    --primary-orange: #FF5C00;\n    --bg-dark: hsl(240, 10%, 3.9%);\n    --surface-dark: hsl(240, 10%, 10%);\n    --border-glass: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: var(--bg-dark);\n    color: #F8FAFC;\n    overflow-x: hidden;\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border-glass);\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .bento-orange { background: var(--primary-orange); color: #000; }\n  .bento-purple { background: var(--primary-purple); color: #fff; }\n  .bento-black { background: var(--surface-dark); color: #fff; }\n\n  .hero-mockup-container {\n    perspective: 2000px;\n  }\n\n  .mockup-window {\n    transform: rotateX(10deg) rotateY(-10deg) rotateZ(-2deg) translateY(100px);\n    box-shadow: 0 50px 100px -20px rgba(0,0,0,0.5);\n  }\n\n  .pill-input {\n    background: rgba(255, 255, 255, 0.05);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    box-shadow: 0 0 40px rgba(0,0,0,0.3);\n  }\n\n  .glow-cyan {\n    box-shadow: 0 0 30px -5px var(--primary-cyan);\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  .agent-pill {\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    transition: all 0.3s ease;\n  }\n\n  .agent-pill:hover {\n    background: rgba(255, 255, 255, 0.08);\n    border-color: var(--primary-cyan);\n    transform: scale(1.05);\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full px-8 py-6 flex justify-between items-center bg-transparent backdrop-blur-sm\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-sparkles text-white\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-lg font-bold tracking-tight\" data-kid=\"6\">SwarmDev</span>\n    </div>\n    <div class=\"flex items-center gap-8 text-sm font-medium text-zinc-400\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-white\" data-kid=\"8\">Features</a>\n      <a href=\"#\" class=\"hover:text-white\" data-kid=\"9\">Pricing</a>\n      <a href=\"#\" class=\"hover:text-white\" data-kid=\"10\">Docs</a>\n      <button class=\"px-5 py-2 rounded-full bg-white text-black font-bold hover:bg-zinc-200 transition-all\" data-kid=\"11\">Sign Up</button>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-48 pb-32 flex flex-col items-center overflow-hidden\" data-kid=\"12\">\n    \n    <div class=\"absolute inset-0 z-0 flex items-center justify-center pointer-events-none opacity-40\" data-kid=\"13\">\n      <div class=\"relative w-full max-w-6xl hero-mockup-container\" data-kid=\"14\">\n        \n        <div class=\"absolute top-0 left-1/4 w-[800px] aspect-video bg-zinc-900 rounded-2xl border border-white/10 mockup-window overflow-hidden\" data-kid=\"15\">\n          <div class=\"h-8 bg-zinc-800 border-b border-white/5 flex items-center px-4 gap-1.5\" data-kid=\"16\">\n            <div class=\"w-2 h-2 rounded-full bg-red-500/50\" data-kid=\"17\"></div>\n            <div class=\"w-2 h-2 rounded-full bg-yellow-500/50\" data-kid=\"18\"></div>\n            <div class=\"w-2 h-2 rounded-full bg-green-500/50\" data-kid=\"19\"></div>\n          </div>\n          <video src=\"https://videos.pexels.com/video-files/30162924/12934302_640_360_30fps.mp4\" autoplay muted loop playsinline class=\"w-full h-full object-cover\" data-kid=\"20\"></video>\n        </div>\n        \n        <div class=\"absolute top-20 right-1/4 w-[600px] aspect-video bg-black rounded-xl border border-white/10 mockup-window overflow-hidden\" style=\"transform: rotateX(15deg) rotateY(15deg) rotateZ(2deg) translate(100px, 150px);\" data-kid=\"21\">\n          <div class=\"h-8 bg-zinc-900 border-b border-white/5 flex items-center px-4 gap-1.5\" data-kid=\"22\">\n            <div class=\"w-2 h-2 rounded-full bg-white/20\" data-kid=\"23\"></div>\n            <div class=\"w-2 h-2 rounded-full bg-white/20\" data-kid=\"24\"></div>\n            <div class=\"w-2 h-2 rounded-full bg-white/20\" data-kid=\"25\"></div>\n          </div>\n          <div class=\"p-6 font-mono text-xs text-zinc-400 space-y-2\" data-kid=\"26\">\n            <div class=\"text-zinc-500\" data-kid=\"27\">> swarm build --production</div>\n            <div data-kid=\"28\">[STREAMS] Initializing 9 autonomous agents...</div>\n            <div class=\"text-cyan-400\" data-kid=\"29\">[AGENT] supervisor: planning architecture</div>\n            <div class=\"text-purple-400\" data-kid=\"30\">[AGENT] database: migrations applied</div>\n            <div class=\"text-orange-400\" data-kid=\"31\">[AGENT] security: audit protocol passed</div>\n            <div data-kid=\"32\">[SUCCESS] Deployment ready at swarmdev.io/preview-v2</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative z-10 w-full max-w-4xl px-8 flex flex-col items-center text-center\" data-kid=\"33\">\n      <h1 class=\"text-6xl md:text-8xl font-extrabold tracking-tight mb-12 text-gradient\" data-kid=\"34\">\n        What will you build?\n      </h1>\n      \n      <div class=\"w-full max-w-3xl pill-input rounded-[3rem] p-3 flex items-center gap-4 backdrop-blur-2xl\" data-kid=\"35\">\n        <div class=\"w-12 h-12 rounded-full bg-white/5 flex items-center justify-center shrink-0\" data-kid=\"36\">\n          <i class=\"ti ti-terminal text-2xl text-zinc-400\" data-kid=\"37\"></i>\n        </div>\n        <input type=\"text\" placeholder=\"Build a real-time multiplayer coding environment...\" class=\"bg-transparent border-none outline-none w-full text-xl md:text-2xl text-white placeholder:text-zinc-600 font-medium\" data-kid=\"38\">\n        <button class=\"px-8 py-4 rounded-full bg-cyan-500 text-black font-black text-lg hover:scale-105 transition-all glow-cyan shrink-0\" data-kid=\"39\">\n          Deploy\n        </button>\n      </div>\n      \n      <div class=\"mt-8 flex flex-wrap justify-center gap-3\" data-kid=\"40\">\n        <span class=\"text-sm font-medium text-zinc-500 uppercase tracking-widest mr-2 py-1.5\" data-kid=\"41\">Try:</span>\n        <button class=\"px-4 py-1.5 rounded-full glass-card text-sm font-semibold hover:border-white/20 transition-all\" data-kid=\"42\">SaaS Dashboard</button>\n        <button class=\"px-4 py-1.5 rounded-full glass-card text-sm font-semibold hover:border-white/20 transition-all\" data-kid=\"43\">Mobile Social App</button>\n        <button class=\"px-4 py-1.5 rounded-full glass-card text-sm font-semibold hover:border-white/20 transition-all\" data-kid=\"44\">Real-time Stock Monitor</button>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 px-8 max-w-7xl mx-auto\" data-kid=\"45\">\n    <div class=\"grid grid-cols-12 gap-6\" id=\"bento-grid\" data-kid=\"46\">\n      \n      <div class=\"col-span-12 md:col-span-7 h-[450px] bento-orange rounded-[3rem] p-16 flex flex-col justify-between group overflow-hidden relative\" data-kid=\"47\">\n        <div class=\"relative z-10\" data-kid=\"48\">\n          <span class=\"text-black/50 font-bold uppercase tracking-widest text-sm mb-4 block\" data-kid=\"49\">Platform Core</span>\n          <h2 class=\"text-5xl font-extrabold tracking-tighter leading-none mb-6\" data-kid=\"50\">Nine agents.<br data-kid=\"51\">Infinite speed.</h2>\n          <p class=\"text-black/70 text-xl font-medium max-w-md\" data-kid=\"52\">Our specialized swarm collaborates in parallel to build every layer of your stack simultaneously.</p>\n        </div>\n        <div class=\"absolute -bottom-10 -right-10 w-64 h-64 opacity-20 group-hover:scale-110 transition-transform\" data-kid=\"53\">\n           <i class=\"ti ti-cpu text-[256px]\" data-kid=\"54\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-5 h-[450px] bento-purple rounded-[3rem] p-16 flex flex-col justify-center items-center text-center\" data-kid=\"55\">\n        <div class=\"w-24 h-24 rounded-3xl bg-white/20 flex items-center justify-center mb-10 rotate-12\" data-kid=\"56\">\n          <i class=\"ti ti-rocket text-5xl text-white\" data-kid=\"57\"></i>\n        </div>\n        <h2 class=\"text-4xl font-extrabold tracking-tight mb-4\" data-kid=\"58\">Ship Anything.</h2>\n        <p class=\"text-white/80 font-medium\" data-kid=\"59\">From Next.js frontends to complex Prisma schemas.</p>\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-4 h-[400px] bento-black rounded-[3rem] p-12 flex flex-col justify-between border border-white/5\" data-kid=\"60\">\n        <i class=\"ti ti-shield-check text-4xl text-cyan-400\" data-kid=\"61\"></i>\n        <div data-kid=\"62\">\n          <h3 class=\"text-2xl font-bold mb-2\" data-kid=\"63\">Hardened Security</h3>\n          <p class=\"text-zinc-500\" data-kid=\"64\">Automated audits on every single commit by our security agents.</p>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-8 h-[400px] bento-black rounded-[3rem] p-12 flex items-center gap-12 overflow-hidden border border-white/5\" data-kid=\"65\">\n        <div class=\"flex-1\" data-kid=\"66\">\n          <i class=\"ti ti-database text-4xl text-orange-500 mb-6 block\" data-kid=\"67\"></i>\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"68\">Real-time Data Sync</h3>\n          <p class=\"text-zinc-500 text-lg\" data-kid=\"69\">Watch your database schema and API routes synchronize instantly across agents.</p>\n        </div>\n        <div class=\"w-1/2 aspect-square glass-card rounded-[2rem] flex items-center justify-center relative overflow-hidden\" data-kid=\"70\">\n           <div class=\"absolute inset-0 opacity-20 bg-grid-white/[0.05]\" data-kid=\"71\"></div>\n           <i class=\"ti ti-refresh text-8xl text-white/10 animate-spin-slow\" data-kid=\"72\"></i>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 overflow-hidden\" data-kid=\"73\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"74\">\n      <div class=\"flex items-end justify-between mb-16\" data-kid=\"75\">\n        <h2 class=\"text-5xl font-bold tracking-tight\" data-kid=\"76\">Meet the <span class=\"text-cyan-400\" data-kid=\"77\">Swarm</span></h2>\n        <p class=\"text-zinc-500 max-w-sm text-right\" data-kid=\"78\">Specialized intelligence optimized for production-grade engineering.</p>\n      </div>\n      \n      <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4\" data-kid=\"79\">\n        \n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"80\">\n          <div class=\"w-16 h-16 rounded-2xl bg-cyan-500/10 flex items-center justify-center border border-cyan-500/20\" data-kid=\"81\">\n            <i class=\"ti ti-robot text-3xl text-cyan-400\" data-kid=\"82\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"83\">Supervisor</span>\n        </div>\n        \n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"84\">\n          <div class=\"w-16 h-16 rounded-2xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20\" data-kid=\"85\">\n            <i class=\"ti ti-layout-2 text-3xl text-purple-400\" data-kid=\"86\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"87\">Frontend</span>\n        </div>\n        \n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"88\">\n          <div class=\"w-16 h-16 rounded-2xl bg-orange-500/10 flex items-center justify-center border border-orange-500/20\" data-kid=\"89\">\n            <i class=\"ti ti-server text-3xl text-orange-400\" data-kid=\"90\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"91\">Backend</span>\n        </div>\n        \n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"92\">\n          <div class=\"w-16 h-16 rounded-2xl bg-blue-500/10 flex items-center justify-center border border-blue-500/20\" data-kid=\"93\">\n            <i class=\"ti ti-database text-3xl text-blue-400\" data-kid=\"94\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"95\">Database</span>\n        </div>\n        \n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"96\">\n          <div class=\"w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20\" data-kid=\"97\">\n            <i class=\"ti ti-shield-lock text-3xl text-emerald-400\" data-kid=\"98\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"99\">Security</span>\n        </div>\n\n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"100\">\n          <div class=\"w-16 h-16 rounded-2xl bg-rose-500/10 flex items-center justify-center border border-rose-500/20\" data-kid=\"101\">\n            <i class=\"ti ti-bug text-3xl text-rose-400\" data-kid=\"102\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"103\">QA Agent</span>\n        </div>\n\n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"104\">\n          <div class=\"w-16 h-16 rounded-2xl bg-amber-500/10 flex items-center justify-center border border-amber-500/20\" data-kid=\"105\">\n            <i class=\"ti ti-cloud-upload text-3xl text-amber-400\" data-kid=\"106\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"107\">DevOps</span>\n        </div>\n\n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"108\">\n          <div class=\"w-16 h-16 rounded-2xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20\" data-kid=\"109\">\n            <i class=\"ti ti-file-description text-3xl text-indigo-400\" data-kid=\"110\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"111\">Docs</span>\n        </div>\n\n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center\" data-kid=\"112\">\n          <div class=\"w-16 h-16 rounded-2xl bg-pink-500/10 flex items-center justify-center border border-pink-500/20\" data-kid=\"113\">\n            <i class=\"ti ti-users text-3xl text-pink-400\" data-kid=\"114\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"115\">Reviewer</span>\n        </div>\n\n        <div class=\"agent-pill rounded-[2rem] p-6 flex flex-col items-center gap-4 text-center bg-white/10 border-white/20\" data-kid=\"116\">\n          <div class=\"w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center\" data-kid=\"117\">\n            <i class=\"ti ti-plus text-3xl text-white\" data-kid=\"118\"></i>\n          </div>\n          <span class=\"font-bold tracking-tight\" data-kid=\"119\">Custom</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-24 px-8 border-t border-white/5\" data-kid=\"120\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-16\" data-kid=\"121\">\n      <div class=\"max-w-sm\" data-kid=\"122\">\n        <div class=\"flex items-center gap-3 mb-6\" data-kid=\"123\">\n          <div class=\"w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center\" data-kid=\"124\">\n            <i class=\"ti ti-sparkles text-white\" data-kid=\"125\"></i>\n          </div>\n          <span class=\"text-2xl font-bold tracking-tighter uppercase\" data-kid=\"126\">SwarmDev</span>\n        </div>\n        <p class=\"text-zinc-500 leading-relaxed\" data-kid=\"127\">The high-fidelity multi-agent cloud development platform for production-grade engineering.</p>\n      </div>\n      \n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 text-sm\" data-kid=\"128\">\n        <div class=\"space-y-6\" data-kid=\"129\">\n          <h4 class=\"font-bold text-white uppercase tracking-widest text-[10px]\" data-kid=\"130\">Product</h4>\n          <ul class=\"space-y-4 text-zinc-500\" data-kid=\"131\">\n            <li data-kid=\"132\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"133\">Agents</a></li>\n            <li data-kid=\"134\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"135\">Sandboxes</a></li>\n            <li data-kid=\"136\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"137\">Pricing</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"138\">\n          <h4 class=\"font-bold text-white uppercase tracking-widest text-[10px]\" data-kid=\"139\">Devs</h4>\n          <ul class=\"space-y-4 text-zinc-500\" data-kid=\"140\">\n            <li data-kid=\"141\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"142\">Documentation</a></li>\n            <li data-kid=\"143\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"144\">API Reference</a></li>\n            <li data-kid=\"145\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"146\">CLI</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"147\">\n          <h4 class=\"font-bold text-white uppercase tracking-widest text-[10px]\" data-kid=\"148\">Company</h4>\n          <ul class=\"space-y-4 text-zinc-500\" data-kid=\"149\">\n            <li data-kid=\"150\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"151\">About</a></li>\n            <li data-kid=\"152\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"153\">Blog</a></li>\n            <li data-kid=\"154\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"155\">Changelog</a></li>\n          </ul>\n        </div>\n        <div class=\"space-y-6\" data-kid=\"156\">\n          <h4 class=\"font-bold text-white uppercase tracking-widest text-[10px]\" data-kid=\"157\">Social</h4>\n          <ul class=\"space-y-4 text-zinc-500\" data-kid=\"158\">\n            <li data-kid=\"159\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"160\">Twitter</a></li>\n            <li data-kid=\"161\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"162\">GitHub</a></li>\n            <li data-kid=\"163\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"164\">Discord</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-24 pt-12 border-t border-white/5 flex justify-between text-[10px] font-mono text-zinc-600 uppercase tracking-widest\" data-kid=\"165\">\n      <span data-kid=\"166\">&copy; 2026 SwarmDev Inc.</span>\n      <div class=\"flex gap-8\" data-kid=\"167\">\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"168\">Privacy</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"169\">Terms</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"170\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"171\"></script>\n<script data-kid=\"172\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Animations\n  const tl = gsap.timeline();\n  tl.from(\"nav\", { y: -20, opacity: 0, duration: 1, ease: \"power3.out\" })\n    .from(\"h1\", { y: 40, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=0.5\")\n    .from(\".pill-input\", { scale: 0.9, opacity: 0, duration: 1, ease: \"back.out(1.7)\" }, \"-=0.7\")\n    .from(\".hero-mockup-container\", { y: 100, opacity: 0, duration: 1.5, ease: \"power3.out\" }, \"-=1\");\n\n  // Bento Scroll\n  gsap.from(\"#bento-grid > div\", {\n    scrollTrigger: {\n      trigger: \"#bento-grid\",\n      start: \"top 80%\"\n    },\n    y: 60,\n    opacity: 0,\n    stagger: 0.1,\n    duration: 1,\n    ease: \"power4.out\"\n  });\n\n  // Agent Stagger\n  gsap.from(\".agent-pill\", {\n    scrollTrigger: {\n      trigger: \".agent-pill\",\n      start: \"top 90%\"\n    },\n    scale: 0.8,\n    opacity: 0,\n    stagger: 0.05,\n    duration: 0.6,\n    ease: \"back.out(1.7)\"\n  });\n</script>",
