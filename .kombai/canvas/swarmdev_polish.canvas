      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: 190 100% 50%;\n    --secondary: 260 80% 60%;\n    --background: 240 10% 3.9%;\n    --foreground: 0 0% 98%;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: hsl(var(--background));\n    color: hsl(var(--foreground));\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);\n  }\n\n  .glass-card {\n    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(255,255,255,0.1);\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .glass-card:hover {\n    border-color: hsla(190, 100%, 50%, 0.3);\n    background: rgba(255, 255, 255, 0.07);\n    transform: translateY(-4px);\n  }\n\n  .text-gradient {\n    background: linear-gradient(to right, hsl(190, 100%, 50%), hsl(260, 80% , 60%));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glow-cyan {\n    box-shadow: 0 0 20px -5px hsla(190, 100%, 50%, 0.4);\n  }\n\n  .glow-ring-cyan {\n    box-shadow: 0 0 0 1px hsla(190, 100%, 50%, 0.2), 0 0 20px -5px hsla(190, 100%, 50%, 0.4);\n  }\n\n  .bg-grid-hex {\n    background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='100' viewBox='0 0 60 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 15 L56 30 L56 60 L30 75 L4 60 L4 30 Z' fill='none' stroke='rgba(34, 211, 238, 0.05)' stroke-width='1'/%3E%3C/svg%3E\");\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 10;\n    background: linear-gradient(0deg, rgba(0, 0, 0, 0) 0%, rgba(34, 211, 238, 0.05) 50%, rgba(0, 0, 0, 0) 100%);\n    opacity: 0.1;\n    position: absolute;\n    pointer-events: none;\n    animation: scanline 8s linear infinite;\n  }\n\n  @keyframes scanline {\n    0% { top: -100px; }\n    100% { top: 100%; }\n  }\n\n  .hero-video-container {\n    mask-image: radial-gradient(circle at center, black 30%, transparent 80%);\n    -webkit-mask-image: radial-gradient(circle at center, black 30%, transparent 80%);\n  }\n\n  .card-breath {\n    animation: breath 4s ease-in-out infinite;\n  }\n\n  @keyframes breath {\n    0%, 100% { box-shadow: 0 0 20px -5px hsla(190, 100%, 50%, 0.2); }\n    50% { box-shadow: 0 0 30px 2px hsla(190, 100%, 50%, 0.4); }\n  }\n\n  .shimmer {\n    position: relative;\n    overflow: hidden;\n  }\n\n  .shimmer::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(45deg, transparent 45%, rgba(255, 255, 255, 0.1) 50%, transparent 55%);\n    animation: shimmer 4s infinite;\n  }\n\n  @keyframes shimmer {\n    0% { transform: translateX(-100%) translateY(-100%); }\n    100% { transform: translateX(100%) translateY(100%); }\n  }\n</style>\n\n<div class=\"relative min-h-screen bg-[#0a0a0c] selection:bg-cyan-500/30\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full glass border-b border-white/5 h-16\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-6 h-full flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-10 h-10 glass-card rounded-xl flex items-center justify-center border-cyan-500/20 group-hover:border-cyan-500/50 transition-all duration-500\" data-kid=\"5\">\n          <i class=\"ti ti-sparkles text-cyan-400 text-xl group-hover:scale-110 transition-transform\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tighter\" data-kid=\"7\">Swarm<span class=\"text-cyan-400\" data-kid=\"8\">Dev</span></span>\n      </div>\n      \n      <div class=\"hidden md:flex items-center gap-8\" data-kid=\"9\">\n        <a href=\"#features\" class=\"text-sm font-medium text-zinc-400 hover:text-cyan-400 transition-colors\" data-kid=\"10\">Features</a>\n        <a href=\"#workflow\" class=\"text-sm font-medium text-zinc-400 hover:text-cyan-400 transition-colors\" data-kid=\"11\">Workflow</a>\n        <a href=\"#pricing\" class=\"text-sm font-medium text-zinc-400 hover:text-cyan-400 transition-colors\" data-kid=\"12\">Pricing</a>\n        <a href=\"#\" class=\"text-sm font-medium text-zinc-400 hover:text-cyan-400 transition-colors\" data-kid=\"13\">Docs</a>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"14\">\n        <button class=\"text-sm font-medium text-zinc-400 hover:text-white transition-colors\" data-kid=\"15\">Sign in</button>\n        <button class=\"px-5 py-2 rounded-full bg-cyan-500 text-black text-sm font-bold glow-cyan hover:bg-cyan-400 transition-all\" data-kid=\"16\">\n          Get Started\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-32 pb-20 overflow-hidden flex flex-col items-center\" data-kid=\"17\">\n    \n    <div class=\"absolute inset-0 z-0\" data-kid=\"18\">\n      <div class=\"absolute inset-0 bg-grid-hex opacity-20 scale-150 rotate-12\" id=\"hero-grid\" data-kid=\"19\"></div>\n      <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full hero-video-container opacity-40\" data-kid=\"20\">\n        <video src=\"https://videos.pexels.com/video-files/34992913/14825276_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/34992913/pexels-photo-34992913.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"21\"></video>\n      </div>\n      <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-[#0a0a0c]/80 to-[#0a0a0c]\" data-kid=\"22\"></div>\n      <div class=\"scanline\" data-kid=\"23\"></div>\n    </div>\n\n    <div class=\"relative z-10 max-w-5xl px-6 text-center\" data-kid=\"24\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full glass border-cyan-500/30 text-xs font-bold text-cyan-400 mb-8 animate-pulse\" data-kid=\"25\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-cyan-400\" data-kid=\"26\"></span>\n        OLLAMA CLOUD CONNECTED\n      </div>\n      \n      <h1 class=\"text-6xl md:text-8xl font-bold tracking-tight mb-8 leading-[1.1]\" id=\"hero-title\" data-kid=\"27\">\n        Deploy a <span class=\"text-gradient\" data-kid=\"28\">Dev Swarm</span><br data-kid=\"29\">In Seconds\n      </h1>\n      \n      <p class=\"text-xl text-zinc-400 max-w-2xl mx-auto mb-12 leading-relaxed\" id=\"hero-desc\" data-kid=\"30\">\n        Parallelize your full-stack development with nine specialized AI agents. From database schema to security audits, built and deployed in one workflow.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 mb-16\" id=\"hero-ctas\" data-kid=\"31\">\n        <button class=\"group relative px-8 py-4 rounded-2xl bg-cyan-500 text-black font-bold text-lg overflow-hidden glow-cyan hover:scale-105 transition-all\" data-kid=\"32\">\n          <span class=\"relative z-10 flex items-center gap-2\" data-kid=\"33\">\n            Start Building Free <i class=\"ti ti-arrow-narrow-right text-xl transition-transform group-hover:translate-x-1\" data-kid=\"34\"></i>\n          </span>\n          <div class=\"absolute inset-0 bg-white/20 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700\" data-kid=\"35\"></div>\n        </button>\n        <button class=\"px-8 py-4 rounded-2xl glass border-white/10 font-bold text-lg text-white hover:bg-white/5 transition-all flex items-center gap-2\" data-kid=\"36\">\n          <i class=\"ti ti-terminal-2 text-xl text-cyan-400\" data-kid=\"37\"></i> View Architecture\n        </button>\n      </div>\n\n      \n      <div class=\"relative w-full h-[400px] mt-12 flex items-center justify-center\" id=\"agent-visualizer\" data-kid=\"38\">\n        \n        <svg class=\"absolute inset-0 w-full h-full pointer-events-none\" id=\"connections-svg\" data-kid=\"39\">\n          <defs data-kid=\"40\">\n            <linearGradient id=\"cyan-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"41\">\n              <stop offset=\"0%\" stop-color=\"rgba(34, 211, 238, 0)\" data-kid=\"42\"></stop>\n              <stop offset=\"50%\" stop-color=\"rgba(34, 211, 238, 0.4)\" data-kid=\"43\"></stop>\n              <stop offset=\"100%\" stop-color=\"rgba(34, 211, 238, 0)\" data-kid=\"44\"></stop>\n            </linearGradient>\n          </defs>\n        </svg>\n\n        \n        <div class=\"relative z-20 w-48 h-48 rounded-3xl glass border-cyan-500/40 flex flex-col items-center justify-center gap-3 glow-ring-cyan card-breath\" data-kid=\"45\">\n          <div class=\"w-16 h-16 rounded-2xl bg-cyan-500/10 flex items-center justify-center border border-cyan-500/30\" data-kid=\"46\">\n            <i class=\"ti ti-cpu text-cyan-400 text-3xl\" data-kid=\"47\"></i>\n          </div>\n          <div class=\"text-center\" data-kid=\"48\">\n            <div class=\"text-sm font-bold text-white tracking-widest uppercase\" data-kid=\"49\">Supervisor</div>\n            <div class=\"text-[10px] text-cyan-400/80 font-mono tracking-tighter\" data-kid=\"50\">CORE ENGINE</div>\n          </div>\n        </div>\n\n        \n        \n        <div class=\"absolute agent-node\" style=\"transform: translate(-300px, -100px);\" data-kid=\"51\">\n          <div class=\"w-36 h-28 rounded-2xl glass-card flex flex-col items-center justify-center gap-2\" data-kid=\"52\">\n            <i class=\"ti ti-layout-2 text-cyan-400 text-2xl\" data-kid=\"53\"></i>\n            <span class=\"text-xs font-bold tracking-wider\" data-kid=\"54\">FRONTEND</span>\n            <div class=\"flex gap-1\" data-kid=\"55\">\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"56\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500 opacity-30\" data-kid=\"57\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500 opacity-30\" data-kid=\"58\"></span>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute agent-node\" style=\"transform: translate(300px, -100px);\" data-kid=\"59\">\n          <div class=\"w-36 h-28 rounded-2xl glass-card flex flex-col items-center justify-center gap-2\" data-kid=\"60\">\n            <i class=\"ti ti-server text-cyan-400 text-2xl\" data-kid=\"61\"></i>\n            <span class=\"text-xs font-bold tracking-wider\" data-kid=\"62\">BACKEND</span>\n            <div class=\"flex gap-1\" data-kid=\"63\">\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"64\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"65\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500 opacity-30\" data-kid=\"66\"></span>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute agent-node\" style=\"transform: translate(-250px, 120px);\" data-kid=\"67\">\n          <div class=\"w-36 h-28 rounded-2xl glass-card flex flex-col items-center justify-center gap-2\" data-kid=\"68\">\n            <i class=\"ti ti-database text-cyan-400 text-2xl\" data-kid=\"69\"></i>\n            <span class=\"text-xs font-bold tracking-wider\" data-kid=\"70\">DATABASE</span>\n            <div class=\"flex gap-1\" data-kid=\"71\">\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"72\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500 opacity-30\" data-kid=\"73\"></span>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute agent-node\" style=\"transform: translate(250px, 120px);\" data-kid=\"74\">\n          <div class=\"w-36 h-28 rounded-2xl glass-card flex flex-col items-center justify-center gap-2\" data-kid=\"75\">\n            <i class=\"ti ti-shield-check text-cyan-400 text-2xl\" data-kid=\"76\"></i>\n            <span class=\"text-xs font-bold tracking-wider\" data-kid=\"77\">SECURITY</span>\n            <div class=\"flex gap-1\" data-kid=\"78\">\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"79\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"80\"></span>\n              <span class=\"w-1 h-1 rounded-full bg-cyan-500\" data-kid=\"81\"></span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-24 max-w-7xl mx-auto px-6\" data-kid=\"82\">\n    <div class=\"text-center mb-16\" data-kid=\"83\">\n      <h2 class=\"text-4xl font-bold mb-4\" data-kid=\"84\">Hyper-Specialized <span class=\"text-gradient\" data-kid=\"85\">Capabilities</span></h2>\n      <p class=\"text-zinc-400\" data-kid=\"86\">Nine agents. One goal. Perfect code every time.</p>\n    </div>\n\n    <div class=\"grid grid-cols-12 gap-6 h-[700px]\" data-kid=\"87\">\n      \n      <div class=\"col-span-12 md:col-span-7 glass-card rounded-3xl p-8 relative overflow-hidden group\" data-kid=\"88\">\n        <div class=\"relative z-10 h-full flex flex-col justify-between\" data-kid=\"89\">\n          <div data-kid=\"90\">\n            <div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center mb-6\" data-kid=\"91\">\n              <i class=\"ti ti-bolt text-cyan-400 text-2xl\" data-kid=\"92\"></i>\n            </div>\n            <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"93\">Parallel Agent Swarming</h3>\n            <p class=\"text-zinc-400 leading-relaxed max-w-sm\" data-kid=\"94\">\n              While other AIs work linearly, SwarmDev fests in parallel. Frontend, Backend, and Database agents coordinate in real-time to cut development time by 80%.\n            </p>\n          </div>\n          <div class=\"mt-8 flex gap-4\" data-kid=\"95\">\n             <div class=\"px-4 py-2 glass rounded-lg text-xs font-mono text-cyan-400\" data-kid=\"96\">worker-01: idle</div>\n             <div class=\"px-4 py-2 glass rounded-lg text-xs font-mono text-emerald-400\" data-kid=\"97\">worker-02: generating...</div>\n             <div class=\"px-4 py-2 glass rounded-lg text-xs font-mono text-cyan-400\" data-kid=\"98\">worker-03: idle</div>\n          </div>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1545987796-200677ee1011?auto=format&w=800&q=80&fit=crop\" class=\"absolute right-0 bottom-0 w-1/2 opacity-20 grayscale group-hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"99\">\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-5 glass-card rounded-3xl p-8 flex flex-col justify-center items-center text-center\" data-kid=\"100\">\n        <div class=\"w-16 h-16 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-6 glow-ring-purple\" data-kid=\"101\">\n          <i class=\"ti ti-shield-lock text-purple-400 text-3xl\" data-kid=\"102\"></i>\n        </div>\n        <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"103\">Hardened by Default</h3>\n        <p class=\"text-zinc-400 text-sm leading-relaxed\" data-kid=\"104\">\n          The Security Agent audits every single line for SQL injection, XSS, and secret leaks before the first build.\n        </p>\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-4 glass-card rounded-3xl p-8\" data-kid=\"105\">\n        <i class=\"ti ti-chart-dots text-cyan-400 text-2xl mb-4\" data-kid=\"106\"></i>\n        <h3 class=\"text-xl font-bold mb-2\" data-kid=\"107\">Live Observability</h3>\n        <p class=\"text-zinc-400 text-sm\" data-kid=\"108\">Real-time streaming logs from every agent thread directly to your dashboard.</p>\n      </div>\n\n      \n      <div class=\"col-span-12 md:col-span-8 glass-card rounded-3xl p-8 flex items-center gap-8 group\" data-kid=\"109\">\n        <div class=\"flex-1\" data-kid=\"110\">\n          <i class=\"ti ti-box text-cyan-400 text-2xl mb-4\" data-kid=\"111\"></i>\n          <h3 class=\"text-xl font-bold mb-2\" data-kid=\"112\">Cloud Sandbox Execution</h3>\n          <p class=\"text-zinc-400 text-sm\" data-kid=\"113\">Zero local setup. Run code in isolated E2B containers with full terminal access.</p>\n        </div>\n        <div class=\"w-64 h-32 glass rounded-2xl border-white/5 p-4 font-mono text-[10px] text-zinc-500 overflow-hidden group-hover:text-cyan-300 transition-colors\" data-kid=\"114\">\n          > npm install @swarm/core<br data-kid=\"115\">\n          > building containers...<br data-kid=\"116\">\n          > isolated node v20 active<br data-kid=\"117\">\n          > port 3000 listening\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"pricing\" class=\"py-24 relative\" data-kid=\"118\">\n    <div class=\"absolute inset-0 bg-cyan-500/5 blur-[120px] rounded-full scale-50\" data-kid=\"119\"></div>\n    <div class=\"max-w-7xl mx-auto px-6 relative z-10\" data-kid=\"120\">\n      <div class=\"text-center mb-20\" data-kid=\"121\">\n        <h2 class=\"text-4xl font-bold mb-4\" data-kid=\"122\">Scale with the <span class=\"text-gradient\" data-kid=\"123\">Swarm</span></h2>\n        <p class=\"text-zinc-400\" data-kid=\"124\">Simple pricing for complex engineering.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"125\">\n        \n        <div class=\"glass-card rounded-3xl p-10 flex flex-col justify-between\" data-kid=\"126\">\n          <div data-kid=\"127\">\n            <div class=\"text-zinc-400 text-sm font-bold tracking-widest uppercase mb-4\" data-kid=\"128\">Starter</div>\n            <div class=\"text-5xl font-bold mb-6\" data-kid=\"129\">$0<span class=\"text-lg font-normal text-zinc-500\" data-kid=\"130\">/mo</span></div>\n            <ul class=\"space-y-4 mb-8\" data-kid=\"131\">\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"132\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"133\"></i> 3 Active Projects</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"134\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"135\"></i> Supervisor + 2 Agents</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"136\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"137\"></i> 100K Tokens / month</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-4 rounded-2xl glass border-white/10 font-bold hover:bg-white/5 transition-all\" data-kid=\"138\">Start Free</button>\n        </div>\n\n        \n        <div class=\"glass-card rounded-3xl p-10 border-cyan-500/30 relative shimmer\" data-kid=\"139\">\n          <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-cyan-500 text-black text-[10px] font-black tracking-widest uppercase\" data-kid=\"140\">MOST POPULAR</div>\n          <div data-kid=\"141\">\n            <div class=\"text-cyan-400 text-sm font-bold tracking-widest uppercase mb-4\" data-kid=\"142\">Pro Swarm</div>\n            <div class=\"text-5xl font-bold mb-6\" data-kid=\"143\">$29<span class=\"text-lg font-normal text-zinc-500\" data-kid=\"144\">/mo</span></div>\n            <ul class=\"space-y-4 mb-8\" data-kid=\"145\">\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"146\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"147\"></i> Unlimited Projects</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"148\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"149\"></i> All 9 Specialized Agents</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"150\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"151\"></i> 2M Tokens / month</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"152\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"153\"></i> GitHub Auto-Sync</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-4 rounded-2xl bg-cyan-500 text-black font-bold glow-cyan hover:bg-cyan-400 transition-all\" data-kid=\"154\">Go Pro</button>\n        </div>\n\n        \n        <div class=\"glass-card rounded-3xl p-10 flex flex-col justify-between\" data-kid=\"155\">\n          <div data-kid=\"156\">\n            <div class=\"text-zinc-400 text-sm font-bold tracking-widest uppercase mb-4\" data-kid=\"157\">Team</div>\n            <div class=\"text-5xl font-bold mb-6\" data-kid=\"158\">$99<span class=\"text-lg font-normal text-zinc-500\" data-kid=\"159\">/mo</span></div>\n            <ul class=\"space-y-4 mb-8\" data-kid=\"160\">\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"161\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"162\"></i> Everything in Pro</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"163\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"164\"></i> Multi-user Collaboration</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"165\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"166\"></i> 10M Tokens / month</li>\n              <li class=\"flex items-center gap-3 text-sm text-zinc-300\" data-kid=\"167\"><i class=\"ti ti-circle-check text-cyan-400\" data-kid=\"168\"></i> Custom Agent Roles</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-4 rounded-2xl glass border-white/10 font-bold hover:bg-white/5 transition-all\" data-kid=\"169\">Contact Sales</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 border-t border-white/5 glass\" data-kid=\"170\">\n    <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"171\">\n      <div class=\"col-span-1 md:col-span-2\" data-kid=\"172\">\n        <div class=\"flex items-center gap-3 mb-6\" data-kid=\"173\">\n          <i class=\"ti ti-sparkles text-cyan-400 text-2xl\" data-kid=\"174\"></i>\n          <span class=\"text-2xl font-bold tracking-tighter\" data-kid=\"175\">Swarm<span class=\"text-cyan-400\" data-kid=\"176\">Dev</span></span>\n        </div>\n        <p class=\"text-zinc-500 text-sm leading-relaxed max-w-sm\" data-kid=\"177\">\n          A cloud-native AI software company in your browser. Built with Ollama, E2B, and high-fidelity agent orchestration.\n        </p>\n      </div>\n      <div data-kid=\"178\">\n        <h4 class=\"font-bold mb-6\" data-kid=\"179\">Product</h4>\n        <ul class=\"space-y-4 text-sm text-zinc-500\" data-kid=\"180\">\n          <li data-kid=\"181\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"182\">Features</a></li>\n          <li data-kid=\"183\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"184\">Pricing</a></li>\n          <li data-kid=\"185\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"186\">Showcase</a></li>\n          <li data-kid=\"187\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"188\">API</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"189\">\n        <h4 class=\"font-bold mb-6\" data-kid=\"190\">Company</h4>\n        <ul class=\"space-y-4 text-sm text-zinc-500\" data-kid=\"191\">\n          <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"193\">About</a></li>\n          <li data-kid=\"194\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"195\">Blog</a></li>\n          <li data-kid=\"196\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"197\">Careers</a></li>\n          <li data-kid=\"198\"><a href=\"#\" class=\"hover:text-cyan-400\" data-kid=\"199\">Contact</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto px-6 pt-12 mt-12 border-t border-white/5 flex flex-col md:flex-row justify-between gap-6 text-xs text-zinc-600\" data-kid=\"200\">\n      <p data-kid=\"201\">&copy; 2026 SwarmDev. All rights reserved.</p>\n      <div class=\"flex gap-8\" data-kid=\"202\">\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"203\">Privacy Policy</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"204\">Terms of Service</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"205\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"206\"></script>\n<script data-kid=\"207\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Grid Rotation\n  gsap.to(\"#hero-grid\", {\n    rotation: 360,\n    duration: 100,\n    repeat: -1,\n    ease: \"none\"\n  });\n\n  // Hero Text Entrances\n  const tl = gsap.timeline();\n  tl.from(\"#hero-title\", {\n    y: 50,\n    autoAlpha: 0,\n    duration: 1,\n    ease: \"power4.out\"\n  })\n  .from(\"#hero-desc\", {\n    y: 30,\n    autoAlpha: 0,\n    duration: 1,\n    ease: \"power4.out\"\n  }, \"-=0.7\")\n  .from(\"#hero-ctas\", {\n    y: 20,\n    autoAlpha: 0,\n    duration: 1,\n    ease: \"power4.out\"\n  }, \"-=0.7\")\n  .from(\".agent-node\", {\n    scale: 0,\n    autoAlpha: 0,\n    stagger: 0.1,\n    duration: 0.8,\n    ease: \"back.out(1.7)\"\n  }, \"-=0.5\");\n\n  // Connection Lines Implementation\n  function updateConnections() {\n    const svg = document.getElementById('connections-svg');\n    const supervisor = document.querySelector('.glow-ring-cyan');\n    const nodes = document.querySelectorAll('.agent-node');\n    \n    if (!svg || !supervisor) return;\n    \n    const sRect = supervisor.getBoundingClientRect();\n    const svgRect = svg.getBoundingClientRect();\n    \n    const sx = sRect.left + sRect.width / 2 - svgRect.left;\n    const sy = sRect.top + sRect.height / 2 - svgRect.top;\n    \n    svg.innerHTML = `\n      <defs>\n        <linearGradient id=\"cyan-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"rgba(34, 211, 238, 0)\" />\n          <stop offset=\"50%\" stop-color=\"rgba(34, 211, 238, 0.4)\" />\n          <stop offset=\"100%\" stop-color=\"rgba(34, 211, 238, 0)\" />\n        </linearGradient>\n      </defs>\n    `;\n    \n    nodes.forEach(node => {\n      const nRect = node.getBoundingClientRect();\n      const nx = nRect.left + nRect.width / 2 - svgRect.left;\n      const ny = nRect.top + nRect.height / 2 - svgRect.top;\n      \n      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n      const d = `M ${sx} ${sy} Q ${(sx + nx) / 2} ${(sy + ny) / 2} ${nx} ${ny}`;\n      path.setAttribute('d', d);\n      path.setAttribute('stroke', 'url(#cyan-gradient)');\n      path.setAttribute('stroke-width', '2');\n      path.setAttribute('fill', 'none');\n      path.setAttribute('class', 'connection-path');\n      svg.appendChild(path);\n    });\n  }\n\n  window.addEventListener('load', updateConnections);\n  window.addEventListener('resize', updateConnections);\n\n  // Features Reveal\n  gsap.from(\".glass-card\", {\n    scrollTrigger: {\n      trigger: \"#features\",\n      start: \"top 80%\",\n    },\n    y: 100,\n    autoAlpha: 0,\n    stagger: 0.1,\n    duration: 1,\n    ease: \"power4.out\"\n  });\n</script>",
