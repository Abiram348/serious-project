      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-primary: #06b6d4;\n    --color-secondary: #a855f7;\n    --color-bg: #09090b;\n    --color-surface: #18181b;\n    --color-border: #27272a;\n    --font-sans: 'Inter', sans-serif;\n    --font-mono: 'JetBrains Mono', monospace;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: #fafafa;\n    font-family: var(--font-sans);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: var(--font-mono); }\n\n  .bg-grid {\n    background-image: radial-gradient(circle, #27272a 1px, transparent 1px);\n    background-size: 24px 24px;\n  }\n\n  .blueprint-overlay {\n    background-image: url('https://images.unsplash.com/photo-1568607184887-647b905c0966?auto=format&w=1440&q=80&fit=crop');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.05;\n    mix-blend-mode: overlay;\n  }\n\n  .glass-panel {\n    background: rgba(24, 24, 27, 0.7);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--color-border);\n  }\n\n  .text-gradient {\n    background: linear-gradient(to right, var(--color-primary), var(--color-secondary));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 10;\n    background: linear-gradient(0deg, rgba(0, 0, 0, 0) 0%, rgba(6, 182, 212, 0.1) 50%, rgba(0, 0, 0, 0) 100%);\n    opacity: 0.1;\n    position: absolute;\n    pointer-events: none;\n    animation: scanline 8s linear infinite;\n  }\n\n  @keyframes scanline {\n    0% { transform: translateY(-100%); }\n    100% { transform: translateY(100vh); }\n  }\n\n  .dashed-border {\n    background-image: linear-gradient(to right, #3f3f46 50%, transparent 50%), linear-gradient(to right, #3f3f46 50%, transparent 50%), linear-gradient(to bottom, #3f3f46 50%, transparent 50%), linear-gradient(to bottom, #3f3f46 50%, transparent 50%);\n    background-position: left top, left bottom, left top, right top;\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 20px 1px, 20px 1px, 1px 20px, 1px 20px;\n  }\n\n  .glow-cyan { box-shadow: 0 0 20px rgba(6, 182, 212, 0.3); }\n  \n  .terminal-cursor::after {\n    content: '_';\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    from, to { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .rack-card {\n    position: relative;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .rack-card:hover {\n    transform: translateX(8px);\n    border-left: 4px solid var(--color-primary);\n  }\n\n  .btn-precision {\n    position: relative;\n    overflow: hidden;\n  }\n  .btn-precision::before {\n    content: '';\n    position: absolute;\n    top: 0; left: -100%;\n    width: 100%; height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);\n    transition: 0.5s;\n  }\n  .btn-precision:hover::before {\n    left: 100%;\n  }\n</style>\n\n<div class=\"relative min-h-screen bg-grid\" data-kid=\"1\">\n  <div class=\"blueprint-overlay absolute inset-0 pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"scanline\" data-kid=\"3\"></div>\n\n  \n  <nav class=\"fixed top-0 w-full z-50 border-b border-zinc-800/50 bg-zinc-950/80 backdrop-blur-md\" data-kid=\"4\">\n    <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between font-mono text-sm\" data-kid=\"5\">\n      <div class=\"flex items-center gap-4\" data-kid=\"6\">\n        <div class=\"flex items-center gap-2\" data-kid=\"7\">\n          <div class=\"w-2 h-2 rounded-full bg-cyan-500 animate-pulse\" data-kid=\"8\"></div>\n          <span class=\"font-bold tracking-tighter text-lg uppercase\" data-kid=\"9\">Swarm<span class=\"text-cyan-500\" data-kid=\"10\">Dev</span></span>\n        </div>\n        <div class=\"h-4 w-px bg-zinc-800 mx-2\" data-kid=\"11\"></div>\n        <div class=\"flex items-center gap-2 text-zinc-500\" data-kid=\"12\">\n          <span data-kid=\"13\">v1.0.4-stable</span>\n          <span class=\"px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-[10px]\" data-kid=\"14\">PROD</span>\n        </div>\n      </div>\n      <div class=\"hidden md:flex items-center gap-8 text-zinc-400\" data-kid=\"15\">\n        <a href=\"#engine\" class=\"hover:text-cyan-400 transition-colors\" data-kid=\"16\">./architecture</a>\n        <a href=\"#features\" class=\"hover:text-cyan-400 transition-colors\" data-kid=\"17\">./capabilities</a>\n        <a href=\"#pricing\" class=\"hover:text-cyan-400 transition-colors\" data-kid=\"18\">./tiers</a>\n      </div>\n      <div class=\"flex items-center gap-4\" data-kid=\"19\">\n        <a href=\"/auth/login\" class=\"text-zinc-400 hover:text-white transition-colors\" data-kid=\"20\">LOG_IN</a>\n        <a href=\"/dashboard/new\" class=\"bg-cyan-600 hover:bg-cyan-500 text-white px-4 py-1.5 rounded-sm btn-precision border border-cyan-400/50\" data-kid=\"21\">\n          INSTANTIATE_SWARM\n        </a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"pt-32 pb-20 px-6 max-w-7xl mx-auto\" data-kid=\"22\">\n    <div class=\"glass-panel rounded-lg overflow-hidden shadow-2xl border-zinc-800 flex flex-col h-[700px]\" data-kid=\"23\">\n      \n      <div class=\"bg-zinc-900 border-b border-zinc-800 px-4 py-2 flex items-center justify-between font-mono text-xs text-zinc-500\" data-kid=\"24\">\n        <div class=\"flex items-center gap-6\" data-kid=\"25\">\n          <div class=\"flex gap-1.5\" data-kid=\"26\">\n            <div class=\"w-3 h-3 rounded-full bg-zinc-800\" data-kid=\"27\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-zinc-800\" data-kid=\"28\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-zinc-800\" 