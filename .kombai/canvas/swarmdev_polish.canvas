      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100;300;400;500;700&family=Geist+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --matte-black: #0A0A0A;\n    --surface: #121212;\n    --surface-elevated: #1A1A1A;\n    --gold: #D4AF37;\n    --amber: #FFB000;\n    --border: #262626;\n    --text-primary: #FFFFFF;\n    --text-muted: #737373;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--matte-black);\n    color: var(--text-primary);\n    font-family: 'Geist', sans-serif;\n    overflow-x: hidden;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-mono { font-family: 'Geist Mono', monospace; }\n\n  .bg-metallic {\n    background-image: url('https://images.unsplash.com/photo-1666555038185-8323c553de64?auto=format&w=1440&q=80&fit=crop');\n    background-size: cover;\n    background-position: center;\n  }\n\n  .razor-border { border: 1px solid var(--border); }\n  .razor-border-gold { border: 1px solid var(--gold); }\n  .razor-t { border-top: 1px solid var(--border); }\n  .razor-b { border-bottom: 1px solid var(--border); }\n  .razor-l { border-left: 1px solid var(--border); }\n  .razor-r { border-right: 1px solid var(--border); }\n\n  .hover-amber-glow:hover {\n    box-shadow: inset 0 0 20px rgba(255, 176, 0, 0.05);\n    border-color: rgba(255, 176, 0, 0.2);\n  }\n\n  .hero-line {\n    width: 0%;\n    height: 1px;\n    background: linear-gradient(to right, transparent, var(--gold), transparent);\n  }\n\n  .agent-dot {\n    width: 6px;\n    height: 6px;\n    background-color: var(--gold);\n    border-radius: 50%;\n    box-shadow: 0 0 8px var(--gold);\n  }\n\n  .pricing-table th, .pricing-table td {\n    padding: 1.5rem;\n    border: 1px solid var(--border);\n    text-align: left;\n  }\n\n  /* Custom Scrollbar for stealth feel */\n  ::-webkit-scrollbar { width: 4px; }\n  ::-webkit-scrollbar-track { background: var(--matte-black); }\n  ::-webkit-scrollbar-thumb { background: var(--border); }\n  ::-webkit-scrollbar-thumb:hover { background: var(--gold); }\n</style>\n\n<div class=\"relative min-h-screen selection:bg-gold/30 selection:text-white\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full bg-matte-black/80 backdrop-blur-md razor-b h-20\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-10 h-full flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-4\" data-kid=\"4\">\n        <div class=\"w-8 h-8 razor-border-gold flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-crosshair text-gold text-sm\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-medium tracking-[0.2em] uppercase\" data-kid=\"7\">Swarm<span class=\"text-gold\" data-kid=\"8\">Dev</span></span>\n      </div>\n      \n      <div class=\"hidden md:flex items-center gap-12\" data-kid=\"9\">\n        <a href=\"#instruments\" class=\"text-xs font-medium tracking-widest text-text-muted hover:text-gold transition-colors uppercase\" data-kid=\"10\">Instruments</a>\n        <a href=\"#foundry\" class=\"text-xs font-medium tracking-widest text-text-muted hover:text-gold transition-colors uppercase\" data-kid=\"11\">Foundry</a>\n        <a href=\"#access\" class=\"text-xs font-medium tracking-widest text-text-muted hover:text-gold transition-colors uppercase\" data-kid=\"12\">Access</a>\n      </div>\n\n      <div class=\"flex items-center gap-8\" data-kid=\"13\">\n        <button class=\"text-xs font-medium tracking-widest text-text-muted hover:text-white transition-colors uppercase\" data-kid=\"14\">Terminal Login</button>\n        <button class=\"px-6 py-3 bg-gold text-matte-black text-xs font-bold tracking-[0.2em] uppercase hover:bg-amber transition-colors\" data-kid=\"15\">\n          Initialize\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative min-h-screen flex flex-col items-center justify-center text-center px-10\" data-kid=\"16\">\n    <div class=\"absolute inset-0 bg-metallic opacity-10 pointer-events-none\" data-kid=\"17\"></div>\n    <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-matte-black/50 to-matte-black pointer-events-none\" data-kid=\"18\"></div>\n\n    <div class=\"relative z-10 w-full max-w-4xl\" data-kid=\"19\">\n      <div class=\"hero-line mx-auto mb-16\" id=\"hero-line\" data-kid=\"20\"></div>\n      \n      <h1 class=\"text-6xl md:text-8xl font-medium tracking-[0.15em] uppercase mb-8 opacity-0\" id=\"hero-title\" data-kid=\"21\">\n        Engineering, <span class=\"text-gold\" data-kid=\"22\">Refined.</span>\n      </h1>\n      \n      <p class=\"text-sm md:text-base text-text-muted max-w-xl mx-auto mb-12 tracking-widest leading-loose uppercase opacity-0 font-light\" id=\"hero-desc\" data-kid=\"23\">\n        A multi-agent cloud environment built for high-performance engineering teams.\n      </p>\n\n      <div class=\"opacity-0\" id=\"hero-cta\" data-kid=\"24\">\n        <button class=\"group px-12 py-5 bg-gold text-matte-black font-bold text-sm tracking-[0.3em] uppercase hover:bg-amber transition-all duration-500\" data-kid=\"25\">\n          Begin Assembly\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"instruments\" class=\"py-32 px-10 max-w-7xl mx-auto\" data-kid=\"26\">\n    <div class=\"mb-24 flex items-baseline justify-between razor-b pb-8\" data-kid=\"27\">\n      <h2 class=\"text-2xl font-medium tracking-[0.3em] uppercase\" data-kid=\"28\">Precision Instruments</h2>\n      <span class=\"text-[10px] font-mono text-gold tracking-widest\" data-kid=\"29\">MODULES_09.REV_4</span>\n    </div>\n\n    <div class=\"grid md:grid-cols-3\" data-kid=\"30\">\n      \n      <div class=\"p-12 razor-r razor-b group hover-amber-glow transition-all duration-700\" data-kid=\"31\">\n        <i class=\"ti ti-cpu text-gold text-3xl mb-12\" data-kid=\"32\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"33\">Parallel Processing</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"34\">\n          Nine specialized agents operating in tight concurrency. Frontend, backend, and infrastructure logic synthesized simultaneously.\n        </p>\n      </div>\n\n      \n      <div class=\"p-12 razor-r razor-b group hover-amber-glow transition-all duration-700\" data-kid=\"35\">\n        <i class=\"ti ti-shield text-gold text-3xl mb-12\" data-kid=\"36\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"37\">Hardened Core</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"38\">\n          Automated vulnerability synthesis. OWASP Top 10 auditing integrated at the bytecode level before deployment.\n        </p>\n      </div>\n\n      \n      <div class=\"p-12 razor-b group hover-amber-glow transition-all duration-700\" data-kid=\"39\">\n        <i class=\"ti ti-crosshair text-gold text-3xl mb-12\" data-kid=\"40\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"41\">Observability</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"42\">\n          Real-time execution traces and agent-to-agent communication logs. Watch the swarm think in high-fidelity.\n        </p>\n      </div>\n\n      \n      <div class=\"p-12 razor-r group hover-amber-glow transition-all duration-700\" data-kid=\"43\">\n        <i class=\"ti ti-terminal-2 text-gold text-3xl mb-12\" data-kid=\"44\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"45\">Cloud Sandboxes</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"46\">\n          Isolated E2B containerization. Deploy and test in production-parity environments with zero local overhead.\n        </p>\n      </div>\n\n      \n      <div class=\"p-12 razor-r group hover-amber-glow transition-all duration-700\" data-kid=\"47\">\n        <i class=\"ti ti-database text-gold text-3xl mb-12\" data-kid=\"48\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"49\">Logic Synthesis</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"50\">\n          Natural language to functional architecture. High-fidelity mapping of intent to optimized relational schemas.\n        </p>\n      </div>\n\n      \n      <div class=\"p-12 group hover-amber-glow transition-all duration-700\" data-kid=\"51\">\n        <i class=\"ti ti-sparkles text-gold text-3xl mb-12\" data-kid=\"52\"></i>\n        <h3 class=\"text-lg tracking-widest uppercase mb-6 font-medium\" data-kid=\"53\">Iterative Loop</h3>\n        <p class=\"text-sm text-text-muted leading-relaxed tracking-wider font-light\" data-kid=\"54\">\n          Continuous refinement through multi-turn dialogue. The swarm adapts existing codebases with surgical precision.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"foundry\" class=\"py-32 bg-surface\" data-kid=\"55\">\n    <div class=\"max-w-7xl mx-auto px-10\" data-kid=\"56\">\n      <div class=\"mb-16 text-center\" data-kid=\"57\">\n        <h2 class=\"text-sm font-medium tracking-[0.5em] uppercase text-gold mb-4\" data-kid=\"58\">The Foundry</h2>\n        <p class=\"text-3xl tracking-[0.1em] uppercase font-light\" data-kid=\"59\">Agent Orchestration Schema</p>\n      </div>\n\n      <div class=\"relative w-full h-[600px] razor-border bg-matte-black/50 p-20 flex items-center justify-center overflow-hidden\" data-kid=\"60\">\n        \n        <div class=\"absolute inset-0 opacity-[0.03]\" style=\"background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"61\"></div>\n        \n        <div class=\"relative z-10 w-full h-full flex items-center justify-center\" data-kid=\"62\">\n          \n          <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"63\">\n            <svg class=\"w-full h-full\" viewBox=\"0 0 1000 400\" data-kid=\"64\">\n              <path d=\"M 500 200 L 250 100\" stroke=\"#262626\" stroke-width=\"1\" fill=\"none\" data-kid=\"65\"></path>\n              <path d=\"M 500 200 L 750 100\" stroke=\"#262626\" stroke-width=\"1\" fill=\"none\" data-kid=\"66\"></path>\n              <path d=\"M 500 200 L 250 300\" stroke=\"#262626\" stroke-width=\"1\" fill=\"none\" data-kid=\"67\"></path>\n              <path d=\"M 500 200 L 750 300\" stroke=\"#262626\" stroke-width=\"1\" fill=\"none\" data-kid=\"68\"></path>\n            </svg>\n          </div>\n\n          \n          <div class=\"relative flex flex-col items-center gap-4 group cursor-help\" data-kid=\"69\">\n            <div class=\"w-16 h-16 razor-border-gold bg-matte-black flex items-center justify-center\" data-kid=\"70\">\n              <div class=\"agent-dot animate-pulse\" data-kid=\"71\"></div>\n            </div>\n            <span class=\"text-[10px] tracking-[0.3em] uppercase text-gold font-bold\" data-kid=\"72\">Supervisor</span>\n          </div>\n\n          \n          <div class=\"absolute\" style=\"transform: translate(-300px, -120px);\" data-kid=\"73\">\n             <div class=\"flex flex-col items-center gap-3\" data-kid=\"74\">\n               <div class=\"w-10 h-10 razor-border bg-matte-black flex items-center justify-center\" data-kid=\"75\"><div class=\"agent-dot !w-1 !h-1\" data-kid=\"76\"></div></div>\n               <span class=\"text-[9px] tracking-widest text-text-muted uppercase\" data-kid=\"77\">Frontend</span>\n             </div>\n          </div>\n          <div class=\"absolute\" style=\"transform: translate(300px, -120px);\" data-kid=\"78\">\n             <div class=\"flex flex-col items-center gap-3\" data-kid=\"79\">\n               <div class=\"w-10 h-10 razor-border bg-matte-black flex items-center justify-center\" data-kid=\"80\"><div class=\"agent-dot !w-1 !h-1\" data-kid=\"81\"></div></div>\n               <span class=\"text-[9px] tracking-widest text-text-muted uppercase\" data-kid=\"82\">Backend</span>\n             </div>\n          </div>\n          <div class=\"absolute\" style=\"transform: translate(-250px, 150px);\" data-kid=\"83\">\n             <div class=\"flex flex-col items-center gap-3\" data-kid=\"84\">\n               <div class=\"w-10 h-10 razor-border bg-matte-black flex items-center justify-center\" data-kid=\"85\"><div class=\"agent-dot !w-1 !h-1\" data-kid=\"86\"></div></div>\n               <span class=\"text-[9px] tracking-widest text-text-muted uppercase\" data-kid=\"87\">Database</span>\n             </div>\n          </div>\n          <div class=\"absolute\" style=\"transform: translate(250px, 150px);\" data-kid=\"88\">\n             <div class=\"flex flex-col items-center gap-3\" data-kid=\"89\">\n               <div class=\"w-10 h-10 razor-border bg-matte-black flex items-center justify-center\" data-kid=\"90\"><div class=\"agent-dot !w-1 !h-1\" data-kid=\"91\"></div></div>\n               <span class=\"text-[9px] tracking-widest text-text-muted uppercase\" data-kid=\"92\">Security</span>\n             </div>\n          </div>\n        </div>\n\n        <div class=\"absolute bottom-8 left-8 text-[10px] font-mono text-text-muted tracking-tighter\" data-kid=\"93\">\n          STATUS: CORE_STABLE<br data-kid=\"94\">LOAD: 12.4%<br data-kid=\"95\">AGENT_SYNC: 100%\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"access\" class=\"py-32 px-10 max-w-7xl mx-auto\" data-kid=\"96\">\n    <div class=\"mb-24 text-center\" data-kid=\"97\">\n      <h2 class=\"text-sm font-medium tracking-[0.5em] uppercase text-text-muted mb-4\" data-kid=\"98\">Allocation</h2>\n      <p class=\"text-3xl tracking-[0.1em] uppercase font-light\" data-kid=\"99\">Resource Tiers</p>\n    </div>\n\n    <table class=\"w-full pricing-table border-collapse font-light tracking-widest uppercase text-xs\" data-kid=\"100\">\n      <thead class=\"bg-surface/50 text-text-muted\" data-kid=\"101\">\n        <tr data-kid=\"102\">\n          <th data-kid=\"103\">Tier</th>\n          <th data-kid=\"104\">Projects</th>\n          <th data-kid=\"105\">Capacity</th>\n          <th data-kid=\"106\">Agents</th>\n          <th data-kid=\"107\">Price</th>\n          <th data-kid=\"108\">Action</th>\n        </tr>\n      </thead>\n      <tbody data-kid=\"109\">\n        <tr data-kid=\"110\">\n          <td class=\"font-medium text-white\" data-kid=\"111\">Starter</td>\n          <td data-kid=\"112\">03 Units</td>\n          <td data-kid=\"113\">100K Tokens</td>\n          <td data-kid=\"114\">Supervisor + 02</td>\n          <td data-kid=\"115\">$0.00</td>\n          <td data-kid=\"116\"><button class=\"text-gold hover:text-white transition-colors\" data-kid=\"117\">Select</button></td>\n        </tr>\n        <tr class=\"razor-border-gold bg-matte-black shadow-[0_0_30px_rgba(212,175,55,0.05)]\" data-kid=\"118\">\n          <td class=\"font-medium text-gold relative\" data-kid=\"119\">\n            Pro Swarm\n            <div class=\"absolute top-0 right-0 p-2\" data-kid=\"120\"><div class=\"w-1 h-1 bg-gold\" data-kid=\"121\"></div></div>\n          </td>\n          <td data-kid=\"122\">Unlimited</td>\n          <td data-kid=\"123\">2M Tokens</td>\n          <td data-kid=\"124\">Full 09 Agent Swarm</td>\n          <td class=\"text-gold\" data-kid=\"125\">$29.00</td>\n          <td data-kid=\"126\"><button class=\"px-4 py-2 bg-gold text-matte-black font-bold hover:bg-amber transition-colors\" data-kid=\"127\">Acquire</button></td>\n        </tr>\n        <tr data-kid=\"128\">\n          <td class=\"font-medium text-white\" data-kid=\"129\">Team</td>\n          <td data-kid=\"130\">Unlimited</td>\n          <td data-kid=\"131\">10M Tokens</td>\n          <td data-kid=\"132\">Full + Custom Roles</td>\n          <td data-kid=\"133\">$99.00</td>\n          <td data-kid=\"134\"><button class=\"text-gold hover:text-white transition-colors\" data-kid=\"135\">Select</button></td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  \n  <footer class=\"py-20 px-10 razor-t bg-matte-black\" data-kid=\"136\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-12\" data-kid=\"137\">\n      <div class=\"flex items-center gap-4\" data-kid=\"138\">\n        <div class=\"w-6 h-6 razor-border-gold flex items-center justify-center\" data-kid=\"139\">\n          <i class=\"ti ti-crosshair text-gold text-[10px]\" data-kid=\"140\"></i>\n        </div>\n        <span class=\"text-sm font-medium tracking-[0.3em] uppercase\" data-kid=\"141\">SwarmDev</span>\n      </div>\n      \n      <div class=\"flex gap-12 text-[10px] tracking-[0.2em] uppercase text-text-muted\" data-kid=\"142\">\n        <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"143\">Documentation</a>\n        <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"144\">Legal Protocol</a>\n        <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"145\">Hardware Sync</a>\n      </div>\n\n      <div class=\"text-[10px] tracking-[0.1em] text-text-muted font-mono uppercase\" data-kid=\"146\">\n        © 2026 SWARM_DEV_LABS // ALL_RIGHTS_RESERVED\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"147\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"148\"></script>\n<script data-kid=\"149\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Animations\n  const tl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n  \n  tl.to(\"#hero-line\", {\n    width: \"100%\",\n    duration: 1.5,\n    delay: 0.5\n  })\n  .to(\"#hero-title\", {\n    opacity: 1,\n    y: -20,\n    duration: 1\n  }, \"-=0.5\")\n  .to(\"#hero-desc\", {\n    opacity: 1,\n    y: -10,\n    duration: 1\n  }, \"-=0.7\")\n  .to(\"#hero-cta\", {\n    opacity: 1,\n    scale: 1,\n    duration: 0.8,\n    ease: \"back.out(1.7)\"\n  }, \"-=0.7\");\n\n  // Scroll Reveal for sections\n  gsap.from(\"section:not(:first-child)\", {\n    scrollTrigger: {\n      trigger: \"section:not(:first-child)\",\n      start: \"top 80%\",\n    },\n    opacity: 0,\n    y: 50,\n    duration: 1,\n    stagger: 0.3\n  });\n\n  // Feature item staggers\n  gsap.from(\".instruments div\", {\n    scrollTrigger: {\n      trigger: \"#instruments\",\n      start: \"top 70%\",\n    },\n    opacity: 0,\n    y: 30,\n    duration: 0.8,\n    stagger: 0.1\n  });\n</script>",
