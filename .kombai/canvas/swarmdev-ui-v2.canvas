=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"12\"><path d=\"m6 9 6 6 6-6\" data-kid=\"13\"></path></svg></a>\n        <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5 flex items-center gap-1\" data-kid=\"14\">Solutions <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"15\"><path d=\"m6 9 6 6 6-6\" data-kid=\"16\"></path></svg></a>\n        <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5 flex items-center gap-1\" data-kid=\"17\">Resources <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"18\"><path d=\"m6 9 6 6 6-6\" data-kid=\"19\"></path></svg></a>\n        <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5\" data-kid=\"20\">Security</a>\n        <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5\" data-kid=\"21\">Pricing</a>\n        <a href=\"#\" class=\"ml-1 flex items-center gap-1.5 bg-[#F5500B] text-white pl-3.5 pr-1.5 py-1 rounded-full text-[13px] font-semibold hover:bg-[#d94609]\" data-kid=\"22\">\n          Swarm\n          <span class=\"bg-white text-[#F5500B] w-6 h-6 rounded-full grid place-items-center text-[12px] font-bold\" data-kid=\"23\">9</span>\n        </a>\n      </nav>\n    </div>\n    <div class=\"flex items-center gap-2 text-[14px] font-medium\" data-kid=\"24\">\n      <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5 hidden md:block\" data-kid=\"25\">Contact sales</a>\n      <a href=\"#\" class=\"px-3 py-2 rounded-full hover:bg-black/5\" data-kid=\"26\">Log in</a>\n      <a href=\"#\" class=\"border border-[#F5500B] text-[#F5500B] px-5 py-2.5 rounded-full font-semibold hover:bg-[#F5500B] hover:text-white transition-colors\" data-kid=\"27\">Create account</a>\n    </div>\n  </header>\n\n  \n  <section class=\"max-w-[1400px] mx-auto px-8 pt-28 pb-20 text-center\" data-kid=\"28\">\n    <h1 id=\"hero-h1\" class=\"text-[72px] leading-[1.02] font-semibold tracking-[-0.03em]\" data-kid=\"29\">What will your swarm build?</h1>\n    <p id=\"hero-sub\" class=\"mt-5 text-[16px] text-[#6B6661]\" data-kid=\"30\">Describe your idea — 9 AI agents design, code, and ship it in minutes. No coordination needed.</p>\n\n    \n    <div id=\"hero-prompt\" class=\"relative max-w-[640px] mx-auto mt-10\" data-kid=\"31\">\n      <div class=\"absolute -inset-6 rounded-[40px] bg-[radial-gradient(ellipse_at_center,rgba(245,80,11,0.18),rgba(255,161,128,0.10)_55%,transparent_75%)] blur-md\" data-kid=\"32\"></div>\n      <div class=\"relative bg-white rounded-2xl border border-[#F5500B]/40 shadow-[0_8px_40px_-12px_rgba(245,80,11,0.25)] px-5 pt-5 pb-4 text-left\" data-kid=\"33\">\n        <div class=\"text-[15px] text-[#9B948D]\" data-kid=\"34\">Describe your app, the swarm brings it to life…<span class=\"inline-block w-px h-4 bg-[#1A1817] align-middle ml-0.5 animate-pulse\" data-kid=\"35\"></span></div>\n        <div class=\"mt-7 flex items-center justify-between\" data-kid=\"36\">\n          <button class=\"w-8 h-8 rounded-full grid place-items-center text-[#6B6661] hover:bg-black/5\" aria-label=\"Attach\" data-kid=\"37\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"38\"><path d=\"M12 5v14M5 12h14\" data-kid=\"39\"></path></svg>\n          </button>\n          <button class=\"w-9 h-9 rounded-full bg-[#F5500B] grid place-items-center text-white shadow-[0_2px_10px_rgba(245,80,11,0.4)] hover:bg-[#d94609]\" aria-label=\"Submit\" data-kid=\"40\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"41\"><path d=\"M5 12h14M13 6l6 6-6 6\" data-kid=\"42\"></path></svg>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    \n    <div id=\"hero-chips\" class=\"mt-9 flex items-center justify-center gap-4\" data-kid=\"43\">\n      <button class=\"w-9 h-9 rounded-full grid place-items-center text-[#6B6661] hover:bg-black/5\" aria-label=\"Previous\" data-kid=\"44\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"45\"><path d=\"M19 12H5M11 18l-6-6 6-6\" data-kid=\"46\"></path></svg>\n      </button>\n      <div class=\"flex items-start gap-5\" data-kid=\"47\">\n        <div class=\"flex flex-col items-center gap-2\" data-kid=\"48\">\n          <span class=\"w-14 h-14 rounded-xl bg-white border border-black/10 grid place-items-center hover:border-[#F5500B]/50 cursor-pointer\" data-kid=\"49\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"50\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\" data-kid=\"51\"></rect><path d=\"M3 9h18\" data-kid=\"52\"></path><circle cx=\"6\" cy=\"6.5\" r=\".5\" fill=\"currentColor\" data-kid=\"53\"></circle></svg></span>\n          <span class=\"text-[12px] font-medium\" data-kid=\"54\">Web App</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-2\" data-kid=\"55\">\n          <span class=\"w-14 h-14 rounded-xl bg-white border border-black/10 grid place-items-center hover:border-[#F5500B]/50 cursor-pointer\" data-kid=\"56\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"57\"><path d=\"M4 17l6-6-6-6M12 19h8\" data-kid=\"58\"></path></svg></span>\n          <span class=\"text-[12px] font-medium\" data-kid=\"59\">API</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-2\" data-kid=\"60\">\n          <span class=\"w-14 h-14 rounded-xl bg-white border border-black/10 grid place-items-center hover:border-[#F5500B]/50 cursor-pointer\" data-kid=\"61\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"62\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\" data-kid=\"63\"></ellipse><path d=\"M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5\" data-kid=\"64\"></path><path d=\"M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3\" data-kid=\"65\"></path></svg></span>\n          <span class=\"text-[12px] font-medium\" data-kid=\"66\">Database</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-2\" data-kid=\"67\">\n          <span class=\"w-14 h-14 rounded-xl bg-white border border-black/10 grid place-items-center hover:border-[#F5500B]/50 cursor-pointer\" data-kid=\"68\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"69\"><path d=\"M17.5 19a4.5 4.5 0 1 0-1.1-8.9 6 6 0 1 0-11.4 2.4A3.5 3.5 0 0 0 6.5 19h11Z\" data-kid=\"70\"></path></svg></span>\n          <span class=\"text-[12px] font-medium\" data-kid=\"71\">Infra</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-2\" data-kid=\"72\">\n          <span class=\"w-14 h-14 rounded-xl bg-white border border-black/10 grid place-items-center hover:border-[#F5500B]/50 cursor-pointer\" data-kid=\"73\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"74\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\" data-kid=\"75\"></path><path d=\"M14 2v6h6M9 13h6M9 17h6\" data-kid=\"76\"></path></svg></span>\n          <span class=\"text-[12px] font-medium\" data-kid=\"77\">Docs</span>\n        </div>\n      </div>\n      <button class=\"w-9 h-9 rounded-full grid place-items-center text-[#6B6661] hover:bg-black/5\" aria-label=\"Next\" data-kid=\"78\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"79\"><path d=\"M5 12h14M13 6l6 6-6 6\" data-kid=\"80\"></path></svg>\n      </button>\n    </div>\n\n    \n    <div id=\"hero-examples\" data-kid=\"81\">\n      <div class=\"mt-10 text-[13px] text-[#6B6661] flex items-center justify-center gap-1.5\" data-kid=\"82\">\n        Try an example prompt\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"83\"><path d=\"M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6\" data-kid=\"84\"></path></svg>\n      </div>\n      <div class=\"mt-4 flex items-center justify-center gap-3\" data-kid=\"85\">\n        <button class=\"bg-white border border-black/10 px-4 py-2 rounded-full text-[13px] font-medium hover:border-[#F5500B]/50\" data-kid=\"86\">SaaS KPI dashboard</button>\n        <button class=\"bg-white border border-black/10 px-4 py-2 rounded-full text-[13px] font-medium hover:border-[#F5500B]/50\" data-kid=\"87\">AI support chatbot</button>\n        <button class=\"bg-white border border-black/10 px-4 py-2 rounded-full text-[13px] font-medium hover:border-[#F5500B]/50\" data-kid=\"88\">Marketplace MVP</button>\n      </div>\n\n      \n      <div class=\"mt-14 flex items-center justify-center gap-3 text-[#6B6661]\" data-kid=\"89\">\n        <svg width=\"26\" height=\"34\" viewBox=\"0 0 26 34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" data-kid=\"90\"><path d=\"M22 3C14 8 10 16 11 31\" data-kid=\"91\"></path><path d=\"M20 8c-3 .5-6-1-7-4 3-1 6 .5 7 4ZM16.5 14c-3 0-5.5-2-6-5 3-.5 5.8 1.5 6 5ZM14 20.5c-2.8-.6-4.8-3-4.7-6 3 .1 5.2 2.7 4.7 6ZM12.7 27c-2.6-1.2-4-3.8-3.4-6.8 2.9.8 4.4 3.7 3.4 6.8Z\" data-kid=\"92\"></path></svg>\n        <div class=\"text-center\" data-kid=\"93\">\n          <div class=\"text-[17px] font-bold text-[#1A1817] tracking-tight\" data-kid=\"94\">120k+ apps shipped</div>\n          <div class=\"text-[12px]\" data-kid=\"95\">by swarms worldwide</div>\n        </div>\n        <svg width=\"26\" height=\"34\" viewBox=\"0 0 26 34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" style=\"transform:scaleX(-1)\" data-kid=\"96\"><path d=\"M22 3C14 8 10 16 11 31\" data-kid=\"97\"></path><path d=\"M20 8c-3 .5-6-1-7-4 3-1 6 .5 7 4ZM16.5 14c-3 0-5.5-2-6-5 3-.5 5.8 1.5 6 5ZM14 20.5c-2.8-.6-4.8-3-4.7-6 3 .1 5.2 2.7 4.7 6ZM12.7 27c-2.6-1.2-4-3.8-3.4-6.8 2.9.8 4.4 3.7 3.4 6.8Z\" data-kid=\"98\"></path></svg>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-16 overflow-hidden relative\" data-kid=\"99\">\n    <div class=\"absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[#FAF6F0] to-transparent z-10 pointer-events-none\" data-kid=\"100\"></div>\n    <div class=\"absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[#FAF6F0] to-transparent z-10 pointer-events-none\" data-kid=\"101\"></div>\n    <div class=\"marquee-track flex items-center whitespace-nowrap text-[#1A1817]/35 select-none\" style=\"width:max-content\" data-kid=\"102\">\n      <span class=\"text-[24px] font-extrabold tracking-tight px-10\" data-kid=\"103\">▲ Vercel</span>\n      <span class=\"text-[24px] font-bold italic px-10\" data-kid=\"104\">stripe</span>\n      <span class=\"text-[24px] font-semibold tracking-tight px-10\" data-kid=\"105\">Notion</span>\n      <span class=\"text-[24px] font-medium tracking-wide px-10\" data-kid=\"106\">Linear</span>\n      <span class=\"text-[24px] font-bold tracking-tight px-10\" data-kid=\"107\">⚡ supabase</span>\n      <span class=\"text-[24px] font-semibold px-10\" data-kid=\"108\">DATADOG</span>\n      <span class=\"text-[24px] font-medium tracking-tight px-10\" data-kid=\"109\">Figma</span>\n      <span class=\"text-[24px] font-extrabold tracking-tighter px-10\" data-kid=\"110\">slack</span>\n      <span class=\"text-[24px] font-extrabold tracking-tight px-10\" data-kid=\"111\">▲ Vercel</span>\n      <span class=\"text-[24px] font-bold italic px-10\" data-kid=\"112\">stripe</span>\n      <span class=\"text-[24px] font-semibold tracking-tight px-10\" data-kid=\"113\">Notion</span>\n      <span class=\"text-[24px] font-medium tracking-wide px-10\" data-kid=\"114\">Linear</span>\n      <span class=\"text-[24px] font-bold tracking-tight px-10\" data-kid=\"115\">⚡ supabase</span>\n      <span class=\"text-[24px] font-semibold px-10\" data-kid=\"116\">DATADOG</span>\n      <span class=\"text-[24px] font-medium tracking-tight px-10\" data-kid=\"117\">Figma</span>\n      <span class=\"text-[24px] font-extrabold tracking-tighter px-10\" data-kid=\"118\">slack</span>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24\" data-kid=\"119\">\n    <div class=\"max-w-[1200px] mx-auto px-8\" data-kid=\"120\">\n      <div class=\"reveal\" data-kid=\"121\">\n        <h2 class=\"text-center text-[52px] font-semibold tracking-[-0.03em]\" data-kid=\"122\">Meet the <span class=\"text-[#F5500B]\" data-kid=\"123\">Swarm</span></h2>\n        <p class=\"text-center text-[18px] text-[#6B6661] mt-2\" data-kid=\"124\">Nine agents. One conversation.</p>\n      </div>\n\n      <div class=\"mt-14 grid grid-cols-12 gap-5\" data-kid=\"125\">\n        \n        <div class=\"reveal col-span-7 bg-[#FFA180] rounded-[160px] px-16 py-16 min-h-[380px] flex flex-col justify-center relative overflow-hidden\" data-kid=\"126\">\n          <div class=\"absolute inset-y-10 right-10 w-[44%] opacity-50\" style=\"background-image:radial-gradient(rgba(245,80,11,0.45) 1.2px, transparent 1.2px); background-size:14px 14px;\" data-kid=\"127\"></div>\n          <div class=\"relative\" data-kid=\"128\">\n            <div class=\"font-mono-jb text-[12px] text-[#1A1817]/70 mb-3\" data-kid=\"129\">Supervisor Agent</div>\n            <h3 class=\"text-[44px] leading-[1.05] font-semibold tracking-[-0.02em]\" data-kid=\"130\">Orchestrate<br data-kid=\"131\">Freely</h3>\n            <p class=\"mt-5 text-[15px] leading-relaxed text-[#1A1817]/75 max-w-[330px]\" data-kid=\"132\">One brief becomes a coordinated plan. The Supervisor decomposes, assigns, and sequences work across the swarm.</p>\n          </div>\n        </div>\n        \n        <div class=\"reveal col-span-5 bg-[#D8D0CA] rounded-3xl px-12 py-14 flex flex-col justify-end\" data-kid=\"133\">\n          <div class=\"font-mono-jb text-[12px] text-[#1A1817]/70 mb-3\" data-kid=\"134\">Parallel Agents</div>\n          <h3 class=\"text-[40px] font-semibold tracking-[-0.02em]\" data-kid=\"135\">Move faster</h3>\n          <p class=\"mt-4 text-[15px] leading-relaxed text-[#1A1817]/75\" data-kid=\"136\">Backend, frontend, database and infra are built simultaneously — progress streams live to your editor.</p>\n        </div>\n        \n        <div class=\"reveal col-span-5 bg-[#211F1E] rounded-3xl px-10 py-10 text-white\" data-kid=\"137\">\n          <div class=\"flex gap-3 mb-10\" data-kid=\"138\">\n            <div class=\"w-[64px] h-[110px] border border-white/60 rounded-xl relative shrink-0\" data-kid=\"139\"><span class=\"absolute top-2 left-1/2 -translate-x-1/2 w-3 h-1 rounded-full bg-white/60\" data-kid=\"140\"></span></div>\n            <div class=\"w-[130px] h-[110px] border border-white/60 rounded-lg grid place-items-center shrink-0\" data-kid=\"141\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.3\" data-kid=\"142\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"13\" rx=\"1.5\" data-kid=\"143\"></rect><path d=\"M8 21h8M12 16v5\" data-kid=\"144\"></path></svg></div>\n            <div class=\"flex-1 h-[110px] border border-white/60 rounded-lg relative overflow-hidden\" data-kid=\"145\">\n              <div class=\"border-b border-white/60 h-7 flex items-center gap-1.5 px-3\" data-kid=\"146\">\n                <span class=\"w-1.5 h-1.5 rounded-full border border-white/70\" data-kid=\"147\"></span><span class=\"w-1.5 h-1.5 rounded-full border border-white/70\" data-kid=\"148\"></span><span class=\"w-1.5 h-1.5 rounded-full border border-white/70\" data-kid=\"149\"></span>\n              </div>\n              <div class=\"grid place-items-center h-[80px]\" data-kid=\"150\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.3\" data-kid=\"151\"><circle cx=\"12\" cy=\"12\" r=\"9\" data-kid=\"152\"></circle><path d=\"M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18\" data-kid=\"153\"></path></svg></div>\n            </div>\n          </div>\n          <div class=\"font-mono-jb text-[12px] text-white/60 mb-3\" data-kid=\"154\">Full-Stack Output</div>\n          <h3 class=\"text-[40px] font-semibold tracking-[-0.02em]\" data-kid=\"155\">Ship Anything</h3>\n          <p class=\"mt-4 text-[15px] leading-relaxed text-white/65\" data-kid=\"156\">Next.js frontends, Express APIs, Prisma schemas, Docker &amp; Terraform — one project, production-ready.</p>\n        </div>\n        \n        <div class=\"reveal col-span-7 bg-[#F5500B] rounded-[160px] px-16 py-16 min-h-[380px] flex flex-col justify-center text-white\" data-kid=\"157\">\n          <div class=\"font-mono-jb text-[12px] text-white/75 mb-3\" data-kid=\"158\">Built for Teams</div>\n          <h3 class=\"text-[44px] leading-[1.05] font-semibold tracking-[-0.02em]\" data-kid=\"159\">Build together</h3>\n          <p class=\"mt-5 text-[15px] leading-relaxed text-white/80 max-w-[350px]\" data-kid=\"160\">Submit requests in any order. The swarm sequences them intelligently while your team stays focused on the product.</p>\n        </div>\n      </div>\n\n      <div class=\"reveal mt-12 flex items-center justify-center gap-8\" data-kid=\"161\">\n        <a href=\"#\" class=\"border border-[#F5500B] text-[#F5500B] px-6 py-3 rounded-full text-[14px] font-semibold flex items-center gap-2 hover:bg-[#F5500B] hover:text-white transition-colors\" data-kid=\"162\">Deep dive into the Swarm <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"163\"><path d=\"M5 12h14M13 6l6 6-6 6\" data-kid=\"164\"></path></svg></a>\n        <a href=\"#\" class=\"text-[14px] font-medium underline underline-offset-4 decoration-[#1A1817]/40 hover:decoration-[#1A1817]\" data-kid=\"165\">Read the documentation</a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24\" data-kid=\"166\">\n    <div class=\"max-w-[1200px] mx-auto px-8\" data-kid=\"167\">\n      <h2 class=\"reveal text-center text-[44px] font-semibold tracking-[-0.03em]\" data-kid=\"168\">Powered by the SwarmDev platform</h2>\n      <div class=\"mt-14 grid grid-cols-4 gap-5 items-stretch\" data-kid=\"169\">\n\n        \n        <div class=\"reveal bg-white rounded-3xl p-7 flex flex-col border border-black/5\" data-kid=\"170\">\n          <div class=\"font-mono-jb text-[11px] text-[#6B6661]\" data-kid=\"171\">Agent Chat</div>\n          <h3 class=\"mt-2 text-[25px] leading-[1.15] font-semibold tracking-[-0.01em]\" data-kid=\"172\">Describe It.<br data-kid=\"173\">Ship It.</h3>\n          <div class=\"relative h-[230px] my-6\" data-kid=\"174\">\n            <svg class=\"absolute inset-0 w-full h-full\" viewBox=\"0 0 240 230\" fill=\"none\" data-kid=\"175\">\n              <circle cx=\"120\" cy=\"118\" r=\"82\" stroke=\"#F5500B\" stroke-width=\"1\" stroke-dasharray=\"3 5\" opacity=\"0.7\" data-kid=\"176\"></circle>\n              <path d=\"M196 100 l6 8 -10 1z\" fill=\"#F5500B\" opacity=\"0.7\" data-kid=\"177\"></path>\n            </svg>\n            <div class=\"absolute top-3 left-3 bg-white border border-[#1A1817]/70 rounded-lg px-3 py-2 text-[10.5px]\" data-kid=\"178\">Make my idea real <span class=\"inline-block w-px h-2.5 bg-[#1A1817] align-middle\" data-kid=\"179\"></span></div>\n            <div class=\"absolute top-[44%] right-0 bg-[#F5500B] text-white rounded-lg px-3 py-2 text-[10.5px] font-medium flex items-center gap-1.5 shadow-sm\" data-kid=\"180\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"181\"><circle cx=\"12\" cy=\"12\" r=\"9\" data-kid=\"182\"></circle><path d=\"M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18\" data-kid=\"183\"></path></svg>\n              Publish\n            </div>\n            <div class=\"absolute bottom-4 left-4 bg-white border border-[#1A1817]/70 rounded-lg px-3 py-2 text-[10.5px] flex items-center gap-1.5\" data-kid=\"184\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"185\"><circle cx=\"12\" cy=\"8\" r=\"4\" data-kid=\"186\"></circle><path d=\"M5 21c1-4 4-6 7-6s6 2 7 6\" data-kid=\"187\"></path></svg>\n              Agent\n            </div>\n          </div>\n          <p class=\"mt-auto text-[12.5px] leading-relaxed text-[#6B6661]\" data-kid=\"188\">Describe and publish your project. The swarm writes production-ready code, evolves it, and stays out of your way.</p>\n        </div>\n\n        \n        <div class=\"reveal bg-[#D8D0CA] rounded-3xl p-7 flex flex-col\" data-kid=\"189\">\n          <div class=\"font-mono-jb text-[11px] text-[#1A1817]/60\" data-kid=\"190\">Full Stack Infrastructure</div>\n          <h3 class=\"mt-2 text-[25px] leading-[1.15] font-semibold tracking-[-0.01em]\" data-kid=\"191\">Build &amp; Scale Your Apps Easily.</h3>\n          <div class=\"my-6 h-[230px] grid place-items-center\" data-kid=\"192\">\n            <div class=\"border-[1.5px] border-[#F5500B] rounded-2xl p-4 flex flex-col gap-3.5 w-[162px]\" data-kid=\"193\">\n              <div class=\"border border-[#1A1817]/70 rounded-full px-3 py-1.5 text-center text-[10.5px] bg-[#D8D0CA]\" data-kid=\"194\">Authentication</div>\n              <div class=\"border border-[#1A1817]/70 rounded-full px-3 py-1.5 text-center text-[10.5px] bg-[#D8D0CA]\" data-kid=\"195\">Database</div>\n              <div class=\"border border-[#1A1817]/70 rounded-full px-3 py-1.5 text-center text-[10.5px] bg-[#D8D0CA]\" data-kid=\"196\">Hosting</div>\n              <div class=\"border border-[#1A1817]/70 rounded-full px-3 py-1.5 text-center text-[10.5px] bg-[#D8D0CA]\" data-kid=\"197\">Monitoring</div>\n            </div>\n          </div>\n          <p class=\"mt-auto text-[12.5px] leading-relaxed text-[#1A1817]/70\" data-kid=\"198\">Built-in services with zero setup — auth, database, hosting and monitoring, secure and scalable from day one.</p>\n        </div>\n\n        \n        <div class=\"reveal bg-[#FFA180] rounded-3xl p-7 flex flex-col\" data-kid=\"199\">\n          <div class=\"font-mono-jb text-[11px] text-[#1A1817]/60\" data-kid=\"200\">Integrations</div>\n          <h3 class=\"mt-2 text-[25px] leading-[1.15] font-semibold tracking-[-0.01em]\" data-kid=\"201\">Connect To AI &amp; Services.</h3>\n          <div class=\"relative my-6 h-[230px]\" data-kid=\"202\">\n            <svg class=\"absolute inset-0 w-full h-full\" viewBox=\"0 0 240 230\" fill=\"none\" stroke=\"#1A1817\" stroke-width=\"1\" stroke-dasharray=\"3 4\" opacity=\"0.6\" data-kid=\"203\">\n              <path d=\"M66 74 C 90 78, 92 100, 102 106\" data-kid=\"204\"></path>\n              <path d=\"M174 62 C 152 66, 150 92, 140 100\" data-kid=\"205\"></path>\n              <path d=\"M172 164 C 152 160, 150 140, 140 132\" data-kid=\"206\"></path>\n            </svg>\n            <div class=\"absolute top-[52px] left-7 w-10 h-10 bg-white rounded-xl grid place-items-center text-[15px] font-bold shadow-sm\" data-kid=\"207\">S</div>\n            <div class=\"absolute top-10 right-9 w-10 h-10 bg-white rounded-xl grid place-items-center shadow-sm\" data-kid=\"208\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1A1817\" stroke-width=\"2\" data-kid=\"209\"><path d=\"M13 2 4 14h6l-1 8 9-12h-6l1-8Z\" data-kid=\"210\"></path></svg></div>\n            <div class=\"absolute bottom-10 right-8 w-10 h-10 bg-white rounded-xl grid place-items-center text-[15px] font-bold shadow-sm\" data-kid=\"211\">N</div>\n            <div class=\"absolute top-[96px] left-[100px] w-12 h-12 bg-[#F5500B] rounded-xl grid place-items-center shadow-md\" data-kid=\"212\">\n              <span class=\"relative w-5 h-5 inline-block\" data-kid=\"213\">\n                <span class=\"absolute left-0 top-0 w-2 h-2 rounded-[2.5px] bg-white\" data-kid=\"214\"></span>\n                <span class=\"absolute right-0 top-1 w-1.5 h-1.5 rounded-[2px] bg-white\" data-kid=\"215\"></span>\n                <span class=\"absolute left-1 bottom-0 w-2.5 h-2.5 rounded-[3px] bg-white\" data-kid=\"216\"></span>\n              </span>\n            </div>\n          </div>\n          <p class=\"mt-auto text-[12.5px] leading-relaxed text-[#1A1817]/70\" data-kid=\"217\">Enhance your apps with AI and 100+ integrations — OpenAI, Stripe, Notion, Slack and more in minutes.</p>\n        </div>\n\n        \n        <div class=\"reveal bg-[#F5500B] rounded-3xl p-7 flex flex-col text-white\" data-kid=\"218\">\n          <div class=\"font-mono-jb text-[11px] text-white/70\" data-kid=\"219\">Enterprise Control</div>\n          <h3 class=\"mt-2 text-[25px] leading-[1.15] font-semibold tracking-[-0.01em]\" data-kid=\"220\">Secure Your Apps As They Scale.</h3>\n          <div class=\"my-6 h-[230px] grid place-items-center\" data-kid=\"221\">\n            <svg width=\"130\" height=\"150\" viewBox=\"0 0 130 150\" fill=\"none\" stroke=\"white\" stroke-width=\"1.2\" data-kid=\"222\">\n              <path d=\"M65 8 117 26v40c0 36-22 60-52 72C35 126 13 102 13 66V26L65 8Z\" opacity=\"0.9\" data-kid=\"223\"></path>\n              <path d=\"M65 22 105 36v30c0 28-17 47-40 57-23-10-40-29-40-57V36L65 22Z\" opacity=\"0.6\" data-kid=\"224\"></path>\n              <path d=\"M65 36 93 46v21c0 20-12 33-28 41-16-8-28-21-28-41V46L65 36Z\" opacity=\"0.35\" data-kid=\"225\"></path>\n              <path d=\"M50 74l11 11 20-22\" stroke-width=\"1.8\" data-kid=\"226\"></path>\n            </svg>\n          </div>\n          <p class=\"mt-auto text-[12.5px] leading-relaxed text-white/80\" data-kid=\"227\">Security controls: SSO/SAML, SOC 2, isolated sandboxes and admin policies keep every build safe.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24\" data-kid=\"228\">\n    <div class=\"max-w-[1400px] mx-auto px-8\" data-kid=\"229\">\n      <div class=\"reveal flex gap-6 items-stretch\" data-kid=\"230\">\n        \n        <div class=\"w-[210px] shrink-0 border border-black/10 rounded-3xl p-6 self-start\" data-kid=\"231\">\n          <div class=\"text-[24px] font-semibold leading-tight tracking-[-0.01em]\" data-kid=\"232\">Trusted by builders</div>\n          <div class=\"mt-2 text-[12.5px] text-[#6B6661]\" data-kid=\"233\">Endorsed by shippers</div>\n        </div>\n        \n        <div class=\"flex-1 bg-white rounded-3xl p-10 flex flex-col min-h-[420px]\" data-kid=\"234\">\n          <div class=\"text-[48px] leading-none text-[#FFA180] font-bold\" data-kid=\"235\">“</div>\n          <p class=\"mt-4 text-[26px] leading-[1.35] font-medium tracking-[-0.01em] max-w-[560px]\" data-kid=\"236\">SwarmDev compressed our two-week MVP cycle into an afternoon. The agents coordinate better than most teams I have managed.</p>\n          <div class=\"mt-auto pt-10\" data-kid=\"237\">\n            <div class=\"text-[16px] font-semibold\" data-kid=\"238\">Maya Chen</div>\n            <div class=\"text-[13px] text-[#6B6661]\" data-kid=\"239\">CTO</div>\n            <div class=\"text-[13px] text-[#6B6661]\" data-kid=\"240\">Northwind Labs</div>\n          </div>\n        </div>\n        \n        <div class=\"w-[300px] shrink-0 relative self-center h-[380px]\" data-kid=\"241\">\n          <button class=\"absolute top-0 left-[90px] w-[210px] h-[190px] bg-[#FFA180] rounded-[44px] rounded-bl-none flex items-center justify-between px-7 text-left hover:bg-[#ff8d63]\" data-kid=\"242\">\n            <span class=\"text-[14px] font-medium leading-snug\" data-kid=\"243\">Next<br data-kid=\"244\">Testimonial</span>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5500B\" stroke-width=\"2\" data-kid=\"245\"><path d=\"M5 12h14M13 6l6 6-6 6\" data-kid=\"246\"></path></svg>\n          </button>\n          <button class=\"absolute bottom-0 left-0 w-[210px] h-[190px] bg-[#FFC9B5] rounded-[44px] rounded-tr-none flex items-center justify-between px-7 text-left hover:bg-[#ffb89d]\" data-kid=\"247\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5500B\" stroke-width=\"2\" data-kid=\"248\"><path d=\"M19 12H5M11 18l-6-6 6-6\" data-kid=\"249\"></path></svg>\n            <span class=\"text-[14px] font-medium leading-snug text-right\" data-kid=\"250\">Previous<br data-kid=\"251\">Testimonial</span>\n          </button>\n        </div>\n        \n        <div class=\"w-[200px] shrink-0 bg-white rounded-l-3xl p-8 -mr-16 min-h-[420px] flex flex-col\" data-kid=\"252\">\n          <div class=\"text-[48px] leading-none text-[#FFA180] font-bold\" data-kid=\"253\">“</div>\n          <p class=\"mt-4 text-[22px] leading-[1.35] font-medium\" data-kid=\"254\">Nine agents, zero standups, one shipped prod—</p>\n          <div class=\"mt-auto pt-10\" data-kid=\"255\">\n            <div class=\"text-[16px] font-semibold\" data-kid=\"256\">Diego Ferraro</div>\n            <div class=\"text-[13px] text-[#6B6661]\" data-kid=\"257\">Founder</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-12\" data-kid=\"258\">\n    <div class=\"max-w-[1200px] mx-auto px-8\" data-kid=\"259\">\n      <div class=\"reveal bg-white rounded-[2rem] p-10 lg:p-12\" data-kid=\"260\">\n        <div class=\"flex items-start justify-between flex-wrap gap-6\" data-kid=\"261\">\n          <div data-kid=\"262\">\n            <h2 class=\"text-[40px] font-semibold tracking-[-0.02em]\" data-kid=\"263\">Start Small. Scale Fast.</h2>\n            <p class=\"text-[13px] text-[#6B6661] mt-1\" data-kid=\"264\">Designed for every stage</p>\n          </div>\n          <div class=\"flex items-center bg-[#FAF6F0] border border-black/10 rounded-full p-1 text-[13px] font-medium\" data-kid=\"265\">\n            <button class=\"px-4 py-1.5 rounded