an class=\"ln\" data-kid=\"296\">20</span><div data-kid=\"297\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tk-pn\" data-kid=\"298\">&lt;</span><span class=\"tk-ty\" data-kid=\"299\">ListingCard</span> <span class=\"tk-fn\" data-kid=\"300\">key</span><span class=\"tk-pn\" data-kid=\"301\">={</span>listing<span class=\"tk-pn\" data-kid=\"302\">.</span>id<span class=\"tk-pn\" data-kid=\"303\">}</span> <span class=\"tk-fn\" data-kid=\"304\">listing</span><span class=\"tk-pn\" data-kid=\"305\">={</span>listing<span class=\"tk-pn\" data-kid=\"306\">}</span> <span class=\"tk-pn\" data-kid=\"307\">/&gt;</span></div></div>\n            <div class=\"code-line\" data-kid=\"308\"><span class=\"ln\" data-kid=\"309\">21</span><div data-kid=\"310\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tk-pn\" data-kid=\"311\">))}</span></div></div>\n          </div>\n          <div class=\"code-line\" data-kid=\"312\"><span class=\"ln opacity-40\" data-kid=\"313\">22</span><div data-kid=\"314\"><span class=\"opacity-40\" data-kid=\"315\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tk-pn\" data-kid=\"316\">&lt;/</span><span class=\"tk-ty\" data-kid=\"317\">section</span><span class=\"tk-pn\" data-kid=\"318\">&gt;</span></span><span class=\"caret inline-block align-middle w-[7px] h-[15px] bg-[#FF7A45] ml-px\" data-kid=\"319\"></span></div></div>\n        </div>\n      </div>\n\n      \n      <div class=\"shrink-0 mt-3 rounded-xl bg-[#1D1B1A] overflow-hidden\" style=\"height:200px\" data-kid=\"320\">\n        <div class=\"flex items-center justify-between px-4 border-b border-white/10\" data-kid=\"321\">\n          <div class=\"flex items-center gap-5\" data-kid=\"322\">\n            <button class=\"font-ui text-[12px] font-medium text-[#7A7470] py-2.5\" data-kid=\"323\">Terminal</button>\n            <button class=\"relative font-ui text-[12px] font-semibold text-[#F5E9DC] py-2.5\" data-kid=\"324\">\n              Agent logs\n            