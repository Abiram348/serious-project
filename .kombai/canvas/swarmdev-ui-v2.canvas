 flex flex-col min-h-0\" data-kid=\"350\">\n      <div class=\"flex items-center justify-between px-4 h-12 border-b border-[#EAE2DA] shrink-0\" data-kid=\"351\">\n        <div class=\"flex items-center gap-2\" data-kid=\"352\">\n          <span class=\"text-[13px] font-bold\" data-kid=\"353\">Swarm chat</span>\n          <div class=\"flex -space-x-1\" data-kid=\"354\">\n            <span class=\"relative z-40 w-3.5 h-3.5 rounded-full bg-[#1D1B1A] ring-2 ring-white\" data-kid=\"355\"></span>\n            <span class=\"relative z-30 w-3.5 h-3.5 rounded-full bg-[#F5500B] ring-2 ring-white\" data-kid=\"356\"></span>\n            <span class=\"relative z-20 w-3.5 h-3.5 rounded-full bg-[#FFA180] ring-2 ring-white\" data-kid=\"357\"></span>\n            <span class=\"relative z-10 w-3.5 h-3.5 rounded-full bg-[#D8D0CA] ring-2 ring-white\" data-kid=\"358\"></span>\n          </div>\n        </div>\n        <button class=\"text-[#A39A90]\" data-kid=\"359\"><i data-lucide=\"more-vertical\" class=\"w-4 h-4\" data-kid=\"360\"></i></button>\n      </div>\n\n      <div class=\"flex-1 min-h-0 overflow-hidden px-4 py-4 flex flex-col gap-4 text-[13px]\" data-kid=\"361\">\n        \n        <div class=\"flex justify-end\" data-kid=\"362\">\n          <div class=\"max-w-[85%] rounded-2xl rounded-br-md bg-[#1D1B1A] text-white px-3.5 py-2.5 leading-relaxed\" data-kid=\"363\">\n            Build a marketplace MVP with listings, checkout and seller dashboard\n          </div>\n        </div>\n        \n        <div class=\"flex flex-col gap-1 max-w-[90%]\" data-kid=\"364\">\n          <div class=\"flex items-center gap-1.5 pl-1\" data-kid=\"365\">\n            <span class=\"w-2 h-2 rounded-full bg-[#F5500B]\" data-kid=\"366\"></span>\n            <span class=\"font-mono text-[11px] text-[#8A827A]\" data-kid=\"367\">supervisor</span>\n            <span class=\"text-[10.5px] text-[#C9C0B7]\" data-kid=\"368\">2m</span>\n          </div>\n          <div class=\"rounded-2xl rounded-tl-md bg-[#FAF6F0] border border-[#EAE2DA] px-3.5 py-2.5 leading-relaxed text-[#332F2B]\" data-kid=\"369\">\n            Plan ready — decomposed into 9 tasks. Database first, then parallel backend/frontend.\n            <div class=\"mt-2.5 flex flex-col gap-1.5 border-t border-[#EAE2DA] pt-2.5\" data-kid=\"370\">\n              <div class=\"flex items-center gap-2 text-[12px]\" data-kid=\"371\"><span class=\"inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-[#F5500B] text-white shrink-0\" data-kid=\"372\"><i data-lucide=\"check\" class=\"w-2.5 h-2.5\" data-kid=\"373\"></i></span><span class=\"line-through text-[#A39A90]\" data-kid=\"374\">Prisma schema + migrations</span></div>\n              <div class=\"flex items-center gap-2 text-[12px]\" data-kid=\"375\"><span class=\"inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-[#F5500B] text-white shrink-0\" data-kid=\"376\"><i data-lucide=\"check\" class=\"w-2.5 h-2.5\" data-kid=\"377\"></i></span><span class=\"line-through text-[#A39A90]\" data-kid=\"378\">Auth + session middleware</span></div>\n              <div class=\"flex items-center gap-2 text-[12px]\" data-kid=\"379\"><span class=\"w-3.5 h-3.5 rounded-full border-[1.5px] border-[#D8D0CA] shrink-0\" data-kid=\"380\"></span><span class=\"text-[#6B6259]\" data-kid=\"381\">Listings grid + checkout flow</span></div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"flex flex-col gap-1 max-w-[90%]\" data-kid=\"382\">\n          <div class=\"flex items-center gap-1.5 pl-1\" data-kid=\"383\">\n            <span class=\"w-2 h-2 rounded-full bg-[#F5500B] pulse-dot\" data-kid=\"384\"></span>\n            <span class=\"font-mono text-[11px] text-[#8A827A]\" data-kid=\"385\">backend-agent</span>\n            <span class=\"text-[10.5px] text-[#C9C0B7]\" data-kid=\"386\">40s</span>\n          </div>\n          <div class=\"rounded-2xl rounded-tl-md bg-[#FAF6F0] border border-[#EAE2DA] px-3.5 py-2.5 leading-relaxed text-[#332F2B]\" data-kid=\"387\">\n            Generated <span class=\"font-mono text-[12px] bg-[#EFE9E1] rounded px-1\" data-kid=\"388\">/api/listings</span>, <span class=\"font-mono text-[12px] bg-[#EFE9E1] rounded px-1\" data-kid=\"389\">/api/checkout</span> with Stripe stub. <span class=\"inline-flex items-center rounded-full bg-[#FFD9C7] px-1.5 py-px font-mono text-[11.5px] font-medium text-[#C24006]\" data-kid=\"390\">@reviewer</span> please verify auth middleware.\n          </div>\n        </div>\n        \n        <div class=\"flex flex-col gap-1 max-w-[90%]\" data-kid=\"391\">\n          <div class=\"flex items-center gap-1.5 pl-1\" data-kid=\"392\">\n            <span class=\"w-2 h-2 rounded-full bg-[#D8D0CA]\" data-kid=\"393\"></span>\n            <span class=\"font-mono text-[11px] text-[#8A827A]\" data-kid=\"394\">qa-agent</span>\n            <span class=\"text-[10.5px] text-[#C9C0B7]\" data-kid=\"395\">12s</span>\n          </div>\n          <div class=\"rounded-2xl rounded-tl-md bg-[#FAF6F0] border border-[#EAE2DA] px-3.5 py-2.5 leading-relaxed text-[#332F2B]\" data-kid=\"396\">\n            Unit suite finished on <span class=\"font-mono text-[12px]\" data-kid=\"397\">apps/api</span>:\n            <div class=\"mt-2 flex items-center gap-2.5 rounded-lg border border-[#D9EBDD] bg-[#F2F9F3] px-3 py-2\" data-kid=\"398\">\n              <span class=\"inline-flex items-center justify-center w-5 h-5 rounded-full bg-[#2F9E5B] text-white shrink-0\" data-kid=\"399\"><i data-lucide=\"check\" class=\"w-3 h-3\" data-kid=\"400\"></i></span>\n              <div class=\"leading-tight\" data-kid=\"401\">\n                <div class=\"font-mono text-[12px] font-semibold text-[#1F6A3C]\" data-kid=\"402\">48/48 unit tests passing</div>\n                <div class=\"text-[11px] text-[#7BA489]\" data-kid=\"403\">vitest · 3.4s</div>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"mt-auto flex items-center gap-2 pl-1 text-[12px] text-[#A39A90]\" data-kid=\"404\">\n          <span class=\"w-2 h-2 rounded-full bg-[#F5500B] pulse-dot\" data-kid=\"405\"></span>\n          <span class=\"font-mono text-[11px]\" data-kid=\"406\">frontend-agent</span> is typing\n          <span class=\"flex gap-[3px]\" data-kid=\"407\">\n            <span class=\"typing-dot w-1 h-1 rounded-full bg-[#A39A90]\" data-kid=\"408\"></span>\n            <span class=\"typing-dot w-1 h-1 rounded-full bg-[#A39A90]\" style=\"animation-delay:.15s\" data-kid=\"409\"></span>\n            <span class=\"typing-dot w-1 h-1 rounded-full bg-[#A39A90]\" style=\"animation-delay:.3s\" data-kid=\"410\"></span>\n          </span>\n        </div>\n      </div>\n\n      \n      <div class=\"px-4 pb-4 pt-1 shrink-0\" data-kid=\"411\">\n        <div class=\"flex items-center gap-1.5 pb-2\" data-kid=\"412\">\n          <span class=\"rounded-full border border-[#EAE2DA] bg-[#FAF6F0] px-2 py-[3px] font-mono text-[11px] text-[#8A827A]\" data-kid=\"413\">@supervisor</span>\n          <span class=\"rounded-full border border-[#EAE2DA] bg-[#FAF6F0] px-2 py-[3px] font-mono text-[11px] text-[#8A827A]\" data-kid=\"414\">@backend</span>\n          <span class=\"rounded-full border border-[#EAE2DA] bg-[#FAF6F0] px-2 py-[3px] font-mono text-[11px] text-[#8A827A]\" data-kid=\"415\">@qa</span>\n        </div>\n        <div class=\"flex items-center gap-2 rounded-xl border border-[#DDD3C9] bg-white px-3 py-2.5 shadow-xs\" data-kid=\"416\">\n          <button class=\"text-[#A39A90] flex items-center\" data-kid=\"417\"><i data-lucide=\"plus\" class=\"w-4 h-4\" data-kid=\"418\"></i></button>\n          <span class=\"flex-1 text-[12.5px] text-[#A39A90] truncate\" data-kid=\"419\">Message the swarm — use @ to mention an agent</span>\n          <button class=\"inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#F5500B] text-white shrink-0\" data-kid=\"420\"><i data-lucide=\"arrow-up\" class=\"w-3.5 h-3.5\" data-kid=\"421\"></i></button>\n        </div>\n      </div>\n    </aside>\n  </div>\n</div>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"422\"></script>\n<script data-kid=\"423\">lucide.createIcons();</script></div>", "comments": [], "created": "2026-06-14T03:51:51.243Z", "modified": "2026-06-14T03:51:51.243Z", "id": "var_f27ffb0de266", "viewportScrollY": 0}}, "themes": {}, "comments": {}, "nextCommentNumber": 1}