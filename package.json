{
  "name": "swarmdev-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SwarmDev - Multi-Agent Cloud Development Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:check": "bash scripts/health-check.sh",
    "dev:check:strict": "bash scripts/health-check.sh --strict",
    "clean": "turbo run clean --parallel",
    "clean:safe": "bash scripts/safe-clean.sh",
    "clean:safe:deep": "bash scripts/safe-clean.sh --deep",
    "build": "turbo run build --parallel",
    "test": "turbo run test --parallel",
    "lint": "turbo run lint --parallel",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "security": "bash scripts/security_scan.sh"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0"
  }
}
